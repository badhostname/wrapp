.idea/

# NuGet
*.nupkg
**/packages/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# App data / secrets
settings.json
msal_cache.bin
msal_devops_cache.bin
app.log
keys/

# Org-specific defaults (contains real tenant IDs, site codes, UNC paths)
# Copy defaults.example.json to defaults.local.json and fill in your values.
defaults.local.json

# Temp workspaces (created at runtime)
**/Wrapp/

# mingit (restored from NuGet at build time, not source)
**/mingit/

# IntuneWin32App dev/test/sample content (not needed for build)
modules/IntuneWin32App/**/Development/
modules/IntuneWin32App/**/Samples/
modules/IntuneWin32App/**/Tests/

# Local agent/tool state — per-user settings, task locks, etc.
.claude/
.crush/
.cursor/

# Knowledge-graph build output (regenerated by /graphify)
graphify-out/
**/graphify-out/

# Workstream D3: local canonical release store (Publish-Release.ps1)
releases/

# Machine-local test policy for Apply-WrappPolicy.ps1 (never ship/commit)
policy/policies.local.json

# Org-specific audit needles for HelpKeyReferenceTests (never shipped)
tests/org-needles.local.txt

# Pre-1.0.2 full changelog (internal history, never shipped)
CHANGELOG.full-history.local.md
