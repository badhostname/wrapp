    <sys:String x:Key="Help.Intune.DeploymentBehavior.MaxInstallTime">Timeout in minutes (1-1440). Installation exceeding this is marked as failed. Default: 60.</sys:String>
    <sys:String x:Key="Help.Intune.DeploymentBehavior.AllowAvailableUninstall">Lets end users uninstall from Company Portal. Only applies to "Available" intent deployments.</sys:String>
    <sys:String x:Key="Help.Intune.DeploymentBehavior.CompanyPortalFeaturedApp">Shows the app in the "Featured" banner in Company Portal. Use sparingly.</sys:String>
