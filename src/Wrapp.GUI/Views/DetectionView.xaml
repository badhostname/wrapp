<UserControl x:Class="Wrapp.Views.DetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:helpers="clr-namespace:Wrapp.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View header: title + info help. Matches LogsView / SettingsView. -->
        <ctrl:ViewHeader Grid.Row="0"
                         Title="Detection"
                         HelpKey="Help.Detection.Overview"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      helpers:SmoothScroll.Enabled="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: description, example, expression, add button -->
        <StackPanel Grid.Row="0" Margin="16,12,16,8">

            <!-- Plain-language description of how detection works -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" Text="How detection works"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
                        <Run>Each row in the table below defines a named test. A test checks a specific</Run>
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"> file, registry key, or command output</Run>
                        <Run> against an expected value using a PowerShell comparison operator (e.g. -eq, -ge, -like).</Run>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18" Margin="0,6,0,0">
                        <Run>The</Run>
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"> Boolean Expression</Run>
                        <Run> field combines test symbols using -and, -or, -not and parentheses</Run>
                        <Run FontStyle="Italic"> (e.g. Base -and (Update -or Patch))</Run>
                        <Run>. When the expression evaluates to</Run>
                        <Run FontWeight="SemiBold" Foreground="#6FD46F"> TRUE</Run>
                        <Run>, Intune considers the application already installed and skips re-installation.</Run>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18" Margin="0,6,0,0">
                        <Run>Detection results are written to</Run>
                        <Run FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}"> &lt;Tag folder&gt;\DetectionResults.json</Run>
                        <Run> for troubleshooting &#x2014; the Tag folder is set in Settings &gt; Endpoint (default</Run>
                        <Run FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}"> C:\Wrapp\Tag</Run>
                        <Run>). Exit code 0 with no output = not installed; any stdout output = installed.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Expression example -->
            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" Text="Example"/>
                    <TextBlock FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               LineHeight="18">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}">Tests:</Run><LineBreak/>
                        <Run>  Base  Path: C:\Windows\System32\notepad.exe  Property: Exists  Operator: -eq  Value: True</Run><LineBreak/>
                        <Run>  Fake  Path: C:\Windows\FakePath\missing.exe  Property: Exists  Operator: -eq  Value: True</Run><LineBreak/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}">Expression:</Run>
                        <Run> Base -and Fake</Run><LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}">Result:</Run>
                        <Run Foreground="#6FD46F"> $True</Run>
                        <Run> -and</Run>
                        <Run Foreground="#E05C5C"> $False</Run>
                        <Run> =</Run>
                        <Run Foreground="#E05C5C"> $False</Run>
                        <Run>  (Not Installed)</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Boolean Expressions -->
            <StackPanel Margin="0,0,0,12">
                <ctrl:SectionHeader Title="Boolean Expressions"
                                    HelpKey="Help.Detection.Expression"
                                    Margin="0,0,0,-6"/>

                <!-- Default expression (always present, key not editable) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="Default" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="13"
                             Background="{DynamicResource InputBgBrush}" Opacity="0.7"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding Detect.Expression_Default, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{StaticResource Help.Detection.Expression}"
                             FontFamily="Consolas" FontSize="14"/>
                </Grid>

                <!-- Additional named expressions -->
                <ItemsControl ItemsSource="{Binding Detect.Expressions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{StaticResource Help.Detection.Expression.Key}"
                                         FontFamily="Consolas" FontSize="13"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{StaticResource Help.Detection.Expression}"
                                         FontFamily="Consolas" FontSize="14"/>
                                <Button Grid.Column="3"
                                        Command="{Binding DataContext.RemoveExpressionCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="{StaticResource Help.Detection.Expression.Remove}"
                                        Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add expression button -->
                <Button Command="{Binding AddExpressionCommand}"
                        Padding="8,4" Margin="0,2,0,0"
                        ToolTip="{StaticResource Help.Detection.Expression.Add}"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Add Expression" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Tests section header -->
            <ctrl:SectionHeader Title="Detection Tests"
                                HelpKey="Help.Detection.Tests"
                                Margin="0,0,0,-6"/>

            <!-- Add / Remove buttons -->
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddTestCommand}"
                        ToolTip="{StaticResource Help.Detection.Tests.Add}"
                        Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Add Test" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RemoveSelectedTestsCommand}"
                        ToolTip="{StaticResource Help.Detection.Tests.Remove}"
                        Padding="12,6" Margin="0,0,8,0"
                        IsEnabled="{Binding HasAnySelected}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Remove" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Duplicate symbol warning (inline with buttons) -->
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center" Margin="12,0,4,0"
                           Visibility="{Binding HasSymbolWarning, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding SymbolWarning}"
                           FontSize="11" Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSymbolWarning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Tests DataGrid -->
        <DataGrid Grid.Row="1" Margin="16,0,16,0"
                  MinHeight="400" MaxHeight="600"
                  ItemsSource="{Binding Detect.Tests}" CellStyle="{StaticResource DirectEditCellStyle}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ColumnWidth="SizeToCells">
            <DataGrid.Resources>
                <Style TargetType="TextBox" BasedOn="{StaticResource GridCellEditor}"/>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource CellHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Name" ToolTip="{StaticResource Help.Detection.Tests.Name}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{StaticResource Help.Detection.Tests.Name}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Symbol" ToolTip="{StaticResource Help.Detection.Tests.Symbol}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSymbolDuplicate}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{StaticResource Help.Detection.Tests.Symbol}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Path column: lock icon + TextBox + Registry browse + File browse -->
                <DataGridTemplateColumn Width="300" MinWidth="180">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Path" ToolTip="{StaticResource Help.Detection.Tests.Path}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="2" Margin="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPathLockedByCommand}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBgBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Browse-lock icon (clickable to unlock) -->
                                    <Button Grid.Column="0"
                                            Tag="{Binding}"
                                            Click="UnlockPathClick"
                                            Visibility="{Binding IsPathLocked, Converter={StaticResource BoolToVis}}"
                                            Background="Transparent" BorderThickness="0" Padding="2,0"
                                            VerticalAlignment="Center" Cursor="Hand">
                                        <Button.ToolTip>
                                            <TextBlock FontFamily="Segoe UI" MaxWidth="300" TextWrapping="Wrap"
                                                       Text="{StaticResource Help.Detection.Tests.PathLockedByBrowse}"/>
                                        </Button.ToolTip>
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource AccentBgBrush}"/>
                                    </Button>
                                    <!-- Command-lock indicator (non-clickable) -->
                                    <TextBlock Grid.Column="1" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource AccentBgBrush}"
                                               VerticalAlignment="Center" Margin="4,0,2,0"
                                               Visibility="{Binding IsPathLockedByCommand, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.ToolTip>
                                            <TextBlock FontFamily="Segoe UI" MaxWidth="300" TextWrapping="Wrap"
                                                       Text="{StaticResource Help.Detection.Tests.PathLockedByCommand}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <!-- Path text -->
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Help.Detection.Tests.Path}"
                                             IsReadOnly="{Binding FieldStates[Path].IsEnabled, Converter={StaticResource InvertBool}}"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" Padding="2,0"/>
                                    <!-- Registry browse button -->
                                    <Button Grid.Column="3"
                                            Tag="{Binding}"
                                            Click="BrowseRegistryClick"
                                            ToolTip="{StaticResource Help.Detection.Tests.BrowseRegistry}"
                                            Background="Transparent" BorderThickness="0" Padding="4,0"
                                            VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="&#xF259;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource AccentBgBrush}"/>
                                    </Button>
                                    <!-- File browse button -->
                                    <Button Grid.Column="4"
                                            Tag="{Binding}"
                                            Click="BrowsePathClick"
                                            ToolTip="{StaticResource Help.Detection.Tests.BrowseFile}"
                                            Background="Transparent" BorderThickness="0" Padding="4,0"
                                            VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource AccentBgBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Command column: lock icon + TextBox when Path has content -->
                <DataGridTemplateColumn Width="200" MinWidth="120">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Command" ToolTip="{StaticResource Help.Detection.Tests.Command}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="2" Margin="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FieldStates[Command].IsEnabled}" Value="False">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBgBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource AccentBgBrush}"
                                               VerticalAlignment="Center" Margin="4,0,2,0"
                                               Visibility="{Binding FieldStates[Command].IsEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock.ToolTip>
                                            <TextBlock FontFamily="Segoe UI" MaxWidth="300" TextWrapping="Wrap"
                                                       Text="{StaticResource Help.Detection.Tests.CommandLockedByPath}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Help.Detection.Tests.Command}"
                                             IsReadOnly="{Binding FieldStates[Command].IsEnabled, Converter={StaticResource InvertBool}}"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" Padding="2,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Property column: ComboBox when locked, TextBox when unlocked -->
                <DataGridTemplateColumn Width="130">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Property" ToolTip="{StaticResource Help.Detection.Tests.Property}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- ComboBox shown when path is locked (browsed) -->
                                <ComboBox SelectedItem="{Binding Property, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          ItemsSource="{Binding AvailableProperties}"
                                          SelectionChanged="PropertyComboBox_SelectionChanged"
                                          ToolTip="{StaticResource Help.Detection.Tests.Property}"
                                          Visibility="{Binding IsPathLocked, Converter={StaticResource BoolToVis}}"
                                          BorderThickness="0"
                                          Background="{DynamicResource DetectionDropdownBgBrush}"
                                          Padding="4,0" VerticalAlignment="Center"/>
                                <!-- TextBox shown when path is NOT locked (manual) -->
                                <TextBox Text="{Binding Property, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{StaticResource Help.Detection.Tests.Property}"
                                         Visibility="{Binding IsPathLocked, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" Padding="2,0"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto" MinWidth="130" IsReadOnly="True">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Operator" ToolTip="{StaticResource Help.Detection.Tests.Operator}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Operator, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      ItemsSource="{Binding DataContext.ValidOperators,
                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      ToolTip="{StaticResource Help.Detection.Tests.Operator}"
                                      BorderThickness="0"
                                      Background="{DynamicResource DetectionDropdownBgBrush}"
                                      Padding="4,0"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="100"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Value" ToolTip="{StaticResource Help.Detection.Tests.Value}"/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{StaticResource Help.Detection.Tests.Value}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <!-- BasedOn keeps the app's implicit TextBox theme (caret brush). -->
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="ToolTip" Value="{StaticResource Help.Detection.Tests.Value}"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- (duplicate warning moved to button bar above) -->
    </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
