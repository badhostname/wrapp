<UserControl x:Class="Wrapp.Views.AppIconSelectDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400">
    <UserControl.Resources>
        <!-- Source buttons: self-contained template so the hover state is
             unmistakable (accent background + dark text) instead of the
             theme default that blended into the dialog background. -->
        <Style x:Key="IconSourceButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource IconBoxBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="#1E1E1E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Web-style drop square: drag & drop target + click-to-browse, with
             the hover highlight confined to the box. -->
        <Border x:Name="DropZone" Height="150" CornerRadius="8"
                AllowDrop="True" Cursor="Hand"
                MouseLeftButtonUp="DropZone_Click"
                DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                ToolTip="{StaticResource Help.General.AppInfo.SelectIcon}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource IconBoxBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <!-- Mouse hover: subtle accent (as originally). The GREEN
                             state is for FILE-DRAG hover only, set in code-behind
                             (DropZone_DragEnter) together with the text swap. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- Fixed width + centered/trimmed text: the drag-state text swap
                 (e.g. a long filename in the subhint) must never change the
                 panel's layout width - that reflow is what made the icon
                 shift sideways during file hover. -->
            <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <!-- Foreground goes valid-drop green (or invalid red) during
                     FILE drag hover - code-behind, with the text swap. -->
                <TextBlock x:Name="DropIcon" Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                           FontSize="30" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="DropHint" Text="Drag &amp; drop an image here"
                           FontSize="13" FontWeight="SemiBold" Margin="0,8,0,2"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="DropSubHint" Text="or click to browse - PNG, JPG, ICO, BMP"
                           FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Secondary sources -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Default themed button - same look/hover as "Add Assignment"
                 in the assignments dialog. -->
            <Button Grid.Column="0" Click="Library_Click" Padding="10,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Icon library" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" x:Name="RemoveButton" Click="Remove_Click" Padding="10,8"
                    Style="{StaticResource IconSourceButton}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    ToolTip="{StaticResource Help.General.AppInfo.ClearIcon}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Remove icon" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
