                                                            CommandParameter="{Binding}"
                                                            ToolTip="{StaticResource Help.Inventory.Detail.ViewNestedGroupTree}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasNestedGroups}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="SquaresNested20" FontSize="10"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                            <TextBlock Text="Nested" FontSize="9"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBox Text="{Binding TargetLabel, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                                             Style="{StaticResource SelectableText}" FontSize="11"/>
                                                </DockPanel>

                                                <!-- Group ID -->
                                                <TextBox Grid.Row="3" Grid.Column="1"
                                                         FontSize="9" FontFamily="Consolas"
                                                         Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                                            <Setter Property="Text" Value="{Binding GroupId, Mode=OneWay}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GroupId}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <!-- Filter Mode -->
                                                <TextBlock Grid.Row="4" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Filter Mode"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FilterId}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding FilterMode}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FilterId}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Filter ID -->
                                                <TextBlock Grid.Row="5" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Filter"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FilterId}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="5" Grid.Column="1" FontSize="10" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding FilterId}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FilterId}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Notifications -->
                                                <TextBlock Grid.Row="6" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Notifications"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Notification}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Notification, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                                         FontSize="11" Margin="0,2" Visibility="{Binding Notification, Converter={StaticResource EmptyToVis}}"/>

                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Availability" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding AvailableTime, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}" Style="{StaticResource SelectableText}"
                                                         FontSize="11" Margin="0,2"/>

                                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Deadline" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding DeadlineTime, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}" Style="{StaticResource SelectableText}"
                                                         FontSize="11" Margin="0,2"/>

                                                <!-- Restart Grace Period -->
                                                <TextBlock Grid.Row="9" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Restart Grace"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RestartGracePeriod}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding RestartGracePeriod, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                                         FontSize="11" Margin="0,2" Visibility="{Binding RestartGracePeriod, Converter={StaticResource EmptyToVis}}"/>

                                                <!-- Delivery Optimization -->
                                                <TextBlock Grid.Row="10" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Delivery Opt."/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeliveryOptimization}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding DeliveryOptimization, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                                         FontSize="11" Margin="0,2" Visibility="{Binding DeliveryOptimization, Converter={StaticResource EmptyToVis}}"/>

                                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Source" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Source, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================================
                                 DEPENDENCIES (Intune section 5)  - this app depends on X
                                 ============================================================ -->
