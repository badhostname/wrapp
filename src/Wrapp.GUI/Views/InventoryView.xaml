<UserControl x:Class="Wrapp.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:models="clr-namespace:Wrapp.Models"
             xmlns:helpers="clr-namespace:Wrapp.Helpers"
             xmlns:local="clr-namespace:Wrapp">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EmptyToPlaceholderConverter x:Key="EmptyToPlaceholder"/>
        <local:EmptyToVisibilityConverter x:Key="EmptyToVis"/>

        <Style x:Key="CompactRadio" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Read-only TextBox that looks like a TextBlock but allows text selection/copy -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <!-- Placeholder handled by EmptyToPlaceholderConverter on bindings -->
        </Style>

        <!-- Detail value text: plain style, use EmptyToPlaceholder converter on bindings -->
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Intune list item -->
        <DataTemplate DataType="{x:Type models:IntuneAppSummary}">
            <Grid Margin="6,6,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                           FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Publisher}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                        <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding AppVersion}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <!-- Nested groups resolved badge -->
                <ui:SymbolIcon Grid.Column="1" Symbol="SquaresNested20"
                               FontSize="12" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,0,2,0"
                               ToolTip="{StaticResource Help.Inventory.NestedResolved}"
                               Visibility="{Binding HasNestedGroupData, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- SCCM list item -->
        <DataTemplate DataType="{x:Type models:SCCMAppSummary}">
            <Grid Margin="6,6,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                           FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Manufacturer}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                        <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding SoftwareVersion}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctrl:ViewHeader Grid.Row="0"
                         Title="Inventory"
                         HelpKey="Help.Inventory.Overview"/>

        <!-- Toolbar -->
        <Border Grid.Row="1" Margin="12,10,12,6" Padding="10,8"
                BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Platform toggle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Platform:" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontWeight="SemiBold" FontSize="12"/>
                    <RadioButton Content="Intune" GroupName="Platform"
                                 Style="{StaticResource CompactRadio}"
                                 ToolTip="{StaticResource Help.Inventory.Platform}"
                                 IsChecked="{Binding IsPlatformIntune, Mode=TwoWay}"/>
                    <RadioButton Content="SCCM" GroupName="Platform"
                                 Style="{StaticResource CompactRadio}" Margin="0"
                                 ToolTip="{StaticResource Help.Inventory.Platform}"
                                 IsChecked="{Binding IsPlatformSCCM, Mode=TwoWay}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="20" Margin="16,0"
                           Fill="{DynamicResource AppBorderBrush}" VerticalAlignment="Center"/>

                <!-- Target dropdown + Query/Refresh (label follows data state:
                     "Query" for the first fetch, "Refresh" once data exists) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding AvailableTargets}"
                              SelectedItem="{Binding SelectedTarget}"
                              DisplayMemberPath="Display"
                              ToolTip="{StaticResource Help.Inventory.Target}"
                              MinWidth="200" Margin="0,0,8,0"/>
                    <Button Padding="8,5" Command="{Binding QueryCommand}"
                            ToolTip="{StaticResource Help.Inventory.Toolbar.Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding QueryButtonLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Tenant-wide export: the command's CanExecute greys it
                         until the query has loaded AND the enrichment jobs
                         have completed; Intune targets only. -->
                    <Button Padding="8,5" Margin="8,0,0,0"
                            Command="{Binding ExportCatalogCommand}"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding IsPlatformIntune, Converter={StaticResource BoolToVis}}"
                            ToolTip="{StaticResource Help.Inventory.Toolbar.Export}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1" Height="20" Margin="16,0"
                           Fill="{DynamicResource AppBorderBrush}" VerticalAlignment="Center"/>

                <!-- Filter button with badge + popup -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FilterButton" Padding="8,5"
                            Command="{Binding ToggleFilterCommand}"
                            ToolTip="{StaticResource Help.Inventory.Toolbar.Filter}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Filter" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Active filter count badge -->
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="7" MinWidth="14" Height="14"
                                    Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-8,0"
                                    Visibility="{Binding Filters.IsActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Filters.ActiveCount}" FontSize="9" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Popup x:Name="FilterPopup"
                           IsOpen="{Binding IsFilterOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource AppBgBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16,12" MinWidth="300"
                                Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel DataContext="{Binding Filters}">

                                <TextBlock Text="Assignments" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Intent:" FontSize="11" FontWeight="SemiBold"
                                           ToolTip="{StaticResource Help.Inventory.Filter.Intent}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                            ToolTip="{StaticResource Help.Inventory.Filter.Intent}">
                                    <CheckBox Content="Required" IsChecked="{Binding IntentRequired}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Available" IsChecked="{Binding IntentAvailable}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Uninstall" IsChecked="{Binding IntentUninstall}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            ToolTip="{StaticResource Help.Inventory.Filter.Assignments}">
                                    <CheckBox Content="Has assignments" IsChecked="{Binding HasAssignments}" Margin="0,0,12,0"/>
                                    <CheckBox Content="No assignments" IsChecked="{Binding NoAssignments}"/>
                                </StackPanel>

                                <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,8"/>

                                <TextBlock Text="Requirements" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Architecture:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                            ToolTip="{StaticResource Help.Inventory.Filter.Architecture}">
                                    <CheckBox Content="x64" IsChecked="{Binding ArchX64}" Margin="0,0,12,0"/>
                                    <CheckBox Content="x86" IsChecked="{Binding ArchX86}" Margin="0,0,12,0"/>
                                    <CheckBox Content="ARM" IsChecked="{Binding ArchArm}"/>
                                </StackPanel>
                                <TextBlock Text="Min OS contains:" FontSize="11" FontWeight="SemiBold"
                                           ToolTip="{StaticResource Help.Inventory.Filter.MinOS}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ui:TextBox Text="{Binding MinOSFilter, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{StaticResource Help.Inventory.Filter.MinOS}"
                                            PlaceholderText="e.g. 22H2, W10_22H2"
                                            Margin="0,0,0,8"/>

                                <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,8"/>

                                <TextBlock Text="Content Size (MB)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            ToolTip="{StaticResource Help.Inventory.Filter.Size}">
                                    <TextBlock Text="Min:" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                    <ui:TextBox Text="{Binding MinSizeMB, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="0" Width="70" Margin="0,0,12,0"/>
                                    <TextBlock Text="Max:" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                    <ui:TextBox Text="{Binding MaxSizeMB, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="0" Width="70"/>
                                </StackPanel>

                                <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,8"/>

                                <TextBlock Text="Relationships" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            ToolTip="{StaticResource Help.Inventory.Filter.Relationships}">
                                    <CheckBox Content="Has dependencies" IsChecked="{Binding HasDependencies}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Has supersedence" IsChecked="{Binding HasSupersedence}"/>
                                </StackPanel>

                                <Button Content="Clear All Filters" Padding="8,4" HorizontalAlignment="Left"
                                        ToolTip="{StaticResource Help.Inventory.Filter.Clear}"
                                        Command="{Binding DataContext.ClearFiltersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search..."
                                MinWidth="220"/>
                    <Button Padding="4" Margin="4,0,0,0" Background="Transparent" BorderThickness="0"
                            ToolTip="{StaticResource Help.Inventory.Search}" Click="SearchHelp_Click">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Split panel -->
        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: App list -->
            <Border Grid.Column="0"
                    BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource InputBgBrush}">
                <Grid>
                    <ListBox ItemsSource="{Binding AppList}"
                             SelectedItem="{Binding SelectedApp}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Resources>
                            <!-- Same gentle wheel feel as the details pane opposite. -->
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Setter Property="helpers:SmoothScroll.Enabled" Value="True"/>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>

                    <!-- Empty state: Intune target needing sign-in - the same
                         cloud card affordance as the Run view's target block. -->
                    <Button Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            Padding="20,14" Cursor="Hand"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding SignInTenantCommand}"
                            ToolTip="{StaticResource Help.Run.ClickToSignIn}"
                            Visibility="{Binding NeedsIntuneSignIn, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="200">
                            <ui:SymbolIcon Symbol="Cloud24" FontSize="28"
                                           HorizontalAlignment="Center" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SignInTenantName}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sign in to connect" FontSize="10"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- Empty state: SCCM site unreachable -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220"
                                Visibility="{Binding SccmUnreachable, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Server24" FontSize="28"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource EmptyStateFgBrush}"/>
                        <TextBlock Text="Can't reach this site" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SccmUnreachableReason}" FontSize="11"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Empty state: ready - invite the query -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220"
                                Visibility="{Binding ShowQueryHint, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Search24" FontSize="28"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource EmptyStateFgBrush}"/>
                        <TextBlock Text="Ready to query" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Click Query above to load this target's apps" FontSize="11"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Background="{DynamicResource AppBgBrush}" Opacity="0.8"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"/>
                            <TextBlock Text="{Binding BusyOverlayText}" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Right: Detail panel -->
            <Border Grid.Column="2"
                    BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource InputBgBrush}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  helpers:SmoothScroll.Enabled="True"
                                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="16,12,16,16" DataContext="{Binding AppDetail}">

                            <!-- ============================================================
                                 APP INFORMATION (Intune section 1)
                                 ============================================================ -->
                            <DockPanel Margin="0,0,0,10">
                                <ctrl:SectionHeader Title="App Information"
                                                    HelpKey="Help.Inventory.Detail.AppInfo"
                                                    Margin="0,0,0,-12"/>
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.CopySectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="AppInfo" ToolTip="{StaticResource Help.Inventory.Detail.CopySection}">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </DockPanel>

                            <!-- Header: icon + name -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="64" Height="64"
                                        Margin="0,0,12,0" VerticalAlignment="Top"
                                        CornerRadius="6" Background="{DynamicResource ControlBgBrush}">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Stretch="Uniform" Width="56" Height="56"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding DisplayName, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                             FontSize="16" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding Id, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                             FontSize="10" FontFamily="Consolas"
                                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Shared fields: Description, Publisher, Version, Category -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Description" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Description, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Publisher" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Publisher, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Version" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Version, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Category" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CategoriesDisplay, Mode=OneWay}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>
                            </Grid>

                            <!-- Intune-only fields -->
                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=Intune}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Featured" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="0" Grid.Column="1" FontSize="11" Margin="0,2"
                                         IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                            <Setter Property="Text" Value="No"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFeatured}" Value="True">
                                                    <Setter Property="Text" Value="Yes"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Developer" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Developer, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Owner" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Owner, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Info URL" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InformationUrl, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Privacy URL" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PrivacyUrl, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Notes" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Notes, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>
                            </Grid>

                            <!-- SCCM-only fields -->
                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=SCCM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Technology" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Technology, Converter={StaticResource EmptyToPlaceholder}}" FontSize="11"
                                           Style="{StaticResource DetailValue}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Deployment Type" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeploymentTypeName, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                    <Border CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#4CAF50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Background" Value="#9E9E9E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9" Foreground="White" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Enabled"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Text" Value="Disabled"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Border CornerRadius="3" Padding="5,1" Margin="0,0,4,0" Background="#FF9800"
                                            Visibility="{Binding IsExpired, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Expired" FontSize="9" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border CornerRadius="3" Padding="5,1" Margin="0,0,4,0" Background="#F44336"
                                            Visibility="{Binding IsSuperseded, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Superseded" FontSize="9" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Console Folder" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ObjectPath, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Deployment Types" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NumberOfDeploymentTypes}" FontSize="11"
                                           Style="{StaticResource DetailValue}"/>
                            </Grid>

                            <!-- Shared: dates and admin info -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Created" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CreatedDateTime, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Modified" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LastModifiedDateTime, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <!-- SCCM: Created By / Modified By -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Created By" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"
                                           Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=SCCM}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CreatedBy, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"
                                         Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=SCCM}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Modified By" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"
                                           Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=SCCM}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LastModifiedBy, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"
                                         Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=SCCM}"/>
                            </Grid>

                            <Separator Margin="0,10" Background="{DynamicResource AppBorderBrush}"/>

                            <!-- ============================================================
                                 PROGRAM (Intune section 2)
                                 ============================================================ -->
                            <DockPanel Margin="0,0,0,8">
                                <ctrl:SectionHeader Title="Program"
                                                    HelpKey="Help.Inventory.Detail.Program"
                                                    Margin="0,0,0,-12"/>
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.CopySectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="Program" ToolTip="{StaticResource Help.Inventory.Detail.CopySection}">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </DockPanel>
                            <TextBlock Text="Install" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="4"
                                    Padding="8,4" Margin="0,0,0,6"
                                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                <TextBox Text="{Binding InstallCommand, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}" Style="{StaticResource SelectableText}"
                                         FontFamily="Consolas" FontSize="11"/>
                            </Border>
                            <TextBlock Text="Uninstall" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="4"
                                    Padding="8,4" Margin="0,0,0,6"
                                    BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                <TextBox Text="{Binding UninstallCommand, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}" Style="{StaticResource SelectableText}"
                                         FontFamily="Consolas" FontSize="11"/>
                            </Border>

                            <!-- Content location (SCCM only) -->
                            <StackPanel Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=SCCM}">
                                <TextBlock Text="Content Location" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4"
                                        Padding="8,4" Margin="0,0,0,6"
                                        BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                    <TextBox Text="{Binding ContentLocation, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}" Style="{StaticResource SelectableText}"
                                             FontFamily="Consolas" FontSize="11"/>
                                </Border>
                            </StackPanel>

                            <!-- Install experience row: shared context + max time, Intune-only restart -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Context: " FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding InstallExperience}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=Intune}">
                                    <TextBlock Text="Restart: " FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding RestartBehavior}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                </StackPanel>
                                <TextBlock Text="Max time: " FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{Binding MaxInstallTime, Mode=OneWay}"/>
                                    <Run Text=" min"/>
                                </TextBlock>
                            </StackPanel>

                            <Separator Margin="0,10" Background="{DynamicResource AppBorderBrush}"/>

                            <!-- Content (part of Program) -->
                            <TextBlock Text="Content" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,6"/>
                            <!-- Intune: File + Size -->
                            <StackPanel Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=Intune}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="File:" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding FileName, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}" Style="{StaticResource SelectableText}"
                                             FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Shared: Size -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Size:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding SizeDisplay, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}" Style="{StaticResource SelectableText}"
                                         FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Margin="0,10" Background="{DynamicResource AppBorderBrush}"/>

                            <!-- ============================================================
                                 REQUIREMENTS (Intune section 3)
                                 ============================================================ -->
                            <DockPanel Margin="0,0,0,8">
                                <ctrl:SectionHeader Title="Requirements"
                                                    HelpKey="Help.Inventory.Detail.Requirements"
                                                    Margin="0,0,0,-12"/>
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.CopySectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="Requirements" ToolTip="{StaticResource Help.Inventory.Detail.CopySection}">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </DockPanel>

                            <!-- System requirements grid (Intune only, SCCM requirements are per-DT in XML) -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=Intune}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Architecture" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Architecture, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum OS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinimumOSVersion, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}"
                                         Style="{StaticResource SelectableText}" FontSize="11" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Disk space (MB)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding MinimumFreeDiskSpaceMB, StringFormat='{}{0} MB'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MinimumFreeDiskSpaceMB}" Value="0">
                                                    <Setter Property="Text" Value="Not configured"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Memory (MB)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding MinimumMemoryMB, StringFormat='{}{0} MB'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MinimumMemoryMB}" Value="0">
                                                    <Setter Property="Text" Value="Not configured"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Logical processors" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding MinimumProcessors}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MinimumProcessors}" Value="0">
                                                    <Setter Property="Text" Value="Not configured"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="CPU speed (MHz)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding MinimumCpuSpeedMHz, StringFormat='{}{0} MHz'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MinimumCpuSpeedMHz}" Value="0">
                                                    <Setter Property="Text" Value="Not configured"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Custom requirement rules -->
                            <ItemsControl ItemsSource="{Binding Requirements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" Margin="0,0,0,3"
                                                Background="{DynamicResource ControlBgBrush}"
                                                CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{DynamicResource AppBorderBrush}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Border Background="{DynamicResource TextMutedBrush}"
                                                            CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding RuleType}" FontSize="9"
                                                                   Foreground="White" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Script preview for script-based requirements -->
                                                <Expander Header="Script Preview" Margin="0,2,0,0" Cursor="Hand"
                                                          Visibility="{Binding ScriptContent, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                    <Expander.Style>
                                                        <Style TargetType="Expander">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RuleType}" Value="Script">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Expander.Style>
                                                    <Border Background="{DynamicResource AppBgBrush}" CornerRadius="4"
                                                            Padding="8,4" MaxHeight="150" Cursor="Arrow"
                                                            BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                                        <TextBox Text="{Binding ScriptContent, Mode=OneWay}"
                                                                 Style="{StaticResource SelectableText}"
                                                                 FontFamily="Consolas" FontSize="10"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Auto"/>
                                                    </Border>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,10" Background="{DynamicResource AppBorderBrush}"/>

                            <!-- ============================================================
                                 DETECTION RULES (Intune section 4)
                                 ============================================================ -->
                            <DockPanel Margin="0,0,0,8">
                                <ctrl:SectionHeader Title="Detection Rules"
                                                    HelpKey="Help.Inventory.Detail.DetectionRules"
                                                    Margin="0,0,0,-12"/>
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.CopySectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="Detection" ToolTip="{StaticResource Help.Inventory.Detail.CopySection}">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Type: " FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DetectionType}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBox Text="{Binding DetectionSummary, Mode=OneWay, Converter={StaticResource EmptyToPlaceholder}}" Style="{StaticResource SelectableText}"
                                     FontSize="11" FontFamily="Consolas"
                                     Margin="0,0,0,4"/>
                            <!-- Script preview: only visible for PowerShell Script detection -->
                            <Expander Header="Script Preview" Margin="0,0,0,4" Cursor="Hand"
                                      Visibility="{Binding HasDetectionScript, Converter={StaticResource BoolToVis}}">
                                <!-- Arrow re-asserted on the content so the header's hand
                                     doesn't inherit into the preview (cursor-leak rule). -->
                                <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="4"
                                        Padding="8,4" MaxHeight="200" Cursor="Arrow"
                                        BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                                    <TextBox Text="{Binding DetectionScript, Mode=OneWay}"
                                             Style="{StaticResource SelectableText}"
                                             FontFamily="Consolas" FontSize="11"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </Expander>

                            <Separator Margin="0,10" Background="{DynamicResource AppBorderBrush}"/>

                            <!-- ============================================================
                                 SCOPE TAGS (Intune section 7)
                                 ============================================================ -->
                            <!-- Scope Tags: Intune only -->
                            <StackPanel Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=Intune}">
                                <ctrl:SectionHeader Title="Scope Tags"
                                                    HelpKey="Help.Inventory.Detail.ScopeTags"
                                                    Margin="0,0,0,-6"/>
                                <TextBlock Text="{Binding ScopeTagsDisplay}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <Separator Margin="0,10" Background="{DynamicResource AppBorderBrush}"/>
                            </StackPanel>

                            <!-- ============================================================
                                 ASSIGNMENTS (Intune section 8)
                                 ============================================================ -->
                            <DockPanel Margin="0,0,0,8">
                                <ctrl:SectionHeader Title="{Binding Assignments.Count, Mode=OneWay, StringFormat='Assignments ({0})'}"
                                                    HelpKey="Help.Inventory.Detail.Assignments"
                                                    Margin="0,0,0,-12"/>
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="2" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.ExportAssignmentsJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{StaticResource Help.Inventory.Detail.ExportAssignmentsJson}">
                                    <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="2" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.CopySectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="Assignments" ToolTip="{StaticResource Help.Inventory.Detail.CopySection}">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding AssignmentsSorted}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,6"
                                                Background="{DynamicResource ControlBgBrush}"
                                                CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Intent" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,3"/>
                                                <Border Grid.Row="0" Grid.Column="1" CornerRadius="3" Padding="6,2" Margin="0,0,0,3"
                                                        HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#616161"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Intent}" Value="required">
                                                                    <Setter Property="Background" Value="#C62828"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Intent}" Value="Required">
                                                                    <Setter Property="Background" Value="#C62828"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Intent}" Value="available">
                                                                    <Setter Property="Background" Value="#1565C0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Intent}" Value="Available">
                                                                    <Setter Property="Background" Value="#1565C0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Intent}" Value="uninstall">
                                                                    <Setter Property="Background" Value="#AD1457"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Intent}" Value="Uninstall">
                                                                    <Setter Property="Background" Value="#AD1457"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Intent}" FontSize="10"
                                                               Foreground="White" FontWeight="SemiBold"/>
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Group Mode" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                    <Border CornerRadius="3" Padding="5,2" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#2E7D32"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding GroupMode}" Value="Exclude">
                                                                        <Setter Property="Background" Value="#C62828"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="10" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="+"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding GroupMode}" Value="Exclude">
                                                                                <Setter Property="Text" Value="-"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding GroupMode}" FontSize="10"
                                                                       Foreground="White" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Group" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
