                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="App ID" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AppId, Mode=OneWay}"
