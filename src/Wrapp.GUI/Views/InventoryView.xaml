                            <!-- Return Codes (Intune only, SCCM does not expose return codes via API) -->
                            <StackPanel Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=Intune}">
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                                    <Run Text="Return Codes ("/>
                                    <Run Text="{Binding ReturnCodes.Count, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding ReturnCodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}" Width="60"/>
                                                <TextBlock Text="{Binding Type}" FontSize="11"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Margin="0,10" Background="{DynamicResource AppBorderBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Padding="12,6" Margin="0,0,8,0"
                                        Command="{Binding DataContext.CopyAllDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{StaticResource Help.Inventory.Actions.CopyAll}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Copy All" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,6" Margin="0,0,8,0"
                                        Command="{Binding DataContext.ExportJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{StaticResource Help.Inventory.Actions.ExportJson}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Export JSON" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,6" Margin="0,0,8,0"
                                        Command="{Binding DataContext.ImportToWrappCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{StaticResource Help.Inventory.Actions.ImportToWrapp}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Import to Wrapp" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Intune-only buttons -->
                                <Button Padding="12,6" Margin="0,0,8,0"
                                        Command="{Binding DataContext.DownloadIntuneWinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{StaticResource Help.Inventory.Actions.DownloadIntuneWin}"
                                        Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=Intune}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Download .intunewin" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,6" Margin="0,0,8,0"
                                        Command="{Binding DataContext.SaveIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{StaticResource Help.Inventory.Actions.SaveIcon}"
                                        Visibility="{Binding Platform, Converter={StaticResource StringMatchToVis}, ConverterParameter=Intune}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Save Icon" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty state: a faded skeleton of the real app summary
                         (grayed icon + notebook-style content lines) with the
                         call-to-action floating above it - the pane previews
                         its own purpose instead of sitting blank. -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDetailLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- The skeleton itself: non-interactive, heavily faded -->
                        <StackPanel Margin="28,24" Opacity="0.16" IsHitTestVisible="False">
                            <StackPanel.Resources>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                    <Setter Property="RadiusX" Value="4"/>
                                    <Setter Property="RadiusY" Value="4"/>
                                    <Setter Property="Height" Value="10"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </StackPanel.Resources>
                            <!-- header: icon + title/subtitle -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="64" Height="64" RadiusX="10" RadiusY="10"/>
                                <StackPanel Grid.Column="1" Margin="16,6,0,0" VerticalAlignment="Top">
                                    <Rectangle Width="220" Height="14" Margin="0,0,0,10"/>
                                    <Rectangle Width="140" Height="10"/>
                                </StackPanel>
                            </Grid>
                            <!-- content lines, notebook-style -->
                            <Rectangle Width="420" Margin="0,0,0,10"/>
                            <Rectangle Width="360" Margin="0,0,0,10"/>
                            <Rectangle Width="400" Margin="0,0,0,10"/>
                            <Rectangle Width="300" Margin="0,0,0,24"/>
                            <Rectangle Width="180" Height="12" Margin="0,0,0,12"/>
                            <Rectangle Width="410" Margin="0,0,0,10"/>
                            <Rectangle Width="340" Margin="0,0,0,10"/>
                            <Rectangle Width="390" Margin="0,0,0,24"/>
                            <Rectangle Width="180" Height="12" Margin="0,0,0,12"/>
                            <Rectangle Width="370" Margin="0,0,0,10"/>
                            <Rectangle Width="290" Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- The call to action, floating over the skeleton -->
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="18,12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           HorizontalAlignment="Center" Margin="0,0,0,6"
                                           Foreground="{DynamicResource EmptyStateFgBrush}"/>
                                <TextBlock Text="Select an app to view its details"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Assignments, detection, install commands and more"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Detail loading overlay -->
                    <Border Background="{DynamicResource AppBgBrush}" Opacity="0.8"
                            Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress bar + status text -->
        <Border Grid.Row="3" Padding="12,4,12,8">
            <StackPanel>
                <ProgressBar Height="4" Margin="0,0,0,4"
                             IsIndeterminate="{Binding IsBackgroundWorking}"
                             Visibility="{Binding IsBackgroundWorking, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#E05C5C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
