<ui:FluentWindow x:Class="Wrapp.Views.FileHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding WindowTitle}"
        Height="700" Width="1050"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/burrito.ico"
        Background="{DynamicResource AppBgBrush}">

    <Grid>
        <!-- ContentDialogHost for fluent-style confirmation dialogs -->
        <ui:ContentDialogHost x:Name="DialogHost"/>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Title bar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}"/>

        <!-- Row 1: Split - commit list (left) + diff viewer (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Commit timeline -->
            <ListBox Grid.Column="0"
                     x:Name="CommitList"
                     ItemsSource="{Binding Commits}"
                     Background="{DynamicResource AppBgBrush}"
                     BorderThickness="0,0,1,0"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     SelectionChanged="CommitList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource NavHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource NavSelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Graph gutter -->
                            <Grid Grid.Column="0" Grid.RowSpan="2" Width="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Width="2"
                                           Fill="{DynamicResource GitGraphLineBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                           Visibility="{Binding IsFirst,
                                               Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <Rectangle Grid.Row="1" Width="2"
                                           Fill="{DynamicResource GitGraphLineBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                           Visibility="{Binding IsLast,
                                               Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <Ellipse Grid.RowSpan="2" Width="8" Height="8"
                                         Fill="{DynamicResource GitGraphDotBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Row 0: Message -->
                            <TextBlock Grid.Column="2" Grid.Row="0"
                                       Text="{Binding Message}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Row 1: Hash + time -->
                            <StackPanel Grid.Column="2" Grid.Row="1"
                                        Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Hash}"
                                           FontFamily="Consolas" FontSize="10"
                                           Foreground="#569CD6"/>
                                <TextBlock Text="{Binding RelativeTime}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Right: Diff viewer -->
            <wv2:WebView2 Grid.Column="2" x:Name="DiffWebView"
                          SizeChanged="DiffWebView_SizeChanged"/>
        </Grid>

        <!-- Row 2: Footer (restore button + status) -->
        <Border Grid.Row="2"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text="Select a commit to view changes"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="RestoreButton"
                        Content="Restore to this version"
                        Click="RestoreButton_Click"
                        ToolTip="{StaticResource Help.FileHistory.Restore}"
                        IsEnabled="False"
                        Padding="14,6"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
