<UserControl x:Class="Wrapp.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:helpers="clr-namespace:Wrapp.Helpers"
             AllowDrop="True"
             DragEnter="UserControl_DragEnter"
             DragOver="UserControl_DragOver"
             DragLeave="UserControl_DragLeave"
             Drop="UserControl_Drop">

    <Grid>
        <!-- Main content (blurred when dragging) -->
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ctrl:ViewHeader Grid.Row="0"
                             Title="Tools"
                             HelpKey="Help.Tools.Overview"/>

            <TabControl Grid.Row="1" x:Name="ToolTabs">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Style>
                </TabControl.Resources>
                <!-- =========================================================
                     TAB 1: DECRYPT
                     ========================================================= -->
                <!-- Tag drives drag-drop routing (ToolsView.xaml.cs). Route by
                     Tag, never by tab index, so a reorder cannot silently send
                     a drop to the wrong tab (regression fixed 0.6.0.0277). -->
                <TabItem Header="Intunewin Decrypt" Tag="decrypt">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="8"
                                      helpers:SmoothScroll.Enabled="True">
                            <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Intunewin Decrypt" HelpKey="Help.Tools.Decrypt"
                                                    Margin="0,0,0,-4"/>
                                <TextBlock Text="Drop an .intunewin or encrypted file here, or browse to decrypt. If the file has embedded keys they will be loaded automatically."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- File selection -->
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0"
                                            ToolTip="{StaticResource Help.Tools.Decrypt.File}"
                                            Command="{Binding BrowseDecryptFileCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Browse..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBox Text="{Binding DecryptFilePath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Help.Tools.Decrypt.File}"
                                             IsReadOnly="True" Padding="6,4"/>
                                </DockPanel>

                                <!-- Key source radio buttons -->
                                <TextBlock Text="Key source" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <StackPanel Margin="0,0,0,12">
                                    <RadioButton x:Name="KeySourceEmbedded" Content="Embedded keys (from detection.xml)"
                                                 IsChecked="True" GroupName="KeySource" Margin="0,0,0,4"
                                                 ToolTip="{StaticResource Help.Tools.Decrypt.KeyEmbedded}"
                                                 Checked="KeySource_Changed"/>
                                    <RadioButton x:Name="KeySourceManual" Content="Manual key (paste Base64 key and IV)"
                                                 GroupName="KeySource" Margin="0,0,0,4"
                                                 ToolTip="{StaticResource Help.Tools.Decrypt.KeyManual}"
                                                 Checked="KeySource_Changed"/>
                                    <RadioButton x:Name="KeySourceVault" Content="From vault (lookup by tenant + app ID)"
                                                 GroupName="KeySource" Margin="0,0,0,4"
                                                 ToolTip="{StaticResource Help.Tools.Decrypt.KeyVault}"
                                                 Checked="KeySource_Changed"/>
                                    <RadioButton x:Name="KeySourceBruteForce" Content="Vault brute force (try all saved keys)"
                                                 GroupName="KeySource" Margin="0,0,0,4"
                                                 ToolTip="{StaticResource Help.Tools.Decrypt.KeyBruteForce}"
                                                 Checked="KeySource_Changed"/>
                                    <RadioButton x:Name="KeySourceCsv" Content="CSV key list (browse for CSV file)"
                                                 GroupName="KeySource" Margin="0,0,0,4"
                                                 ToolTip="{StaticResource Help.Tools.Decrypt.KeyCsv}"
                                                 Checked="KeySource_Changed"/>
                                </StackPanel>

                                <!-- Key + IV fields (embedded / manual) -->
                                <StackPanel Margin="0,0,0,12"
                                            Visibility="{Binding DecryptKeySource, Converter={StaticResource StringMatchToVis}, ConverterParameter=embedded|manual}">
                                    <TextBlock Text="Encryption Key (Base64)" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding ManualKey, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding EmbeddedKeysReadOnly}"
                                             ToolTip="{StaticResource Help.Tools.Decrypt.Key}"
                                             FontFamily="Consolas" FontSize="10" Padding="6,4" Margin="0,0,0,6"/>
                                    <TextBlock Text="Initialization Vector (Base64)" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding ManualIV, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding EmbeddedKeysReadOnly}"
                                             ToolTip="{StaticResource Help.Tools.Decrypt.IV}"
                                             FontFamily="Consolas" FontSize="10" Padding="6,4"/>
                                </StackPanel>

                                <!-- Vault lookup fields (vault only) -->
                                <StackPanel Margin="0,0,0,12"
                                            Visibility="{Binding DecryptKeySource, Converter={StaticResource StringMatchToVis}, ConverterParameter=vault}">
                                    <TextBlock Text="Tenant ID" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding VaultTenantId, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Help.Tools.Decrypt.VaultTenantId}"
                                             FontFamily="Consolas" FontSize="10" Padding="6,4" Margin="0,0,0,6"/>
                                    <TextBlock Text="App ID" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding VaultAppId, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Help.Tools.Decrypt.VaultAppId}"
                                             FontFamily="Consolas" FontSize="10" Padding="6,4"/>
                                </StackPanel>

                                <!-- CSV file path (csv only) -->
                                <DockPanel Margin="0,0,0,12"
                                           Visibility="{Binding DecryptKeySource, Converter={StaticResource StringMatchToVis}, ConverterParameter=csv}">
                                    <Button DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0"
                                            ToolTip="{StaticResource Help.Tools.Decrypt.CsvFile}"
                                            Command="{Binding BrowseCsvFileCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Browse..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBox Text="{Binding CsvFilePath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Help.Tools.Decrypt.CsvFile}"
                                             IsReadOnly="True" Padding="6,4"/>
                                </DockPanel>
                            </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Row 1: Decrypt button (mirrors Batch Inspect's Save row position) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,8,8,0">
                            <Button Content="Decrypt" Padding="16,6"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding CanDecrypt}"
                                    ToolTip="{StaticResource Help.Tools.Decrypt.Run}"
                                    Command="{Binding DecryptFileCommand}"/>
                        </StackPanel>

                        <!-- Row 2: progress bar + status text -->
                        <Border Grid.Row="2" Padding="12,4,12,8">
                            <StackPanel>
                                <ProgressBar Height="4" Margin="0,0,0,4"
                                             IsIndeterminate="{Binding IsDecrypting}"
                                             Visibility="{Binding IsDecrypting, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding DecryptStatus}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- =========================================================
                     TAB 2: INSPECT
                     ========================================================= -->
                <TabItem Header="Intunewin Inspect" Tag="inspect">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="8"
                                      helpers:SmoothScroll.Enabled="True">
                            <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Intunewin Inspect" HelpKey="Help.Tools.Inspect"
                                                    Margin="0,0,0,-4"/>
                                <!-- File path -->
                                <TextBlock Text="Drop an .intunewin file here or browse to inspect its metadata and encryption keys."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0"
                                            ToolTip="{StaticResource Help.Tools.Inspect.File}"
                                            Command="{Binding BrowseInspectFileCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Browse..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBox Text="{Binding InspectFilePath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Help.Tools.Inspect.File}"
                                             IsReadOnly="True" Padding="6,4"/>
                                </DockPanel>

                                <!-- Results card -->
                                <Border Visibility="{Binding HasInspectResult, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        ToolTip="{StaticResource Help.Tools.Inspect.KeyMaterial}"
                                        BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Package Name" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InspectResult.PackageName, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="11" Margin="0,2"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Setup File" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InspectResult.SetupFile, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="11" Margin="0,2"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Encrypted File" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InspectResult.InnerFileName, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="11" Margin="0,2"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Original Size" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InspectResult.UnencryptedContentSize, Mode=OneWay, StringFormat='{}{0:N0} bytes'}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="11" Margin="0,2"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Encryption Key" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding InspectResult.EncryptionKey, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontSize="9" FontFamily="Consolas" Margin="0,2"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Initialization Vector" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding InspectResult.InitializationVector, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontSize="9" FontFamily="Consolas" Margin="0,2"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="MAC Key" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding InspectResult.MacKey, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontSize="9" FontFamily="Consolas" Margin="0,2"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="MAC" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding InspectResult.Mac, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontSize="9" FontFamily="Consolas" Margin="0,2"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="File Digest" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding InspectResult.FileDigest, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontSize="9" FontFamily="Consolas" Margin="0,2"/>

                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Digest Algorithm" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding InspectResult.FileDigestAlgorithm, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="11" Margin="0,2"/>

                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Source Path" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding InspectResult.SourcePath, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontSize="9" FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <!-- Vault filename + action buttons -->
                                <StackPanel Visibility="{Binding HasInspectResult, Converter={StaticResource BoolToVis}}">
                                    <ctrl:SectionHeader Title="Key Vault" HelpKey="Help.Tools.Vault"
                                                        Margin="0,4,0,-8"/>
                                    <TextBlock Text="Vault filename (editable)" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock DockPanel.Dock="Right" Text=".json" FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBox Text="{Binding VaultFileName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{StaticResource Help.Tools.Inspect.VaultFileName}"
                                                 Padding="6,4"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Copy Keys" Padding="12,6" Margin="0,0,8,0"
                                                IsEnabled="{Binding IsInspecting, Converter={StaticResource InvertBool}}"
                                                ToolTip="{StaticResource Help.Tools.Inspect.CopyKeys}"
                                                Command="{Binding CopyInspectKeysCommand}"/>
                                        <Button Content="Save Keys to Vault" Padding="12,6"
                                                IsEnabled="{Binding IsInspecting, Converter={StaticResource InvertBool}}"
                                                ToolTip="{StaticResource Help.Tools.Vault}"
                                                Command="{Binding SaveInspectKeysToVaultCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Bottom: progress bar + status text -->
                        <Border Grid.Row="1" Padding="12,4,12,8">
                            <StackPanel>
                                <ProgressBar Height="4" Margin="0,0,0,4"
                                             IsIndeterminate="{Binding IsInspecting}"
                                             Visibility="{Binding IsInspecting, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding InspectStatus}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- =========================================================
                     TAB 3: BATCH INSPECT
                     ========================================================= -->
                <TabItem Header="Batch Inspect" Tag="batch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Folder selection + Scan -->
                        <Border Grid.Row="0" Style="{StaticResource FormCard}" Margin="8,8,8,0">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Batch Inspect" HelpKey="Help.Tools.Batch"
                                                    Margin="0,0,0,-4"/>
                                <TextBlock Text="Select a folder containing .intunewin files to extract encryption keys in bulk."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Cancel" Padding="12,4" Margin="8,0,0,0"
                                            Command="{Binding CancelBatchCommand}"
                                            IsEnabled="{Binding IsBatchScanning}"/>
                                    <Button DockPanel.Dock="Right" Content="Scan" Padding="16,4" Margin="8,0,0,0"
                                            ToolTip="{StaticResource Help.Tools.Batch.Scan}"
                                            Command="{Binding ScanBatchCommand}"
                                            IsEnabled="{Binding IsBatchScanning, Converter={StaticResource InvertBool}}"/>
                                    <Button DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0"
                                            ToolTip="{StaticResource Help.Tools.Batch.Folder}"
                                            Command="{Binding BrowseBatchFolderCommand}"
                                            IsEnabled="{Binding IsBatchScanning, Converter={StaticResource InvertBool}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Browse..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBox Text="{Binding BatchFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{StaticResource Help.Tools.Batch.Folder}"
                                             IsReadOnly="True" Padding="6,4"/>
                                </DockPanel>
                                <CheckBox Content="Recursive search (include subfolders)"
                                          IsChecked="{Binding BatchRecursive}"
                                          ToolTip="{StaticResource Help.Tools.Batch.Recursive}"
                                          Margin="0,6,0,0" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Row 1: Results DataGrid -->
                        <DataGrid Grid.Row="1" Margin="8,8,8,0"
                                  ItemsSource="{Binding BatchResults}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  CellStyle="{StaticResource DirectEditCellStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                                  Background="{DynamicResource ControlBgBrush}"
                                  RowBackground="{DynamicResource ControlBgBrush}"
                                  AlternatingRowBackground="{DynamicResource CardBgBrush}">
                            <DataGrid.Resources>
                                <Style TargetType="TextBox" BasedOn="{StaticResource GridCellEditor}"/>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasKeys}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Width="200" IsReadOnly="True"
                                                    Binding="{Binding FileName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="6,0,0,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Status" Width="110" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,0"
                                                        ToolTip="{StaticResource Help.Tools.Batch.Status}">
                                                <Border CornerRadius="3" Padding="6,2" Margin="0,0,3,0"
                                                        Background="#2E7D32" VerticalAlignment="Center"
                                                        Visibility="{Binding StatusLabel, Converter={StaticResource StringMatchToVis}, ConverterParameter=OK}">
                                                    <TextBlock Text="OK" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border CornerRadius="3" Padding="6,2" Margin="0,0,3,0"
                                                        Background="#616161" VerticalAlignment="Center"
                                                        Visibility="{Binding StatusLabel, Converter={StaticResource StringMatchToVis}, ConverterParameter=No metadata}">
                                                    <TextBlock Text="No metadata" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border CornerRadius="3" Padding="4,2"
                                                        Background="#1565C0" VerticalAlignment="Center"
                                                        Visibility="{Binding ExistsVault, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="vault" FontSize="9" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="App Name" Width="150" IsReadOnly="True"
                                                    Binding="{Binding AppName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Version" Width="80" IsReadOnly="True"
                                                    Binding="{Binding Version}"/>
                                <DataGridTextColumn Header="Size" Width="70" IsReadOnly="True"
                                                    Binding="{Binding SizeDisplay}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Key" Width="120" IsReadOnly="True"
                                                    Binding="{Binding KeyPreview}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Time" Width="65" IsReadOnly="True"
                                                    Binding="{Binding ElapsedDisplay}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Vault Name" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding VaultName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{StaticResource Help.Tools.Batch.VaultName}"
                                                     IsEnabled="{Binding HasKeys}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Row 2: Save buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,8,8,0">
                            <Button Content="Save to Vault" Padding="16,6"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding CanSaveBatch}"
                                    ToolTip="{StaticResource Help.Tools.Vault}"
                                    Command="{Binding SaveBatchToVaultCommand}"/>
                        </StackPanel>

                        <!-- Row 3: Progress + status -->
                        <Border Grid.Row="3" Padding="12,4,12,8">
                            <StackPanel>
                                <ProgressBar Height="4" Margin="0,0,0,4"
                                             Value="{Binding BatchProgress}"
                                             Visibility="{Binding IsBatchScanning, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding BatchStatus}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Drag overlay (shown when dragging .intunewin over the view) -->
        <Grid x:Name="DragOverlay" Visibility="Collapsed" Background="#A0000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DragIcon" Text="&#xE896;"
                           FontFamily="Segoe MDL2 Assets" FontSize="48"
                           Foreground="#4CAF50"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="DragText" Text="Drop .intunewin file"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DragSubtext" Text=""
                           FontSize="12" Foreground="#AAAAAA"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
