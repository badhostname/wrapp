<UserControl x:Class="Wrapp.Views.IconPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480">

    <StackPanel Margin="0,0,0,8">

        <!-- Explanation text -->
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,16"
                   Text="The new installer has the same application name. Choose which icon to keep by clicking on it."/>

        <!-- Side-by-side icon boxes -->
        <Grid HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Old (current) icon box -->
            <Border x:Name="OldIconBorder"
                    Grid.Column="0"
                    Width="160" Height="160"
                    CornerRadius="8"
                    BorderThickness="3"
                    BorderBrush="{DynamicResource AccentBgBrush}"
                    Background="{DynamicResource CardBgBrush}"
                    Cursor="Hand"
                    MouseLeftButtonDown="OldIcon_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image x:Name="OldIconImage"
                           Width="96" Height="96" Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Current" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Arrow between icons -->
            <TextBlock Grid.Column="1"
                       Text="&#xE72A;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="24"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- New icon box -->
            <Border x:Name="NewIconBorder"
                    Grid.Column="2"
                    Width="160" Height="160"
                    CornerRadius="8"
                    BorderThickness="3"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource CardBgBrush}"
                    Cursor="Hand"
                    MouseLeftButtonDown="NewIcon_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image x:Name="NewIconImage"
                           Width="96" Height="96" Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="New" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- App name label -->
        <TextBlock x:Name="AppNameLabel"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"/>

    </StackPanel>
</UserControl>
