<UserControl x:Class="Wrapp.Views.SCCMDeploymentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:helpers="clr-namespace:Wrapp.Helpers"
             Width="720">

    <StackPanel Margin="0,0,0,8">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAdd" Padding="12,4" Click="BtnAdd_Click"
                    ToolTip="{StaticResource Help.SCCM.Deployments.Add}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Add Deployment" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Template:" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="TemplateComboBox"
                      MinWidth="140" FontSize="12"
                      DisplayMemberPath="Name"
                      ToolTip="{StaticResource Help.SCCM.Deployments.TemplateCombo}"
                      SelectionChanged="TemplateComboBox_SelectionChanged"/>
            <Button x:Name="BtnHelp" Click="HelpButton_Click"
                    Background="Transparent" BorderThickness="0"
                    Padding="4,0" Margin="8,0,0,0"
                    Cursor="Hand" VerticalAlignment="Center"
                    ToolTip="{StaticResource Help.Common.Toolbar.ToggleHelp}">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
            </Button>
        </StackPanel>

        <!-- Inline help panel (toggled by info button) -->
        <Border x:Name="HelpPanel" Visibility="Collapsed"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="16,12" Margin="0,0,0,8"
                MaxHeight="250">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          helpers:SmoothScroll.Enabled="True">
                <StackPanel x:Name="HelpContent"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="PlaceholderText"
                   Text="No deployments configured. Click Add Deployment to create one."
                   FontSize="12" FontStyle="Italic"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,8,0,0"/>

        <ItemsControl x:Name="DeploymentItems">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="4" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    <Expander IsExpanded="{Binding IsSelected, Mode=TwoWay}"
                              Style="{StaticResource SettingsCardExpander}"
                              Margin="0">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,12,0">
                                    <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="18" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <!-- Red = blocking errors; amber = warnings (incomplete or
                                         duplicate targeting) - same colors as the nav badges. -->
                                    <Border Background="{DynamicResource BadgeBgBrush}"
                                            CornerRadius="6" MinWidth="12" Height="12"
                                            Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-4,-4,0"
                                            ToolTip="{StaticResource Help.Common.ErrorBadge}"
                                            Visibility="{Binding ErrorCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding ErrorCount}" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource BadgeFgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{DynamicResource WarnBadgeBgBrush}"
                                            CornerRadius="6" MinWidth="12" Height="12"
                                            Padding="2,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="-4,-4,0,0"
                                            ToolTip="{StaticResource Help.Common.WarningBadge}"
                                            Visibility="{Binding WarningCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding WarningCount}" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarnBadgeFgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{Binding DisplayName}"
                                                ToolTip="{StaticResource Help.SCCM.Deployments.Label}"
                                                FontSize="13" FontWeight="SemiBold"
                                                Padding="4,2" MinWidth="180"
                                                BorderThickness="0"
                                                Background="Transparent"/>
                                    <TextBlock Text="{Binding DisplaySubtitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="4,2,0,0"/>
                                    <TextBlock Text="Duplicate target - this collection is already targeted by another enabled deployment in this bundle."
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Margin="4,2,0,0"
                                               Visibility="{Binding HasDuplicateTarget, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Tag="{Binding}"
                                        Click="BtnSaveTemplate_Click"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="{StaticResource Help.SCCM.Deployments.SaveTemplate}"
                                        Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Grid.Column="3"
                                        Tag="{Binding}"
                                        Click="BtnDuplicateItem_Click"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="{StaticResource Help.SCCM.Deployments.Duplicate}"
                                        Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Grid.Column="4"
                                        Tag="{Binding}"
                                        Click="BtnRemoveItem_Click"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="{StaticResource Help.SCCM.Deployments.Remove}"
                                        Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="0,8,0,0">

                            <StackPanel Margin="0,0,0,12">
                                <ctrl:FieldLabelRow Text="Collection"
                                                    IsMissing="{Binding IsCollectionMissing}"
                                                    Help="{StaticResource Help.SCCM.Deployments.Collection}"/>
                                <TextBox Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Deploy Action" Style="{StaticResource FieldLabel}"
                                               ToolTip="{StaticResource Help.SCCM.Deployments.DeployAction}"/>
                                    <ComboBox SelectedItem="{Binding DeployAction, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              ItemsSource="{Binding DataContext.ValidDeployActions,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Deploy Purpose" Style="{StaticResource FieldLabel}"
                                               ToolTip="{StaticResource Help.SCCM.Deployments.DeployPurpose}"/>
                                    <ComboBox SelectedItem="{Binding DeployPurpose, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              ItemsSource="{Binding DataContext.ValidDeployPurposes,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="User Notification" Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource Help.SCCM.Deployments.UserNotification}"/>
                                <ComboBox SelectedItem="{Binding UserNotification, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          ItemsSource="{Binding DataContext.ValidUserNotifications,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>

                            <Expander Header="Scheduling and Options" IsExpanded="True"
                                      Style="{StaticResource FormCardExpander}">
                                <StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Available Date/Time" Style="{StaticResource FieldLabel}"
                                                       ToolTip="{StaticResource Help.SCCM.Deployments.AvailableDateTime}"/>
                                            <ctrl:DateTimePickerField
                                                Text="{Binding AvailableDateTime, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Deadline Date/Time" Style="{StaticResource FieldLabel}"
                                                       ToolTip="{StaticResource Help.SCCM.Deployments.DeadlineDateTime}"/>
                                            <ctrl:DateTimePickerField
                                                Text="{Binding DeadlineDateTime, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{Binding DeadlineDateTimeHint, TargetNullValue={StaticResource Help.SCCM.Deployments.DeadlineDateTime}}"
                                                ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Time Base On" Style="{StaticResource FieldLabel}"
                                                       ToolTip="{StaticResource Help.SCCM.Deployments.TimeBaseOn}"/>
                                            <ComboBox SelectedItem="{Binding TimeBaseOn, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.ValidTimeBaseOn,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Comment" Style="{StaticResource FieldLabel}"
                                                       ToolTip="{StaticResource Help.SCCM.Deployments.Comment}"/>
                                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <!-- Advisory uninstall hint wins when present; otherwise the
                                             static help text shows (TargetNullValue fallback). -->
                                        <CheckBox Content="Approval Required"
                                                  IsChecked="{Binding ApprovalRequired, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{Binding ApprovalRequiredHint, TargetNullValue={StaticResource Help.SCCM.Deployments.ApprovalRequired}}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  Margin="0,0,24,0"/>
                                        <CheckBox Content="Override Service Window"
                                                  IsChecked="{Binding OverrideServiceWindow, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{StaticResource Help.SCCM.Deployments.OverrideServiceWindow}"
                                                  Margin="0,0,24,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="Reboot Outside Service Window"
                                                  IsChecked="{Binding RebootOutsideServiceWindow, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{StaticResource Help.SCCM.Deployments.RebootOutsideServiceWindow}"
                                                  Margin="0,0,24,0"/>
                                        <CheckBox Content="Send Wakeup Packet"
                                                  IsChecked="{Binding SendWakeupPacket, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{StaticResource Help.SCCM.Deployments.SendWakeupPacket}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </Expander>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
