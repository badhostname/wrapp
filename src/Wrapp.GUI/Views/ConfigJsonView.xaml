<UserControl x:Class="Wrapp.Views.ConfigJsonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctrl:ViewHeader Grid.Row="0"
                         Title="Configuration"
                         HelpKey="Help.Configuration.Overview"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,4,8,4">
            <Button Click="HistoryButton_Click"
                    Padding="8,5" Margin="0,0,8,0"
                    ToolTip="{StaticResource Help.Common.Toolbar.FileHistory}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="History24" FontSize="16"/>
                    <TextBlock Text="History" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="RefreshButton_Click"
                    Padding="8,5" Margin="0,0,8,0"
                    ToolTip="{StaticResource Help.Common.RefreshEditor}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh Editor" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Padding="8,5" Margin="0,0,8,0"
                    ToolTip="{StaticResource Help.Configuration.SyncDomainsButton}"
                    Click="SyncDomainsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Sync Domains" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Overwrite with Preferences"
                                  ToolTip="{StaticResource Help.Configuration.SyncDomains.Overwrite}"
                                  Command="{Binding Tenants.SyncDomainsOverwriteFromPrefsCommand}"/>
                        <MenuItem Header="Add missing from Preferences"
                                  ToolTip="{StaticResource Help.Configuration.SyncDomains.AddMissing}"
                                  Command="{Binding Tenants.SyncDomainsAddFromPrefsCommand}"/>
                        <Separator/>
                        <MenuItem Header="Import from App Defaults"
                                  ToolTip="{StaticResource Help.Configuration.SyncDomains.Overwrite}"
                                  Command="{Binding Tenants.SyncDomainsOverwriteFromDefaultsCommand}"/>
                        <MenuItem Header="Add missing from App Defaults"
                                  ToolTip="{StaticResource Help.Configuration.SyncDomains.AddMissing}"
                                  Command="{Binding Tenants.SyncDomainsAddFromDefaultsCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="Apply Changes" Command="{Binding ApplyChangesCommand}"
                    ToolTip="{StaticResource Help.Configuration.ApplyChanges}"
                    Style="{StaticResource AccentButtonStyle}" Padding="10,5"/>
        </StackPanel>

        <wv2:WebView2 Grid.Row="2" x:Name="JsonWebView" Margin="0,4,0,0"
                      SizeChanged="JsonWebView_SizeChanged"/>

        <TextBlock Grid.Row="3" Margin="8,4,8,4"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="12"/>
    </Grid>
</UserControl>
