<UserControl x:Class="Wrapp.Views.RegistryBrowserDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             Width="780" MaxHeight="520">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header + instructions -->
        <StackPanel Grid.Row="0">
            <ctrl:SectionHeader Title="Registry Browser"
                                HelpKey="Help.RegistryBrowser.Overview"
                                Margin="0,0,0,-8"/>
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,10"
                       Text="Navigate the registry tree to select a key or value. Selecting a key checks for its existence; selecting a value compares its data."/>
        </StackPanel>

        <!-- Row 1: Two-panel browser -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Key tree -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Path bar -->
                    <Grid Grid.Row="0" Margin="4,4,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBar"
                                 Grid.Column="0"
                                 ToolTip="{StaticResource Help.RegistryBrowser.PathBar}"
                                 FontFamily="Consolas" FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource InputBgBrush}"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"
                                 KeyDown="PathBar_KeyDown"
                                 Text="HKLM:\"/>
                        <Button Grid.Column="1"
                                Content="Go"
                                FontSize="11"
                                Padding="8,4"
                                Margin="4,0,0,0"
                                Click="GoButton_Click"
                                ToolTip="{StaticResource Help.RegistryBrowser.Navigate}"/>
                    </Grid>

                    <!-- Shortcut buttons + nav feedback -->
                    <DockPanel Grid.Row="1" Margin="4,4,4,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                    Click="Shortcut64_Click"
                                    ToolTip="{StaticResource Help.RegistryBrowser.QuickUninstall64}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="64-bit Uninstall" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button FontSize="10" Padding="6,2"
                                    Click="Shortcut32_Click"
                                    ToolTip="{StaticResource Help.RegistryBrowser.QuickUninstall32}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="32-bit Uninstall" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="NavFeedback"
                                   FontSize="10" FontStyle="Italic"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0,0,0"
                                   Visibility="Collapsed"/>
                    </DockPanel>

                    <!-- Tree + search results (stacked in same grid cell) -->
                    <Grid Grid.Row="2">
                        <!-- Uninstall search bar -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="6,6,4,0"
                                   TextWrapping="Wrap"
                                   Text="Search 64-bit and 32-bit uninstall keys by name or GUID"/>

                        <Grid Grid.Row="1" Margin="4,4,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="0"
                                     ToolTip="{StaticResource Help.RegistryBrowser.Search}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Background="{DynamicResource InputBgBrush}"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     BorderThickness="1"
                                     Padding="6,4"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchBox_KeyDown"
                                     TextChanged="SearchBox_TextChanged">
                                <TextBox.Style>
                                    <!-- BasedOn keeps the app's implicit TextBox theme (caret brush). -->
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Tag" Value="Search uninstall entries..."/>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1"
                                    FontSize="11" Padding="6,4" Margin="4,0,0,0"
                                    Click="SearchButton_Click"
                                    ToolTip="{StaticResource Help.RegistryBrowser.Search}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Search" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    FontSize="11" Padding="6,4" Margin="4,0,0,0"
                                    Click="ClearSearchButton_Click"
                                    ToolTip="{StaticResource Help.RegistryBrowser.ClearSearch}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Search results (shown over tree when active) -->
                        <ListView x:Name="SearchResults" Grid.Row="2"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4"
                                  Visibility="Collapsed"
                                  SelectionChanged="SearchResults_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource CellHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource NavSelectedBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Version}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" - " FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding HasPublisher, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Publisher}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FullPath}" FontSize="10"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Search status messages -->
                        <TextBlock x:Name="SearchStatus" Grid.Row="2"
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                    <TreeView x:Name="KeyTree" Grid.Row="2"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="KeyTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="2,1"/>
                                <EventSetter Event="Expanded"
                                             Handler="TreeViewItem_Expanded"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource NavSelectedBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBgBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Values panel -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Current key path display -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource InputBgBrush}"
                            CornerRadius="4,4,0,0"
                            Padding="8,6">
                        <TextBlock x:Name="CurrentKeyPath"
                                   Text="(select a key)"
                                   FontFamily="Consolas" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Values DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="ValuesGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              PreviewMouseWheel="ValuesGrid_PreviewMouseWheel"
                              SelectionChanged="ValuesGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource CellHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="Auto" MinWidth="140"
                                                Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Type" Width="80"
                                                Binding="{Binding Type}"/>
                            <!-- Width="Auto" lets the column grow past the panel,
                                 which is what allows the DataGrid's horizontal
                                 scrollbar (HorizontalScrollBarVisibility="Auto"
                                 above) to actually appear for long values. -->
                            <DataGridTextColumn Header="Data" Width="Auto" MinWidth="200"
                                                Binding="{Binding Data}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state when no key is selected -->
                    <TextBlock x:Name="ValuesPlaceholder" Grid.Row="1"
                               Text="Select a key to view its values"
                               FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Access denied message -->
                    <TextBlock x:Name="AccessDeniedText" Grid.Row="1"
                               Text="Access denied -- cannot read this key"
                               FontSize="12" FontStyle="Italic"
                               Foreground="#E05C5C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Selection summary -->
        <Border Grid.Row="2"
                Background="{DynamicResource InputBgBrush}"
                CornerRadius="4" Padding="8,6"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Selection: "
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="SelectionSummary"
                           Text="(none)"
                           FontFamily="Consolas" FontSize="11.5"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
