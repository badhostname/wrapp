<UserControl x:Class="Wrapp.Views.NestedGroupBrowserDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Wrapp.Models"
             xmlns:helpers="clr-namespace:Wrapp.Helpers"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             Width="750" Height="500">

    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <ctrl:SectionHeader x:Name="HeaderSection"
                                HelpKey="Help.NestedGroupBrowser.Overview"
                                Margin="0,0,0,-10"/>
            <TextBlock x:Name="StatsText" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Split panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Tree -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,0,6,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  helpers:SmoothScroll.Enabled="True">
                        <TreeView x:Name="GroupTree"
                                  Background="Transparent" BorderThickness="0" Padding="4"
                                  ToolTip="{StaticResource Help.NestedGroupBrowser.Tree}"
                                  SelectedItemChanged="GroupTree_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="2,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:NestedGroupNode}"
                                                          ItemsSource="{Binding Children}">
                                    <Border CornerRadius="4" Padding="4,2" Margin="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="SquaresNested20" FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBgBrush}"
                                                           Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" [Circular]" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#E05C5C" VerticalAlignment="Center"
                                                       ToolTip="{StaticResource Help.NestedGroupBrowser.Circular}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCircular}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <TextBlock Text="No nested groups found."
                               FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               x:Name="EmptyText" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"/>

            <!-- Right: Detail -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource InputBgBrush}"
                            CornerRadius="4,4,0,0" Padding="8,6">
                        <TextBlock x:Name="DetailHeader" Text="(select a group)"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Detail content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8"
                                  helpers:SmoothScroll.Enabled="True">
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <TextBlock Text="Group Name" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailName" Style="{StaticResource DetailValue}" FontWeight="SemiBold"/>

                            <TextBlock Text="Group ID" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailId" Style="{StaticResource DetailValue}"
                                     FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Text="Type" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailType" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Description" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailDescription" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Mail" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailMail" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Visibility" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailVisibility" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Security Enabled" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailSecurity" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Created" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailCreated" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Nested Child Groups" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailChildCount" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Total Members" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="DetailMemberCount" Style="{StaticResource DetailValue}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Placeholder -->
                    <TextBlock Grid.Row="1" x:Name="DetailPlaceholder"
                               Text="Select a group to view details"
                               FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
