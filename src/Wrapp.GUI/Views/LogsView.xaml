<UserControl x:Class="Wrapp.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:services="clr-namespace:Wrapp.Services"
             xmlns:helpers="clr-namespace:Wrapp.Helpers">

    <UserControl.Resources>
        <Style x:Key="ErrorLine"   TargetType="TextBlock"><Setter Property="Foreground" Value="#F48771"/></Style>
        <Style x:Key="WarnLine"    TargetType="TextBlock"><Setter Property="Foreground" Value="#CCA700"/></Style>
        <Style x:Key="InfoLine"    TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title + info help. Matches RunView / SettingsView. -->
        <ctrl:ViewHeader Grid.Row="0"
                         Title="Application Log"
                         HelpKey="Help.Logs.Overview">
            <ctrl:ViewHeader.RightContent>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Clear" Command="{Binding ClearCommand}"
                            ToolTip="{StaticResource Help.Logs.Clear}"
                            Padding="12,4" Margin="0,0,8,0"/>
                    <Grid MinWidth="200" MaxWidth="300" Margin="0,0,12,0">
                        <ui:TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search logs..."
                                    FontSize="12" Padding="6,4"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ClearFilterCommand}"
                                Padding="4,2" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0"
                                Visibility="{Binding FilterText.Length, Converter={StaticResource IntToVis}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>
                    <Button Command="{Binding OpenLogFolderCommand}"
                            ToolTip="{StaticResource Help.Common.OpenLogFolder}"
                            Padding="4,2" Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <TextBlock Text="{Binding LogFilePath}" VerticalAlignment="Center" FontSize="11"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </ctrl:ViewHeader.RightContent>
        </ctrl:ViewHeader>

        <!-- Log list - auto-scrolls to newest entry -->
        <ListBox Grid.Row="1"
                 x:Name="LogList"
                 ItemsSource="{Binding FilteredEntries}"
                 Background="{DynamicResource LogBgBrush}"
                 BorderThickness="0"
                 FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.Resources>
                <!-- Same gentle wheel feel as the Inventory details pane.
                     BasedOn keeps the themed scrollbars (implicit styles
                     without it strip the Wpf.Ui template). -->
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="helpers:SmoothScroll.Enabled" Value="True"/>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type services:LogEntry}">
                    <TextBlock TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                        <Setter Property="Foreground" Value="#F48771"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                        <Setter Property="Foreground" Value="#CCA700"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="INFO">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss, Mode=OneWay}"
                             Foreground="{DynamicResource TimestampBrush}"/>
                        <Run Text=" ["/>
                        <Run Text="{Binding Level, Mode=OneWay}"/>
                        <Run Text="] "/>
                        <Run Text="{Binding Message, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="16,4,16,6" FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding FilteredEntries.Count, StringFormat={}{0} entries}"/>
    </Grid>
</UserControl>
