<UserControl x:Class="Wrapp.Views.IntuneAssignmentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:helpers="clr-namespace:Wrapp.Helpers"
             Width="720">

    <UserControl.Resources>
        <!-- Disabled hatching for input controls in this dialog -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledHatchBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledHatchBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,8">

        <!-- Add toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnAdd" Padding="12,4" Click="BtnAdd_Click"
                    ToolTip="{StaticResource Help.Intune.Assignments.Add}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Add Assignment" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Template:" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="TemplateComboBox"
                      MinWidth="140" FontSize="12"
                      DisplayMemberPath="Name"
                      ToolTip="{StaticResource Help.Intune.Assignments.TemplateCombo}"
                      SelectionChanged="TemplateComboBox_SelectionChanged"/>
            <Button x:Name="BtnHelp" Click="HelpButton_Click"
                    Background="Transparent" BorderThickness="0"
                    Padding="4,0" Margin="8,0,0,0"
                    Cursor="Hand" VerticalAlignment="Center"
                    ToolTip="{StaticResource Help.Common.Toolbar.ToggleHelp}">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
            </Button>
        </StackPanel>

        <!-- Inline help panel (toggled by info button) -->
        <Border x:Name="HelpPanel" Visibility="Collapsed"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="16,12" Margin="0,0,0,8"
                MaxHeight="250">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          helpers:SmoothScroll.Enabled="True">
                <StackPanel x:Name="HelpContent"/>
            </ScrollViewer>
        </Border>

        <!-- Placeholder when no assignments -->
        <TextBlock x:Name="PlaceholderText"
                   Text="No assignments configured. Click Add Assignment to create one."
                   FontSize="12" FontStyle="Italic"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,8,0,0"/>

        <!-- Assignment sections -->
        <ItemsControl x:Name="AssignmentItems">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="4" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    <Expander IsExpanded="{Binding IsSelected, Mode=TwoWay}"
                              Style="{StaticResource SettingsCardExpander}"
                              Margin="0">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,12,0">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="18" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <!-- Red = blocking errors; amber = warnings (incomplete or
                                         duplicate targeting) — same colors as the nav badges. -->
                                    <Border Background="{DynamicResource BadgeBgBrush}"
                                            CornerRadius="6" MinWidth="12" Height="12"
                                            Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-4,-4,0"
                                            ToolTip="{StaticResource Help.Common.ErrorBadge}"
                                            Visibility="{Binding ErrorCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding ErrorCount}" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource BadgeFgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{DynamicResource WarnBadgeBgBrush}"
                                            CornerRadius="6" MinWidth="12" Height="12"
                                            Padding="2,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="-4,-4,0,0"
                                            ToolTip="{StaticResource Help.Common.WarningBadge}"
                                            Visibility="{Binding WarningCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding WarningCount}" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarnBadgeFgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{Binding DisplayName}"
                                                ToolTip="{StaticResource Help.Intune.Assignments.Label}"
                                                FontSize="13" FontWeight="SemiBold"
                                                Padding="4,2" MinWidth="180"
                                                BorderThickness="0"
                                                Background="Transparent"/>
                                    <TextBlock Text="{Binding DisplaySubtitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="4,2,0,0"/>
                                    <TextBlock Text="Duplicate target — this group is already targeted by another enabled assignment in this bundle."
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Margin="4,2,0,0"
                                               Visibility="{Binding HasDuplicateTarget, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Tag="{Binding}"
                                        Click="BtnSaveTemplate_Click"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="{StaticResource Help.Intune.Assignments.SaveTemplate}"
                                        Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Grid.Column="3"
                                        Tag="{Binding}"
                                        Click="BtnDuplicateItem_Click"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="{StaticResource Help.Intune.Assignments.Duplicate}"
                                        Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Grid.Column="4"
                                        Tag="{Binding}"
                                        Click="BtnRemoveItem_Click"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="{StaticResource Help.Intune.Assignments.Remove}"
                                        Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Expander.Header>

                        <!-- Assignment fields -->
                        <StackPanel Margin="0,8,0,0">

                            <!-- Core fields -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"
                                               ToolTip="{StaticResource Help.Intune.Assignments.Type}"/>
                                    <ComboBox SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              ItemsSource="{Binding DataContext.ValidAssignmentTypes,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Intent" Style="{StaticResource FieldLabel}"
                                               ToolTip="{StaticResource Help.Intune.Assignments.Intent}"/>
                                    <ComboBox SelectedItem="{Binding Intent, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              ItemsSource="{Binding DataContext.ValidAssignmentIntents,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <ctrl:FieldLabelRow Text="Group ID / Name"
                                                    IsFieldEnabled="{Binding FieldStates[GroupID].IsEnabled}"
                                                    IsMissing="{Binding IsGroupIdMissing}"
                                                    Help="{StaticResource Help.Intune.Assignments.GroupID}"/>
                                <TextBox Text="{Binding GroupID, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding FieldStates[GroupID].IsEnabled}"
                                         ToolTip="{Binding FieldStates[GroupID].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.GroupID}}"
                                         ToolTipService.ShowOnDisabled="True"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ctrl:FieldLabelRow Text="Group Mode"
                                                        IsFieldEnabled="{Binding FieldStates[GroupMode].IsEnabled}"
                                                        IsMissing="{Binding IsGroupModeMissing}"
                                                        Help="{StaticResource Help.Intune.Assignments.GroupMode}"/>
                                    <ComboBox SelectedItem="{Binding GroupMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              ItemsSource="{Binding DataContext.ValidGroupModes,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              IsEnabled="{Binding FieldStates[GroupMode].IsEnabled}"
                                              ToolTip="{Binding FieldStates[GroupMode].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.GroupMode}}"
                                              ToolTipService.ShowOnDisabled="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ctrl:FieldLabelRow Text="Notification"
                                                        IsFieldEnabled="{Binding FieldStates[Notification].IsEnabled}"
                                                        Help="{StaticResource Help.Intune.Assignments.Notification}"/>
                                    <ComboBox SelectedItem="{Binding Notification, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              ItemsSource="{Binding DataContext.ValidIntuneNotifications,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              IsEnabled="{Binding FieldStates[Notification].IsEnabled}"
                                              ToolTip="{Binding FieldStates[Notification].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.Notification}}"
                                              ToolTipService.ShowOnDisabled="True"/>
                                </StackPanel>
                            </Grid>

                            <!-- Scheduling & Restart (nested expander) -->
                            <Expander Header="Scheduling and Restart" IsExpanded="True"
                                      Style="{StaticResource FormCardExpander}">
                                <StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ctrl:FieldLabelRow Text="Available Time"
                                                                IsFieldEnabled="{Binding FieldStates[AvailableTime].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.AvailableTime}"/>
                                            <ctrl:DateTimePickerField
                                                Text="{Binding AvailableTime, UpdateSourceTrigger=PropertyChanged}"
                                                AsapValue="0001-01-01T00:00:00.000Z"
                                                IsEnabled="{Binding FieldStates[AvailableTime].IsEnabled}"
                                                ToolTip="{Binding FieldStates[AvailableTime].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.AvailableTime}}"
                                                ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <ctrl:FieldLabelRow Text="Deadline Time"
                                                                IsFieldEnabled="{Binding FieldStates[DeadlineTime].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.DeadlineTime}"/>
                                            <ctrl:DateTimePickerField
                                                Text="{Binding DeadlineTime, UpdateSourceTrigger=PropertyChanged}"
                                                AsapValue="0001-01-01T00:00:00.000Z"
                                                IsEnabled="{Binding FieldStates[DeadlineTime].IsEnabled}"
                                                ToolTip="{Binding FieldStates[DeadlineTime].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.DeadlineTime}}"
                                                ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ctrl:FieldLabelRow Text="Use Local Time"
                                                                IsFieldEnabled="{Binding FieldStates[UseLocalTime].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.UseLocalTime}"/>
                                            <ComboBox SelectedValue="{Binding UseLocalTime, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag"
                                                      IsEnabled="{Binding FieldStates[UseLocalTime].IsEnabled}"
                                                      ToolTip="{Binding FieldStates[UseLocalTime].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.UseLocalTime}}"
                                                      ToolTipService.ShowOnDisabled="True">
                                                <ComboBoxItem Tag="True" Content="Device time zone"/>
                                                <ComboBoxItem Tag="False" Content="UTC"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <ctrl:FieldLabelRow Text="Auto Update Superseded Apps"
                                                                IsFieldEnabled="{Binding FieldStates[AutoUpdateSupersededApps].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.AutoUpdateSuperseded}"/>
                                            <TextBox Text="{Binding AutoUpdateSupersededApps, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding FieldStates[AutoUpdateSupersededApps].IsEnabled}"
                                                     ToolTip="{Binding FieldStates[AutoUpdateSupersededApps].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.AutoUpdateSuperseded}}"
                                                     ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ctrl:FieldLabelRow Text="Delivery Optimization Priority"
                                                                IsFieldEnabled="{Binding FieldStates[DeliveryOptimizationPriority].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.DeliveryOptimization}"/>
                                            <ComboBox SelectedItem="{Binding DeliveryOptimizationPriority, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.ValidDeliveryOptimizationPriorities,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      IsEnabled="{Binding FieldStates[DeliveryOptimizationPriority].IsEnabled}"
                                                      ToolTip="{Binding FieldStates[DeliveryOptimizationPriority].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.DeliveryOptimization}}"
                                                      ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <ctrl:FieldLabelRow Text="Enable Restart Grace Period"
                                                                IsFieldEnabled="{Binding FieldStates[EnableRestartGracePeriod].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.EnableRestartGrace}"/>
                                            <CheckBox IsChecked="{Binding EnableRestartGracePeriod, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Enable"
                                                      IsEnabled="{Binding FieldStates[EnableRestartGracePeriod].IsEnabled}"
                                                      Checked="EnableRestartGrace_Checked"
                                                      ToolTip="{Binding FieldStates[EnableRestartGracePeriod].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.EnableRestartGrace}}"
                                                      ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ctrl:FieldLabelRow Text="Grace Period (mins)"
                                                                IsFieldEnabled="{Binding FieldStates[RestartGracePeriodInMinutes].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.RestartGrace}"/>
                                            <TextBox Text="{Binding RestartGracePeriodInMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding FieldStates[RestartGracePeriodInMinutes].IsEnabled}"
                                                     ToolTip="{Binding FieldStates[RestartGracePeriodInMinutes].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.RestartGrace}}"
                                                     ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <ctrl:FieldLabelRow Text="Countdown Display (mins)"
                                                                IsFieldEnabled="{Binding FieldStates[RestartCountDownDisplayInMinutes].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.CountdownDisplay}"/>
                                            <TextBox Text="{Binding RestartCountDownDisplayInMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding FieldStates[RestartCountDownDisplayInMinutes].IsEnabled}"
                                                     ToolTip="{Binding FieldStates[RestartCountDownDisplayInMinutes].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.CountdownDisplay}}"
                                                     ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <ctrl:FieldLabelRow Text="Snooze (mins)"
                                                                IsFieldEnabled="{Binding FieldStates[RestartNotificationSnoozeInMinutes].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.Snooze}"/>
                                            <TextBox Text="{Binding RestartNotificationSnoozeInMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding FieldStates[RestartNotificationSnoozeInMinutes].IsEnabled}"
                                                     ToolTip="{Binding FieldStates[RestartNotificationSnoozeInMinutes].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.Snooze}}"
                                                     ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ctrl:FieldLabelRow Text="Filter Name"
                                                                IsFieldEnabled="{Binding FieldStates[FilterName].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.FilterName}"/>
                                            <TextBox Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding FieldStates[FilterName].IsEnabled}"
                                                     ToolTip="{Binding FieldStates[FilterName].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.FilterName}}"
                                                     ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <ctrl:FieldLabelRow Text="Filter Mode"
                                                                IsFieldEnabled="{Binding FieldStates[FilterMode].IsEnabled}"
                                                                Help="{StaticResource Help.Intune.Assignments.FilterMode}"/>
                                            <ComboBox SelectedItem="{Binding FilterMode, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.ValidFilterModes,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      IsEnabled="{Binding FieldStates[FilterMode].IsEnabled}"
                                                      ToolTip="{Binding FieldStates[FilterMode].DisabledReason, TargetNullValue={StaticResource Help.Intune.Assignments.FilterMode}}"
                                                      ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </Expander>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
