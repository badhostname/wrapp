<UserControl x:Class="Wrapp.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:helpers="clr-namespace:Wrapp.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Inherit Wpf.Ui RadioButton theme but tighten spacing -->
        <Style x:Key="CompactRadio" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Vertically center text in DataGridTextColumn cells -->
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctrl:ViewHeader Grid.Row="0"
                         Title="Run"
                         HelpKey="Help.Run.Overview">
            <ctrl:ViewHeader.RightContent>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding OpenAppLogFolderCommand}"
                            ToolTip="{StaticResource Help.Common.OpenLogFolder}"
                            Padding="4,2" Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" Cursor="Hand">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <TextBlock Text="{Binding AppLogFolderPath}"
                               VerticalAlignment="Center" FontSize="11"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AppLogFolderPath}"/>
                </StackPanel>
            </ctrl:ViewHeader.RightContent>
        </ctrl:ViewHeader>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Row 0: Controls panel (compact single-row layout) -->
        <Border Grid.Row="0" Margin="12,10,12,6" Padding="10,8"
                BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Target (disabled during run) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding CanStart}">
                    <TextBlock Text="Target:" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontWeight="SemiBold" FontSize="12"/>
                    <RadioButton Content="Intune" GroupName="Target"
                                 Style="{StaticResource CompactRadio}"
                                 ToolTip="{StaticResource Help.Run.Target}"
                                 IsChecked="{Binding IsTargetIntune, Mode=TwoWay}"/>
                    <RadioButton Content="SCCM"   GroupName="Target"
                                 Style="{StaticResource CompactRadio}"
                                 ToolTip="{StaticResource Help.Run.Target}"
                                 IsChecked="{Binding IsTargetSCCM, Mode=TwoWay}"/>
                    <RadioButton Content="Both"   GroupName="Target"
                                 Style="{StaticResource CompactRadio}" Margin="0"
                                 ToolTip="{StaticResource Help.Run.Target}"
                                 IsChecked="{Binding IsTargetBoth, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Grid.Column="1" Width="1" Height="20" Margin="16,0"
                           Fill="{DynamicResource AppBorderBrush}" VerticalAlignment="Center"/>

                <!-- Mode (disabled during run) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding CanStart}">
                    <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontWeight="SemiBold" FontSize="12"/>
                    <RadioButton Content="Validate Only" GroupName="Mode"
                                 Style="{StaticResource CompactRadio}"
                                 ToolTip="{StaticResource Help.Run.Mode.ValidateOnly}"
                                 IsChecked="{Binding IsModeValidateOnly, Mode=TwoWay}"/>
                    <RadioButton Content="Package Only"  GroupName="Mode"
                                 Style="{StaticResource CompactRadio}"
                                 ToolTip="{StaticResource Help.Run.Mode.PackageOnly}"
                                 IsChecked="{Binding IsModePackageOnly, Mode=TwoWay}"/>
                    <RadioButton Content="Full Run"      GroupName="Mode"
                                 Style="{StaticResource CompactRadio}" Margin="0"
                                 ToolTip="{StaticResource Help.Run.Mode.FullRun}"
                                 IsChecked="{Binding IsModeFullRun, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start" Command="{Binding StartCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding CanStart}"
                            ToolTip="{StaticResource Help.Run.PlanDialog}"
                            Padding="20,6" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding CanCancel}"
                            ToolTip="{StaticResource Help.Run.Cancel}"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Connection status panel -->
        <Border Grid.Row="1" Margin="12,0,12,6" Padding="12,8"
                BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="Transparent">
            <StackPanel>

                <ctrl:SectionHeader Title="Targets"
                                    HelpKey="Help.Run.Targets"
                                    Margin="0,0,0,-4"/>

                <!-- Intune tenant connections (one row per configured tenant) -->
                <ItemsControl ItemsSource="{Binding IntuneConnections}"
                              Visibility="{Binding IsIntuneConnectionVisible,
                                           Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- ALIGNMENT: each side's whole block (icon + labels, as
                                     if carded) centers on the row axis, and the checkbox
                                     and connection line share that same axis — explicit
                                     Center everywhere, because the old default (stretch,
                                     content top) let blocks of different label depths
                                     drift apart. -->

                                <!-- Enable/disable toggle for this tenant (disabled during run) -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsEnabled}"
                                          IsEnabled="{Binding DataContext.CanStart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          VerticalAlignment="Center" Margin="0,0,4,0"
                                          ToolTip="{StaticResource Help.Run.EnableTenant}"/>

                                <!-- This PC icon -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Width="60">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="This PC" FontSize="9"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Connection line + status label, centered on the row axis -->
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                    <!-- The line -->
                                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill"
                                          StrokeThickness="3"
                                          Stroke="{Binding State,
                                                   Converter={StaticResource ConnectionStateToBrush}}"
                                          VerticalAlignment="Center">
                                        <Line.Style>
                                            <Style TargetType="Line">
                                                <Setter Property="StrokeDashArray" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}"
                                                                 Value="Disconnected">
                                                        <Setter Property="StrokeDashArray" Value="4 2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}"
                                                                 Value="Unknown">
                                                        <Setter Property="StrokeDashArray" Value="2 2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}"
                                                                 Value="Error">
                                                        <Setter Property="StrokeDashArray" Value="4 2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}"
                                                                 Value="Skipped">
                                                        <Setter Property="StrokeDashArray" Value="2 4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Line.Style>
                                    </Line>

                                    <!-- Status label centered on line -->
                                    <Border Background="{DynamicResource CardBgBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Padding="8,2" CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="{Binding State,
                                                                    Converter={StaticResource ConnectionStateToBrush}}"/>
                                            <TextBlock Text="{Binding TokenCountdown}"
                                                       FontSize="9" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TokenCountdown}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Cloud icon + tenant name + UPN (clickable to sign in when disconnected) -->
                                <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                        Padding="0" Cursor="Hand" VerticalAlignment="Center"
                                        Tag="{Binding TenantId}"
                                        Click="TenantSignIn_Click"
                                        ToolTip="{StaticResource Help.Run.ClickToSignIn}">
                                    <StackPanel HorizontalAlignment="Center" Width="160">
                                        <ui:SymbolIcon Symbol="Cloud24" FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TargetName}" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TargetName}"
                                                   ToolTipService.ShowOnDisabled="True"/>
                                        <TextBlock Text="{Binding DetailLine1}"
                                                   FontSize="9" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DetailLine1}"
                                                   ToolTipService.ShowOnDisabled="True"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SCCM site connections (one row per configured site) -->
                <ItemsControl ItemsSource="{Binding SccmConnections}"
                              Visibility="{Binding IsSccmConnectionVisible,
                                           Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Same block-center alignment as the Intune rows above. -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsEnabled}"
                                          IsEnabled="{Binding DataContext.CanStart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          VerticalAlignment="Center" Margin="0,0,4,0"
                                          ToolTip="{StaticResource Help.Run.EnableSite}"/>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Width="60">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="This PC" FontSize="9"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill"
                                          StrokeThickness="3"
                                          Stroke="{Binding State,
                                                   Converter={StaticResource ConnectionStateToBrush}}"
                                          VerticalAlignment="Center">
                                        <Line.Style>
                                            <Style TargetType="Line">
                                                <Setter Property="StrokeDashArray" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Disconnected">
                                                        <Setter Property="StrokeDashArray" Value="4 2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Unknown">
                                                        <Setter Property="StrokeDashArray" Value="2 2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                                        <Setter Property="StrokeDashArray" Value="4 2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                        <Setter Property="StrokeDashArray" Value="2 4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Line.Style>
                                    </Line>
                                    <Border Background="{DynamicResource CardBgBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Padding="8,2" CornerRadius="4">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{Binding State,
                                                                Converter={StaticResource ConnectionStateToBrush}}"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Width="160">
                                    <ui:SymbolIcon Symbol="Server24" FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding TargetName}" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TargetName}"/>
                                    <TextBlock Text="{Binding DetailLine1}"
                                               FontSize="9" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DetailLine1}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

        <!-- Row 2: Package progress table -->
        <Border Grid.Row="2" Margin="12,0,12,6" MaxHeight="240"
                Visibility="{Binding PackageProgressItems.Count,
                             Converter={StaticResource IntToVis}}">
            <DockPanel>
            <ctrl:SectionHeader DockPanel.Dock="Top"
                                Title="Package Progress"
                                HelpKey="Help.Run.Progress"
                                Margin="0,0,0,-6"/>
            <DataGrid ItemsSource="{Binding PackageProgressItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource AppBorderBrush}"
                      Background="{DynamicResource CardBgBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowHeight="32">

                <DataGrid.Columns>
                    <!-- Package name -->
                    <DataGridTextColumn Header="Package" Width="*"
                                        Binding="{Binding PackageName}"
                                        FontWeight="SemiBold"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <!-- Target badge -->
                    <DataGridTextColumn Header="Target" Width="Auto" MinWidth="60"
                                        Binding="{Binding Target}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <!-- Progress bar with overlaid step name -->
                    <DataGridTemplateColumn Header="Progress" Width="*" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="12,2,12,2">
                                    <ProgressBar Height="20" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Foreground="{Binding Outcome,
                                                              Converter={StaticResource OutcomeToBrush}}"
                                                 Background="{DynamicResource InputBgBrush}"/>
                                    <TextBlock FontSize="10" VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding CurrentStepName, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Outcome}"
                                           Foreground="{Binding Outcome,
                                                        Converter={StaticResource OutcomeToBrush}}"
                                           FontWeight="SemiBold" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Failure detail -->
                    <DataGridTextColumn Header="Detail" Width="*"
                                        Binding="{Binding FailureReason}"
                                        Foreground="{DynamicResource ErrorBrush}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>
        </Border>

        <!-- Row 3: Log file path with folder icon -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14,0,14,2"
                    ToolTip="{Binding LogFilePath}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LogFilePath}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Command="{Binding OpenLogFolderCommand}"
                    Background="Transparent" BorderThickness="0"
                    Padding="2" Margin="0,0,4,0" Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip="{StaticResource Help.Common.OpenLogFolder}">
                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
            <TextBlock VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}">
                <Run Text="Log: "/>
                <Run Text="{Binding LogFilePath, Mode=OneWay}"
                     FontFamily="Consolas"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
            </TextBlock>
        </StackPanel>
        <ListBox Grid.Row="4" Margin="12,0,12,0"
                 x:Name="LogListBox"
                 ItemsSource="{Binding LogLines}"
                 Background="{DynamicResource LogBgBrush}"
                 BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 FontFamily="Consolas" FontSize="12">
            <ListBox.Resources>
                <!-- Same gentle wheel feel as the Inventory details pane. -->
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="helpers:SmoothScroll.Enabled" Value="True"/>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Content}"
                               Foreground="{Binding ForegroundBrush}"
                               TextWrapping="NoWrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 5: Progress bar (indeterminate while running) -->
        <ProgressBar Grid.Row="5" Margin="12,4,12,4" Height="4"
                     IsIndeterminate="{Binding IsRunning}"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

        <!-- Row 6: Result summary -->
        <Border Grid.Row="6" Margin="12,4,12,8" Padding="8,6" CornerRadius="4"
                Visibility="{Binding ResultSummary.Length, Converter={StaticResource IntToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource RunSuccessBgBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LastRunSucceeded}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource RunErrorBgBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <ctrl:SectionHeader Title="Results"
                                    HelpKey="Help.Run.Results"
                                    Margin="0,0,0,-8"/>
                <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
