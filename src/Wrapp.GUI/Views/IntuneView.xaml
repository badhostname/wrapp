<UserControl x:Class="Wrapp.Views.IntuneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Wrapp"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:helpers="clr-namespace:Wrapp.Helpers"
             AllowDrop="True"
             DragEnter="UserControl_DragEnter"
             DragOver="UserControl_DragOver"
             DragLeave="UserControl_DragLeave"
             Drop="UserControl_Drop">

    <UserControl.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <!-- Under-label caption for fields END USERS see in the Company
             Portal — over-announce so nothing inappropriate ships. -->
        <Style x:Key="EndUserHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,-2,0,3"/>
            <Setter Property="Text" Value="Visible to end users in Company Portal"/>
            <Setter Property="ToolTip" Value="End users see this value in the Company Portal — make sure it is appropriate for them."/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main content -->
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ctrl:ViewHeader Grid.Row="0"
                             Title="Intune"
                             HelpKey="Help.Intune.Overview"/>

            <!-- Row 1: action toolbar spanning full width -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding AddPackageCommand}"
                                Padding="10,5" Margin="0,0,6,0"
                                ToolTip="{StaticResource Help.Intune.Toolbar.Add}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Add" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemovePackageCommand}"
                                Padding="10,5" Margin="0,0,6,0"
                                IsEnabled="{Binding HasSelectedPackage}"
                                ToolTip="{StaticResource Help.Intune.Toolbar.Remove}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DuplicatePackageCommand}"
                                Padding="10,5"
                                IsEnabled="{Binding HasSelectedPackage}"
                                ToolTip="{StaticResource Help.Intune.Toolbar.Duplicate}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ReplacePlaceholdersCommand}"
                                Padding="10,5" Margin="6,0,0,0"
                                IsEnabled="{Binding HasSelectedPackage}"
                                ToolTip="{StaticResource Help.Common.ReplacePlaceholders}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Replace placeholders" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="6,4"/>
                        <Button Command="{Binding OpenAssignmentsCommand}"
                                Padding="10,5"
                                IsEnabled="{Binding HasSelectedPackage}"
                                ToolTip="{StaticResource Help.Intune.Toolbar.Assignments}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Assignments" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource WarnBadgeBgBrush}"
                                        CornerRadius="7" MinWidth="14" Height="14"
                                        Padding="3,0" VerticalAlignment="Center"
                                        Margin="6,0,0,0"
                                        ToolTip="{StaticResource Help.Common.WarningBadge}"
                                        Visibility="{Binding SelectedPackageAssignmentWarningCount, Converter={StaticResource IntToVis}}">
                                    <TextBlock Text="{Binding SelectedPackageAssignmentWarningCount}" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource WarnBadgeFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{DynamicResource BadgeBgBrush}"
                                        CornerRadius="7" MinWidth="14" Height="14"
                                        Padding="3,0" VerticalAlignment="Center"
                                        Margin="4,0,0,0"
                                        ToolTip="{StaticResource Help.Common.ErrorBadge}"
                                        Visibility="{Binding SelectedPackageAssignmentErrorCount, Converter={StaticResource IntToVis}}">
                                    <TextBlock Text="{Binding SelectedPackageAssignmentErrorCount}" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource BadgeFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="6,4"/>
                        <TextBlock Text="Template:" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                   ToolTip="{StaticResource Help.Intune.Toolbar.Template}"/>
                        <ComboBox x:Name="PackageTemplateComboBox"
                                  MinWidth="140" FontSize="12"
                                  SelectionChanged="PackageTemplateComboBox_SelectionChanged"
                                  ToolTip="{StaticResource Help.Intune.Toolbar.Template}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Name + amber-free hierarchy badge: templates that carry
                                         saved assignments show a people glyph with the count. -->
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <Border CornerRadius="7" Padding="5,1" Margin="6,0,0,0"
                                                Background="{DynamicResource InputBgBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding ChildBadgeTooltip}"
                                                Visibility="{Binding ChildCount, Converter={StaticResource IntToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ChildCount}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="3,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Cursor="Hand"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   MouseLeftButtonDown="SavePackageTemplate_Click">
                            <TextBlock.ToolTip>
                                <TextBlock x:Name="SaveTemplateTooltip"
                                           Text="{StaticResource Help.Intune.Toolbar.SaveTemplate}" FontFamily="Segoe UI"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Cursor="Hand"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   MouseLeftButtonDown="SavePackageTemplateAs_Click">
                            <TextBlock.ToolTip>
                                <TextBlock Text="{StaticResource Help.Intune.Toolbar.SaveTemplateAs}" FontFamily="Segoe UI"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Collapsible Intune Tenants section -->
            <Expander Grid.Row="2" IsExpanded="False"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="0">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Cloud24" FontSize="16"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="Intune Tenants ("/>
                            <Run Text="{Binding Tenants.IntuneTenants.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="12,4,12,8">

                    <!-- Column headers -->
                    <Grid Margin="0,0,38,4"
                          Visibility="{Binding Tenants.IntuneTenants.Count,
                              Converter={StaticResource IntToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="Tenant ID" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="Auth Flow" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    </Grid>

                    <!-- Tenant rows -->
                    <ItemsControl ItemsSource="{Binding Tenants.IntuneTenants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="8,6"
                                        Background="{DynamicResource InputBgBrush}"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{StaticResource Help.Intune.TenantsPanel.Name}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <ui:TextBox Grid.Column="1"
                                                 Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{StaticResource Help.Intune.TenantsPanel.TenantId}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"
                                                 FontFamily="Consolas" FontSize="11"
                                                 PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                                        <ComboBox Grid.Column="2"
                                                  SelectedItem="{Binding AuthFlow}"
                                                  ItemsSource="{Binding DataContext.Defaults.ValidAuthFlows,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  ToolTip="{StaticResource Help.Intune.TenantsPanel.AuthFlow}"
                                                  VerticalAlignment="Center"
                                                  MinWidth="130"
                                                  Margin="0,0,8,0" FontSize="11"/>
                                        <Button Grid.Column="3"
                                                Width="28" Height="28" Padding="0"
                                                ToolTip="{StaticResource Help.Intune.Tenants.Remove}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.Tenants.ConfirmRemoveIntuneTenantCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="No tenants configured."
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tenants.IntuneTenants.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Add + Restore + Sync buttons -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button HorizontalAlignment="Left" Padding="10,4" Margin="0,0,8,0"
                                    Command="{Binding Tenants.AddIntuneTenantCommand}"
                                    ToolTip="{StaticResource Help.Intune.TenantsPanel.Add}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Add Tenant" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Left" Padding="10,4"
                                    Click="IntuneTenantsSyncButton_Click"
                                    ToolTip="{StaticResource Help.Intune.TenantsPanel.Restore}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Restore..." FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Overwrite with Preferences"
                                                  ToolTip="{StaticResource Help.Intune.TenantsPanel.RestoreOverwrite}"
                                                  Command="{Binding Tenants.SyncIntuneOverwriteFromPrefsCommand}"/>
                                        <MenuItem Header="Add missing from Preferences"
                                                  ToolTip="{StaticResource Help.Intune.TenantsPanel.RestoreAddMissing}"
                                                  Command="{Binding Tenants.SyncIntuneAddFromPrefsCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Overwrite with App Defaults"
                                                  ToolTip="{StaticResource Help.Intune.TenantsPanel.RestoreOverwrite}"
                                                  Command="{Binding Tenants.SyncIntuneOverwriteFromDefaultsCommand}"/>
                                        <MenuItem Header="Add missing from App Defaults"
                                                  ToolTip="{StaticResource Help.Intune.TenantsPanel.RestoreAddMissing}"
                                                  Command="{Binding Tenants.SyncIntuneAddFromDefaultsCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="IntuneTenantsHelpButton"
                                Click="IntuneTenantsHelpButton_Click"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,0" Margin="8,0,4,0"
                                Cursor="Hand" VerticalAlignment="Center"
                                ToolTip="{StaticResource Help.Intune.TenantsPanel.AboutButton}">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Row 3: package list + detail -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="140"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: package list -->
                <ListBox x:Name="PackageList" Grid.Column="0"
                         ItemsSource="{Binding IntunePackager.Packages}"
                         SelectedItem="{Binding SelectedPackage}"
                         BorderThickness="0"
                         Margin="4,8,4,8"
                         Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDuplicateName}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Normal icon: the package box; a small red X badge overlaps
                                         its corner when the package is disabled (the list's disabled
                                         indicator — the name itself stays readable, no strikethrough).
                                         Hidden when duplicate. -->
                                    <Grid Grid.Column="0" Width="20" Margin="0,0,8,0"
                                          Visibility="{Binding HasDuplicateName, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="ToolTip" Value="Disabled — excluded from packaging runs. Re-enable it in the Package State card."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   VerticalAlignment="Center" TextAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <!-- Filled badge: MDL2 is single-weight, so FontWeight can't
                                             thicken the X — a solid red circle with a white X reads
                                             far bolder at this size. -->
                                        <Border CornerRadius="7" Width="13" Height="13"
                                                Background="{DynamicResource ErrorBrush}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,-5,-3"
                                                Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <!-- Warning icon: shown when duplicate -->
                                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               VerticalAlignment="Center" Width="20" TextAlignment="Center"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding HasDuplicateName, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.ToolTip>
                                            <TextBlock FontFamily="Segoe UI" Text="{StaticResource Help.Common.PackageList.DuplicateName}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <!-- Badges pinned to the row's far right (warn left of
                                         error) — same inline alignment and size as the nav
                                         rail and the Assignments-button badges. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                        <Border Background="{DynamicResource WarnBadgeBgBrush}"
                                                CornerRadius="7" MinWidth="14" Height="14"
                                                Padding="3,0" VerticalAlignment="Center" Margin="4,0,0,0"
                                                ToolTip="{StaticResource Help.Common.WarningBadge}"
                                                Visibility="{Binding WarningCount, Converter={StaticResource IntToVis}}">
                                            <TextBlock Text="{Binding WarningCount}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarnBadgeFgBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="{DynamicResource BadgeBgBrush}"
                                                CornerRadius="7" MinWidth="14" Height="14"
                                                Padding="3,0" VerticalAlignment="Center" Margin="4,0,0,0"
                                                ToolTip="{StaticResource Help.Common.ErrorBadge}"
                                                Visibility="{Binding ErrorCount, Converter={StaticResource IntToVis}}">
                                            <TextBlock Text="{Binding ErrorCount}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource BadgeFgBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- Enabled/disabled is set in the detail pane (Package State
                                         card); the list shows it via the slashed-circle icon. The
                                         name only dims — it stays legible. -->
                                    <TextBlock Grid.Column="1" Text="{Binding AppName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove"
                                      ToolTip="{StaticResource Help.Intune.Toolbar.Remove}"
                                      Command="{Binding PlacementTarget.Tag.RemovePackageCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Duplicate"
                                      ToolTip="{StaticResource Help.Intune.Toolbar.Duplicate}"
                                      Command="{Binding PlacementTarget.Tag.DuplicatePackageCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Assignments"
                                      ToolTip="{StaticResource Help.Intune.Toolbar.Assignments}"
                                      Command="{Binding PlacementTarget.Tag.OpenAssignmentsCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- Splitter line -->
                <Rectangle Grid.Column="1" Fill="{DynamicResource AppBorderBrush}"/>

            <!-- Right: placeholder or detail panel -->
            <Grid Grid.Column="2">

                <!-- Placeholder shown when nothing is selected -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedPackage}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="BoxMultiple20" FontSize="48"
                                   Foreground="{DynamicResource EmptyStateFgBrush}" HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                    <TextBlock Text="No package selected"
                               FontSize="16" Foreground="{DynamicResource EmptyStateTextBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Click + Add to create a new Intune package"
                               FontSize="12" Foreground="{DynamicResource EmptyStateTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Detail panel shown when a package is selected -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,16"
                              helpers:SmoothScroll.Enabled="True">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedPackage}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="860" DataContext="{Binding SelectedPackage}">

                        <!-- ================================================ -->
                        <!-- CARD: PACKAGE STATE                              -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Package state" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <!-- Writes are GESTURE-ONLY (UpdateSourceTrigger=Explicit + the
                                     Checked handler): during a selection change the radio group's
                                     mutual-uncheck fires between binding re-resolutions and, with
                                     an implicit TwoWay push, writes through a stale binding chain
                                     into the package being navigated AWAY from — which silently
                                     re-enabled a disabled package. Unchecked never updates the
                                     source, and a Checked raised by a transition target-update
                                     writes back the value it just read (a no-op), so only a real
                                     operator toggle can change IsEnabled. Regression-proofed by
                                     PackageStateRadioRegressionTests. -->
                                <RadioButton Content="Enabled" GroupName="IntunePackageState"
                                             IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                             Checked="PackageStateRadio_Checked"
                                             VerticalAlignment="Center" Margin="0,0,16,0"
                                             ToolTip="{StaticResource Help.Common.PackageEnabled}"/>
                                <RadioButton Content="Disabled" GroupName="IntunePackageState"
                                             IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=Explicit,
                                                 Converter={StaticResource InvertBool}}"
                                             Checked="PackageStateRadio_Checked"
                                             VerticalAlignment="Center" Margin="0,0,16,0"
                                             ToolTip="{StaticResource Help.Common.PackageEnabled}"/>
                                <TextBlock Text="Disabled packages are kept in the bundle but skipped by runs."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD: TARGET TENANT                              -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:SectionHeader Title="Target Tenant"
                                                        HelpKey="Help.Intune.TargetTenants"
                                                        Margin="0"/>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource WarningBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               Visibility="{Binding HasNoTenant, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="A tenant must be selected"
                                               FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0"
                                               Visibility="{Binding HasNoTenant, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Text="Select which Intune tenant this package deploys to. Packages with no selection will be skipped."
                                           FontSize="11" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <ComboBox ItemsSource="{Binding DataContext.AvailableTenants,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding TenantId, Mode=TwoWay}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="{StaticResource Help.Intune.TargetTenants}"
                                          Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 1: APPLICATION INFO                          -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Application Info"
                                                    HelpKey="Help.Intune.ApplicationInfo"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="App Name" Style="{StaticResource FieldLabel}"
                                                       ToolTip="{StaticResource Help.Intune.ApplicationInfo.AppName}"/>
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Visibility="{Binding IsAppNameMissing, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="Required" FontSize="11"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Visibility="{Binding IsAppNameMissing, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource ErrorBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Visibility="{Binding HasDuplicateName, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="Duplicate name - package names must be unique."
                                                       FontSize="11" Foreground="{DynamicResource ErrorBrush}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Visibility="{Binding HasDuplicateName, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource EndUserHint}"/>
                                        <Border CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDuplicateName}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.ApplicationInfo.Comment}"/>
                                        <TextBlock Style="{StaticResource EndUserHint}"/>
                                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Icon file + preview -->
                                <StackPanel>
                                    <TextBlock Text="Icon File" Style="{StaticResource FieldLabel}"
                                               ToolTip="{StaticResource Help.Intune.ApplicationInfo.IconFile}"/>
                                    <TextBlock Style="{StaticResource EndUserHint}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40"
                                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Background="{DynamicResource IconBoxBgBrush}">
                                            <Grid>
                                                <!-- Placeholder glyph when no icon -->
                                                <TextBlock Text="&#xE7C3;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="20" Foreground="{DynamicResource EmptyStateFgBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.SelectedPackageIconSource,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Actual icon -->
                                                <Image Source="{Binding DataContext.SelectedPackageIconSource,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Width="32" Height="32" Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.SelectedPackageIconSource,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <!-- Warning badge when icon path is missing -->
                                                <Border Width="16" Height="16"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="0,0,-2,-2" CornerRadius="8"
                                                        Background="#F5B93B"
                                                        ToolTip="{Binding DataContext.IconPathMissingTooltip,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding DataContext.IconPathMissing,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="&#xE783;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Foreground="Black"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ui:TextBox Grid.Column="2"
                                                 Text="{Binding IconFile, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 ToolTip="{StaticResource Help.Intune.ApplicationInfo.IconFile}"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 PlaceholderText="No icon selected"/>
                                        <Button Grid.Column="4"
                                                Padding="12,5"
                                                ToolTip="{StaticResource Help.Intune.ApplicationInfo.IconFile}"
                                                Command="{Binding DataContext.BrowseIconCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Browse..." VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Use App Icon" Padding="8,3"
                                                FontSize="11"
                                                ToolTip="{StaticResource Help.Intune.ApplicationInfo.UseAppIcon}"
                                                Command="{Binding DataContext.UseAppIconCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.HasSelectedPackage,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Content="Apply App Info" Padding="8,3" Margin="8,0,0,0"
                                                FontSize="11"
                                                ToolTip="{StaticResource Help.Intune.AppInfo.SyncMetadata}"
                                                Command="{Binding DataContext.ApplyAppInfoCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.HasSelectedPackage,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 2: INSTALLATION                             -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Installation"
                                                    HelpKey="Help.Intune.Installation"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Package Option" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.Installation.PackageOption}"/>
                                        <TextBox Text="{Binding PackageOption, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{StaticResource Help.Intune.Installation.PackageOption}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Update Mode" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.Installation.UpdateMode}"/>
                                        <ComboBox SelectedItem="{Binding UpdateMode}"
                                                  ItemsSource="{Binding DataContext.Defaults.ValidUpdateModes,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Existing App ID: only visible for Update / UpdateContent -->
                                <StackPanel Margin="0,0,0,12"
                                            Visibility="{Binding FieldStates[ExistingAppID].Visibility}">
                                    <TextBlock Text="Existing App ID" Style="{StaticResource FieldLabel}"
                                               ToolTip="{StaticResource Help.Intune.Installation.ExistingAppID}"/>
                                    <Border Background="{DynamicResource CommandFieldBgBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource CommandFieldAccentBrush}"
                                                    CornerRadius="3,0,0,3"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ExistingAppID, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" BorderThickness="0" Background="Transparent"
                                                     ToolTip="{StaticResource Help.Intune.Installation.ExistingAppID}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Install Command" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.Installation.InstallCommand}"/>
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding IsInstallCommandMissing, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Required" FontSize="11"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding IsInstallCommandMissing, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource CommandFieldBgBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource CommandFieldAccentBrush}"
                                                    CornerRadius="3,0,0,3"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding InstallCommand, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" BorderThickness="0" Background="Transparent"
                                                     ToolTip="{StaticResource Help.Intune.Installation.InstallCommand}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Uninstall Command" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.Installation.UninstallCommand}"/>
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding IsUninstallCommandMissing, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Required" FontSize="11"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding IsUninstallCommandMissing, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource CommandFieldBgBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource CommandFieldAccentBrush}"
                                                    CornerRadius="3,0,0,3"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding UninstallCommand, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" BorderThickness="0" Background="Transparent"
                                                     ToolTip="{StaticResource Help.Intune.Installation.UninstallCommand}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 3: DEPLOYMENT BEHAVIOR                      -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Deployment Behavior"
                                                    HelpKey="Help.Intune.DeploymentBehavior"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Install Experience" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.DeploymentBehavior.InstallExperience}"/>
                                        <ComboBox SelectedItem="{Binding InstallExperience}"
                                                  ItemsSource="{Binding DataContext.Defaults.ValidInstallExperience,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Restart Behavior" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.DeploymentBehavior.RestartBehavior}"/>
                                        <ComboBox SelectedItem="{Binding RestartBehavior}"
                                                  ItemsSource="{Binding DataContext.Defaults.ValidRestartBehavior,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Max Install Time (min)" Style="{StaticResource FieldLabel}"
                                                       ToolTip="{StaticResource Help.Intune.DeploymentBehavior.MaxInstallTime}"/>
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource ErrorBrush}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                       ToolTip="{StaticResource Help.Intune.Installation.MaxInstallTimeRange}"
                                                       Visibility="{Binding IsMaxInstallTimeOutOfRange, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding MaximumInstallationTimeInMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{StaticResource Help.Intune.DeploymentBehavior.MaxInstallTime}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <CheckBox Content="Allow Available Uninstall"
                                                      IsChecked="{Binding AllowAvailableUninstall}"
                                                      ToolTip="{StaticResource Help.Intune.DeploymentBehavior.AllowAvailableUninstall}"
                                                      Margin="0,0,20,0"/>
                                            <CheckBox Content="Featured in Company Portal"
                                                      IsChecked="{Binding CompanyPortalFeaturedApp}"
                                                      ToolTip="{StaticResource Help.Intune.DeploymentBehavior.CompanyPortalFeaturedApp}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Use AzCopy for upload"
                                                      IsChecked="{Binding UseAzCopy}"
                                                      ToolTip="{StaticResource Help.Intune.DeploymentBehavior.UseAzCopy}"
                                                      Margin="0,0,12,0"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding UseAzCopy, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Window Style:" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <ComboBox SelectedItem="{Binding AzCopyWindowStyle}" MinWidth="100"
                                                          ToolTip="{StaticResource Help.Intune.DeploymentBehavior.AzCopyWindowStyle}">
                                                    <ComboBoxItem Content="Hidden"/>
                                                    <ComboBoxItem Content="NoNewWindow"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 4: REQUIREMENTS                             -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Requirements"
                                                    HelpKey="Help.Intune.Requirements"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Architecture" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.Requirements.Architecture}"/>
                                        <ComboBox SelectedItem="{Binding Architecture}"
                                                  ItemsSource="{Binding DataContext.Defaults.ValidArchitecture,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Min Windows Release" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.Requirements.MinOS}"/>
                                        <ComboBox SelectedItem="{Binding MinimumSupportedWindowsRelease}"
                                                  ItemsSource="{Binding DataContext.Defaults.ValidMinOS,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  MaxDropDownHeight="220"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 5: METADATA                                 -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Metadata"
                                                    HelpKey="Help.Intune.Metadata"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Developer" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.ApplicationInfo.Developer}"/>
                                        <TextBox Text="{Binding Developer, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{StaticResource Help.Intune.ApplicationInfo.Developer}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Owner" Style="{StaticResource FieldLabel}"
                                                   ToolTip="{StaticResource Help.Intune.Metadata.Owner}"/>
                                        <TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                                   ToolTip="{StaticResource Help.Intune.Metadata.Notes}"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,-2,0,3"
                                                   Text="Admin-only — never shown to end users"/>
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{StaticResource Help.Intune.Metadata.Notes}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Information URL" Style="{StaticResource FieldLabel}"
                                                       ToolTip="{StaticResource Help.Intune.Metadata.InformationURL}"/>
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                       ToolTip="{StaticResource Help.Common.Validation.HttpUrl}"
                                                       Visibility="{Binding IsInformationURLInvalid, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource EndUserHint}"/>
                                        <ui:TextBox Text="{Binding InformationURL, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="https://..."
                                                 ToolTip="{StaticResource Help.Intune.Metadata.InformationURL}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Privacy URL" Style="{StaticResource FieldLabel}"
                                                       ToolTip="{StaticResource Help.Intune.Metadata.PrivacyURL}"/>
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                       ToolTip="{StaticResource Help.Common.Validation.HttpUrl}"
                                                       Visibility="{Binding IsPrivacyURLInvalid, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource EndUserHint}"/>
                                        <ui:TextBox Text="{Binding PrivacyURL, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="https://..."
                                                 ToolTip="{StaticResource Help.Intune.Metadata.PrivacyURL}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 6: CATEGORIES & SCOPE TAGS                  -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <!-- Categories -->
                                <ctrl:SectionHeader Title="Categories"
                                                    HelpKey="Help.Intune.Categories"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Padding="12,4" Margin="0,0,8,0"
                                            ToolTip="{StaticResource Help.Common.Grid.Add}"
                                            Command="{Binding DataContext.AddCategoryCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,4"
                                            ToolTip="{StaticResource Help.Common.Grid.Remove}"
                                            Command="{Binding DataContext.RemoveSelectedCategoriesCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.CategoriesSelection.HasSelected,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding Categories}" CellStyle="{StaticResource DirectEditCellStyle}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          SelectionMode="Extended" MinHeight="60" MaxHeight="200"
                                          HorizontalAlignment="Stretch">
                                    <DataGrid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridCellEditor}"/>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="*">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Category Name" ToolTip="{StaticResource Help.Intune.Categories.Name}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{StaticResource Help.Intune.Categories.Name}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Scope Tags -->
                                <ctrl:SectionHeader Title="Scope Tags"
                                                    HelpKey="Help.Intune.ScopeTags"
                                                    Margin="0,16,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Padding="12,4" Margin="0,0,8,0"
                                            ToolTip="{StaticResource Help.Common.Grid.Add}"
                                            Command="{Binding DataContext.AddScopeTagCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,4"
                                            ToolTip="{StaticResource Help.Common.Grid.Remove}"
                                            Command="{Binding DataContext.RemoveSelectedScopeTagsCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.ScopeTagsSelection.HasSelected,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding ScopeTags}" CellStyle="{StaticResource DirectEditCellStyle}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          SelectionMode="Extended" MinHeight="60" MaxHeight="200"
                                          HorizontalAlignment="Stretch">
                                    <DataGrid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridCellEditor}"/>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="*">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Scope Tag" ToolTip="{StaticResource Help.Intune.ScopeTags.Name}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{StaticResource Help.Intune.ScopeTags.Name}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 7: CUSTOM RETURN CODES                      -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Custom Return Codes"
                                                    HelpKey="Help.Intune.CustomReturnCodes"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Padding="12,4" Margin="0,0,8,0"
                                            ToolTip="{StaticResource Help.Common.Grid.Add}"
                                            Command="{Binding DataContext.AddReturnCodeCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,4"
                                            ToolTip="{StaticResource Help.Common.Grid.Remove}"
                                            Command="{Binding DataContext.RemoveSelectedReturnCodesCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.ReturnCodesSelection.HasSelected,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding CustomReturnCodes}" CellStyle="{StaticResource DirectEditCellStyle}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          SelectionMode="Extended" MinHeight="60" MaxHeight="200"
                                          HorizontalAlignment="Stretch">
                                    <DataGrid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridCellEditor}"/>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="110">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Return Code" ToolTip="{StaticResource Help.Intune.CustomReturnCodes.Code}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding ReturnCode, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{StaticResource Help.Intune.CustomReturnCodes.Code}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Type" Width="*" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              ItemsSource="{Binding DataContext.Defaults.ValidReturnCodeTypes,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              ToolTip="{StaticResource Help.Intune.CustomReturnCodes.Type}"
                                                              BorderThickness="0" Background="Transparent" Padding="2,0"
                                                              VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Built-in codes (0=success, 1707=success, 3010=softReboot, 1641=hardReboot, 1618=retry) are always included."
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 8: DEPENDENCIES                             -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Dependencies"
                                                    HelpKey="Help.Intune.Dependencies"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Padding="12,4" Margin="0,0,8,0"
                                            ToolTip="{StaticResource Help.Common.Grid.Add}"
                                            Command="{Binding DataContext.AddDependencyCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,4" Margin="0,0,8,0"
                                            Click="BrowseIntuneDependency_Click"
                                            ToolTip="{StaticResource Help.Intune.Dependencies.Browse}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,4"
                                            ToolTip="{StaticResource Help.Common.Grid.Remove}"
                                            Command="{Binding DataContext.RemoveSelectedDependenciesCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.DependenciesSelection.HasSelected,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding Dependencies}" CellStyle="{StaticResource DirectEditCellStyle}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          SelectionMode="Extended" MinHeight="60" MaxHeight="200"
                                          HorizontalAlignment="Stretch">
                                    <DataGrid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridCellEditor}"/>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="*">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="App Name" ToolTip="{StaticResource Help.Intune.Dependencies.AppName}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{StaticResource Help.Intune.Dependencies.AppName}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Auto Install" Width="100" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding AutoInstall, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              ToolTip="{StaticResource Help.Intune.Dependencies.AutoInstall}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- CARD 9: SUPERSEDENCE                             -->
                        <!-- ================================================ -->
                        <Border Style="{StaticResource FormCard}" Margin="0,0,0,24">
                            <StackPanel>
                                <ctrl:SectionHeader Title="Supersedence"
                                                    HelpKey="Help.Intune.Supersedence"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Padding="12,4" Margin="0,0,8,0"
                                            ToolTip="{StaticResource Help.Common.Grid.Add}"
                                            Command="{Binding DataContext.AddSupersedenceCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,4" Margin="0,0,8,0"
                                            Click="BrowseIntuneSupersedence_Click"
                                            ToolTip="{StaticResource Help.Intune.Supersedence.Browse}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,4"
                                            ToolTip="{StaticResource Help.Common.Grid.Remove}"
                                            Command="{Binding DataContext.RemoveSelectedSupersedenceCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.SupersedenceSelection.HasSelected,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding Supersedence}" CellStyle="{StaticResource DirectEditCellStyle}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          SelectionMode="Extended" MinHeight="60" MaxHeight="200"
                                          HorizontalAlignment="Stretch">
                                    <DataGrid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridCellEditor}"/>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="*">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="App Name" ToolTip="{StaticResource Help.Intune.Supersedence.AppName}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{StaticResource Help.Intune.Supersedence.AppName}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Type" Width="140" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedItem="{Binding SupersedenceType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              ItemsSource="{Binding DataContext.Defaults.ValidSupersedenceTypes,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              ToolTip="{StaticResource Help.Intune.Supersedence.Type}"
                                                              BorderThickness="0" Background="Transparent" Padding="2,0"
                                                              VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Grid>
        </Grid>

        <!-- DRAG OVERLAY: image drop feedback -->
        <Grid x:Name="DragOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="10">
            <Grid.Background>
                <SolidColorBrush Color="#000000" Opacity="0.65"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock x:Name="DragValidIcon"
                           Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                           FontSize="72" Foreground="#6FD46F"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DragInvalidIcon"
                           Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                           FontSize="72" Foreground="#E05C5C"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="DragOverlayHint"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DragOverlaySubHint"
                           FontSize="12"
                           Foreground="#AAAAAA"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
