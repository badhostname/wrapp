<UserControl x:Class="Wrapp.Views.GitHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:helpers="clr-namespace:Wrapp.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- View header: title + info help + Refresh button on the right. -->
        <ctrl:ViewHeader Grid.Row="0"
                         Title="Git History"
                         HelpKey="Help.GitHistory.Overview">
            <ctrl:ViewHeader.RightContent>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        ToolTip="{StaticResource Help.GitHistory.Refresh}"
                        Padding="12,5"/>
            </ctrl:ViewHeader.RightContent>
        </ctrl:ViewHeader>

        <!-- Commit timeline -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Commits}"
                 ToolTip="{StaticResource Help.GitHistory.DoubleClickDiff}"
                 Background="{DynamicResource AppBgBrush}"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.Resources>
                <!-- Same gentle wheel feel as the Logs view. Pixel scroll unit
                     keeps virtualization but makes offsets pixels, which is
                     what SmoothScroll's fixed step needs; BasedOn keeps the
                     themed scrollbars (an implicit style without it strips
                     the Wpf.Ui template). -->
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="helpers:SmoothScroll.Enabled" Value="True"/>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource NavHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource NavSelectedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <EventSetter Event="MouseDoubleClick" Handler="CommitItem_DoubleClick"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Graph gutter -->
                            <ColumnDefinition Width="32"/>
                            <!-- Spacer -->
                            <ColumnDefinition Width="8"/>
                            <!-- Commit info -->
                            <ColumnDefinition Width="*"/>
                            <!-- Stats + time -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Graph gutter: vertical line + dot -->
                        <Grid Grid.Column="0" Grid.RowSpan="3" Width="32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Top half of line (hidden for first commit) -->
                            <Rectangle Grid.Row="0" Width="2"
                                       Fill="{DynamicResource GitGraphLineBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                       Visibility="{Binding IsFirst,
                                           Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <!-- Bottom half of line (hidden for last commit) -->
                            <Rectangle Grid.Row="1" Width="2"
                                       Fill="{DynamicResource GitGraphLineBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                       Visibility="{Binding IsLast,
                                           Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <!-- Dot centered over the split -->
                            <Ellipse Grid.RowSpan="2" Width="10" Height="10"
                                     Fill="{DynamicResource GitGraphDotBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 0: Commit message -->
                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   Text="{Binding Message}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Row 0: Stats + time (right side) -->
                        <StackPanel Grid.Column="3" Grid.Row="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <!-- File change stats -->
                            <TextBlock Text="{Binding StatsDisplay}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#CCA700"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatsDisplay}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Relative time -->
                            <TextBlock Text="{Binding RelativeTime}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Row 1: Hash + Author -->
                        <StackPanel Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Hash}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#569CD6"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Author}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Row 2: Per-file change tags (capped to ~3 rows) -->
                        <StackPanel Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2"
                                    Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding VisibleFileChanges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3"
                                                Padding="5,1,5,1"
                                                Margin="0,0,4,2"
                                                BorderThickness="1"
                                                BorderBrush="{Binding StatusBrush}"
                                                Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding FilePath}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Overflow badge -->
                            <Border CornerRadius="3"
                                    Padding="6,1,6,1"
                                    Margin="0,2,0,0"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource TextSecondaryBrush}"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding HasMoreFileChanges,
                                        Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding OverflowLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status bar -->
        <TextBlock Grid.Row="2" Margin="12,6"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
