<ui:FluentWindow x:Class="Wrapp.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:helpers="clr-namespace:Wrapp.Helpers"
        Title="Commit Changes"
        Height="650" Width="950"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/burrito.ico"
        Background="{DynamicResource AppBgBrush}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Title bar -->
        <ui:TitleBar Grid.Row="0" Title="Commit Changes"/>

        <!-- Row 1: Commit header -->
        <Border Grid.Row="1"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CommitHash}"
                               FontFamily="Consolas" FontSize="12"
                               Foreground="#569CD6"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CommitTime}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding CommitAuthor}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding CommitMessage}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Row 2: Changed files list -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                MaxHeight="140">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          helpers:SmoothScroll.Enabled="True">
                <ItemsControl x:Name="FilesList" ItemsSource="{Binding Files}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="2" Padding="8,4"
                                    Cursor="Hand"
                                    Click="FileButton_Click"
                                    ToolTip="{StaticResource Help.Diff.FileChip}"
                                    Tag="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource NavHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding StatusBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding StatusLabel}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding FilePath}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Row 3: Monaco diff editor -->
        <wv2:WebView2 Grid.Row="3" x:Name="DiffWebView"
                      SizeChanged="DiffWebView_SizeChanged"/>

        <!-- Row 4: Status -->
        <TextBlock Grid.Row="4" Margin="12,4"
                   Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</ui:FluentWindow>
