<UserControl x:Class="Wrapp.Views.ActionPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520">

    <StackPanel Margin="0,0,0,8">

        <!-- Subtitle / context text -->
        <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Action cards (built in code-behind from options list) -->
        <StackPanel x:Name="CardsPanel" Margin="0,0,0,4"/>

        <!-- Optional separator + detail panel below cards -->
        <Border x:Name="DetailSeparator" Height="1"
                Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,12"
                Visibility="Collapsed"/>
        <ContentPresenter x:Name="DetailContent" Visibility="Collapsed"/>

    </StackPanel>
</UserControl>
