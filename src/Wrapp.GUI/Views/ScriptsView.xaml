<UserControl x:Class="Wrapp.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <UserControl.Resources>
        <!-- Browser-style tab button: accent top line on checked, flat otherwise -->
        <Style x:Key="ScriptTabRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource SidebarBgBrush}"
                                BorderThickness="0,2,0,0"
                                BorderBrush="Transparent"
                                Padding="16,8"
                                Margin="0,0,1,0"
                                Cursor="Hand"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="TabText"
                                       Text="{TemplateBinding Content}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource TabIndicatorBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AppBgBrush}"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctrl:ViewHeader Grid.Row="0"
                         Title="Scripts"
                         HelpKey="Help.Scripts.Overview"/>

        <!-- Tab strip -->
        <Border Grid.Row="1"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,2,8,4">
            <DockPanel>
                <!-- Right: template selector + token help icon -->
                <StackPanel x:Name="TemplatePanel" DockPanel.Dock="Right"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Template:" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="TemplateComboBox"
                              MinWidth="140" FontSize="12"
                              Height="26" Padding="6,0"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="Name"
                              ToolTip="{StaticResource Help.Scripts.TemplateCombo}"
                              SelectionChanged="TemplateComboBox_SelectionChanged"/>
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Cursor="Hand"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               MouseLeftButtonDown="SaveTemplateButton_Click">
                        <TextBlock.ToolTip>
                            <TextBlock x:Name="SaveTemplateTooltip"
                                       Text="{StaticResource Help.Scripts.SaveTemplate}" FontFamily="Segoe UI"/>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Cursor="Hand"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               MouseLeftButtonDown="SaveTemplateAsButton_Click">
                        <TextBlock.ToolTip>
                            <TextBlock Text="{StaticResource Help.Scripts.SaveTemplateAs}" FontFamily="Segoe UI"/>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Cursor="Hand"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               MouseLeftButtonDown="TokenHelpButton_Click">
                        <TextBlock.ToolTip>
                            <TextBlock Text="{StaticResource Help.Scripts.TokenReference}" FontFamily="Segoe UI"/>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>

                <!-- Left: history button + tabs -->
                <StackPanel Orientation="Horizontal">
                    <Button Click="HistoryButton_Click"
                            Padding="8,5" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="{StaticResource Help.Common.Toolbar.FileHistory}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="16"/>
                            <TextBlock Text="History" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="RefreshButton_Click"
                            Padding="8,5" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="{StaticResource Help.Common.RefreshEditor}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Editor" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="ReplacePlaceholdersButton_Click"
                            Padding="8,5" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="{StaticResource Help.Common.ReplacePlaceholders}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Replace placeholders" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="0,5,8,5"/>
                    <!-- Appease tabs -->
                    <RadioButton x:Name="TabInstall" Content="InstallScript.ps1"
                                 GroupName="ScriptTabs" IsChecked="True"
                                 Style="{StaticResource ScriptTabRadio}"
                                 ToolTip="{StaticResource Help.Scripts.Tab.Install}"
                                 Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabUninstall" Content="UninstallScript.ps1"
                                 GroupName="ScriptTabs"
                                 Style="{StaticResource ScriptTabRadio}"
                                 ToolTip="{StaticResource Help.Scripts.Tab.Uninstall}"
                                 Checked="OnTabChanged"/>
                    <!-- PSADT tab -->
                    <RadioButton x:Name="TabDeploy" Content="Invoke-AppDeployToolkit.ps1"
                                 GroupName="ScriptTabs" Visibility="Collapsed"
                                 Style="{StaticResource ScriptTabRadio}"
                                 ToolTip="{StaticResource Help.Scripts.Tab.Deploy}"
                                 Checked="OnTabChanged"/>
                    <!-- Shared tab -->
                    <RadioButton x:Name="TabDetect" Content="DetectScript.ps1"
                                 GroupName="ScriptTabs"
                                 Style="{StaticResource ScriptTabRadio}"
                                 ToolTip="{StaticResource Help.Scripts.Tab.Detect}"
                                 Checked="OnTabChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Single shared Monaco editor -->
        <wv2:WebView2 Grid.Row="2" x:Name="SharedEditorWebView" Margin="0,4,0,0"
                      SizeChanged="EditorHost_SizeChanged"/>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Margin="8,4,8,4"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="12"/>
    </Grid>
</UserControl>
