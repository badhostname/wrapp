<ui:FluentWindow x:Class="Wrapp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Wrapp"
        xmlns:conv="clr-namespace:Wrapp.Converters"
        xmlns:helpers="clr-namespace:Wrapp.Helpers"
        Title="Wrapp" Height="820" Width="1240"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/burrito.ico"
        Background="{DynamicResource AppBgBrush}">

    <ui:FluentWindow.Resources>
        <conv:JobContextRendererConverter  x:Key="JobContextRendererConverter"/>
        <conv:JobContextHasDetailConverter x:Key="JobContextHasDetailConverter"/>

        <DataTemplate x:Key="JobCardTemplate">
            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                    BorderThickness="1"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="24">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1565C0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Background" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                            <Setter Property="Background" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="9" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Running"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="Text" Value="Done"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                                <Setter Property="Text" Value="Error"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <ProgressBar Height="3" Margin="0,0,0,6" Maximum="100"
                                         Value="{Binding Progress}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Status}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding ElapsedDisplay}"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Top" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Expanded detail pane: only shown when Context has a type-specific renderer -->
                    <Expander Margin="32,6,0,0"
                              Visibility="{Binding Context, Converter={StaticResource JobContextHasDetailConverter}}"
                              Header="Details"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="11">
                        <ContentControl Content="{Binding Context, Converter={StaticResource JobContextRendererConverter}}"
                                        Margin="0,6,0,0"/>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar with 3-slot layout (Header=left, CenterContent=path, TrailingContent=right) -->
        <ui:TitleBar Grid.Row="0" Title="" Background="{DynamicResource SidebarBgBrush}">

            <!-- LEFT: App icon + command buttons -->
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">

                    <!-- App icon + title (draggable region) -->
                    <Border Background="Transparent"
                            MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Cursor="Arrow">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/burrito.png"
                                   Width="18" Height="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Wrapp"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                        </StackPanel>
                    </Border>

                    <Button ToolTip="{StaticResource Help.Main.Toolbar.NewBundle}"
                            Command="{Binding NewCommand}"
                            Style="{StaticResource ToolbarBtn}" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="New" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button ToolTip="{StaticResource Help.Main.Toolbar.OpenBundle}"
                            Command="{Binding OpenCommand}"
                            Style="{StaticResource ToolbarBtn}" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Open" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button ToolTip="{StaticResource Help.Main.Toolbar.SaveBundle}"
                            Command="{Binding SaveBundleCommand}"
                            Style="{StaticResource ToolbarBtn}" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Save" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="4,5"/>

                    <Button ToolTip="{StaticResource Help.Main.Toolbar.SaveBundleAs}"
                            Command="{Binding SaveBundleAsCommand}"
                            Style="{StaticResource ToolbarBtn}" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Save As" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="4,5"/>

                    <!-- Framework indicator (draggable) -->
                    <Border Background="Transparent"
                            MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown"
                            VerticalAlignment="Center"
                            ToolTip="{StaticResource Help.Main.Toolbar.ScriptFramework}"
                            Cursor="Arrow">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding FrameworkIconUri}"
                                   Width="14" Height="14"
                                   VerticalAlignment="Center"
                                   Margin="4,0,4,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding FrameworkLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>

            <!-- CENTER: Path text (ellipsizes into remaining space) -->
            <ui:TitleBar.CenterContent>
                <TextBlock Text="{Binding StatusBarPath}"
                           FontSize="11" FontFamily="Consolas"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,8,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusBarPath}"
                           IsHitTestVisible="False"
                           MinWidth="0"/>
            </ui:TitleBar.CenterContent>

            <!-- RIGHT: Path actions + account (never competes with chrome buttons) -->
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">

                    <Button Command="{Binding OpenFolderInExplorerCommand}"
                            ToolTip="{StaticResource Help.Main.StatusBar.OpenFolder}"
                            Style="{StaticResource ToolbarBtn}"
                            Padding="4,4" Margin="2,0,0,0">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Button>

                    <Button Command="{Binding CopyPathToClipboardCommand}"
                            ToolTip="{StaticResource Help.Main.StatusBar.CopyPath}"
                            Style="{StaticResource ToolbarBtn}"
                            Padding="4,4" Margin="2,0,0,0">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Button>

                    <TextBlock Text="Copied!"
                               FontSize="11"
                               Foreground="#6FD46F"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               Visibility="{Binding ShowCopiedFeedback, Converter={StaticResource BoolToVis}}"
                               IsHitTestVisible="False"/>

                    <Button x:Name="AccountButton"
                            Command="{Binding AccountVm.TogglePopupCommand}"
                            Style="{StaticResource ToolbarBtn}"
                            Padding="8,4" Margin="4,0,4,0"
                            ToolTip="{Binding AccountVm.UserPrincipalName, TargetNullValue={StaticResource Help.Main.Account.Button}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Initials circle (signed in) -->
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding AccountVm.ShowInitials, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="{Binding AccountVm.Initials}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Tenant name (only when signed in) -->
                            <TextBlock Text="{Binding AccountVm.TenantDisplayName}"
                                       MaxWidth="140" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding AccountVm.ShowInitials, Converter={StaticResource BoolToVis}}"/>
                            <!-- Person icon in circle (not signed in) -->
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource CardBgBrush}"
                                    Visibility="{Binding AccountVm.ShowPersonIcon, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- "Not Signed In" label (when not signed in) -->
                            <TextBlock Text="Not Signed In"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding AccountVm.ShowPersonIcon, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Account flyout popup (anchored to the AccountButton in the title bar) -->
        <Popup x:Name="AccountPopup"
               PlacementTarget="{Binding ElementName=AccountButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="{Binding AccountVm.IsPopupOpen, Mode=TwoWay}">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    MinWidth="280" MaxWidth="340"
                    Margin="8"
                    Effect="{StaticResource PopupShadow}">
                <StackPanel>

                    <!-- Signed-in user info -->
                    <StackPanel Margin="16,14,16,0"
                                Visibility="{Binding AccountVm.IsSignedIn, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left"
                                    Width="40" Height="40" CornerRadius="20"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Top" Margin="0,0,12,0">
                                <TextBlock Text="{Binding AccountVm.Initials}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding AccountVm.DisplayName}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding AccountVm.UserPrincipalName}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0">
                                    <Run Text="Tenant:"/>
                                    <Run Text="{Binding AccountVm.TenantDisplayName, Mode=OneWay}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding AccountVm.AuthFlowDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <!-- Application info -->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="Application:"/>
                                <Run Text="{Binding AccountVm.AppDisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding AccountVm.AppId}"
                                       FontSize="10" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding AccountVm.AppId}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                <Run Text="Expires:"/>
                                <Run Text="{Binding AccountVm.TokenExpiry, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Access Token"
                                    Command="{Binding AccountVm.ShowAccessTokenDetailsCommand}"
                                    Style="{StaticResource ToolbarBtn}"
                                    FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="{StaticResource Help.Main.Account.AccessTokenClaims}"/>
                            <Button Content="Id Token"
                                    Command="{Binding AccountVm.ShowIdTokenDetailsCommand}"
                                    Style="{StaticResource ToolbarBtn}"
                                    FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="{StaticResource Help.Main.Account.IdTokenClaims}"/>
                            <Button Content="Refresh"
                                    Command="{Binding AccountVm.RefreshTokenCommand}"
                                    Style="{StaticResource ToolbarBtn}"
                                    FontSize="11" Padding="6,3"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="{StaticResource Help.Main.Account.ForceRefresh}"/>
                        </StackPanel>

                        <!-- Tenant config match (green) -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding AccountVm.IsTenantInConfig, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="#4CAF50" Margin="0,0,4,0"/>
                            <TextBlock FontSize="11" Foreground="#4CAF50" VerticalAlignment="Center">
                                <Run Text="Configured as"/>
                                <Run Text="{Binding AccountVm.ConfigTenantKey, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Tenant not in config warning (amber) -->
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding AccountVm.IsTenantInConfig, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="#FFA726" Margin="0,0,4,0"/>
                                <TextBlock Text="Tenant not configured"
                                           FontSize="11" Foreground="#FFA726" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="This tenant is not in your configuration. Add it for packaging operations to work."
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="18,2,0,4"/>
                            <Button Content="Add to configuration"
                                    Command="{Binding AccountVm.SuggestTenantToConfigCommand}"
                                    Style="{StaticResource ToolbarBtn}"
                                    FontSize="11" Padding="6,3" Margin="18,0,0,0"
                                    HorizontalAlignment="Left"
                                    ToolTip="{StaticResource Help.Main.Account.AddTenant}"
                                    Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource AppBorderBrush}" Margin="0,8,0,0"/>
                        <Button Content="Sign out"
                                Command="{Binding AccountVm.SignOutCommand}"
                                Style="{StaticResource ToolbarBtn}"
                                HorizontalAlignment="Left"
                                Padding="0,6" Margin="0,2,0,6"
                                ToolTip="{StaticResource Help.Main.Account.SignOut}"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="12"/>
                    </StackPanel>

                    <!-- Not signed in -->
                    <StackPanel Visibility="{Binding AccountVm.IsSignedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Margin="16,14,16,10">
                            <TextBlock Text="Not signed in"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Sign in to authenticate with Microsoft Graph for Intune operations."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <Button Content="Sign in"
                                    Command="{Binding AccountVm.SignInCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTip="{StaticResource Help.Main.Account.SignIn}"
                                    Padding="16,6"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Cached accounts from token cache -->
                        <ItemsControl ItemsSource="{Binding AccountVm.CachedAccounts}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AccountVm.CachedAccounts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding DataContext.AccountVm.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{StaticResource Help.Main.Account.SwitchAccount}"
                                                Style="{StaticResource ToolbarBtn}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="16,8">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left"
                                                        Width="28" Height="28" CornerRadius="14"
                                                        Background="{DynamicResource AppBorderBrush}"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TenantDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Opacity="0.7"/>
                                                    <TextBlock Text="{Binding TokenStatus}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Opacity="0.6"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.AccountVm.ForgetAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{StaticResource Help.Main.Account.ForgetAccount}"
                                                Style="{StaticResource ToolbarBtn}"
                                                Width="28" Height="28" Padding="0"
                                                VerticalAlignment="Center" Margin="0,0,8,0"
                                                Opacity="0.5">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Cached accounts separator + list (only when signed in and have others) -->
                    <StackPanel Visibility="{Binding AccountVm.IsSignedIn, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding AccountVm.CachedAccounts}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AccountVm.CachedAccounts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding DataContext.AccountVm.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{StaticResource Help.Main.Account.SwitchAccount}"
                                                Style="{StaticResource ToolbarBtn}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="16,8">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left"
                                                        Width="28" Height="28" CornerRadius="14"
                                                        Background="{DynamicResource AppBorderBrush}"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TenantDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Opacity="0.7"/>
                                                    <TextBlock Text="{Binding TokenStatus}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Opacity="0.6"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.AccountVm.ForgetAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{StaticResource Help.Main.Account.ForgetAccount}"
                                                Style="{StaticResource ToolbarBtn}"
                                                Width="28" Height="28" Padding="0"
                                                VerticalAlignment="Center" Margin="0,0,8,0"
                                                Opacity="0.5">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="{DynamicResource AppBorderBrush}" Margin="12,2"/>

                        <Button Command="{Binding AccountVm.SignInDifferentAccountCommand}"
                                Style="{StaticResource ToolbarBtn}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                ToolTip="{StaticResource Help.Main.Account.SignInDifferent}"
                                Padding="16,10">
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="28" Height="28"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="&#xE948;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Sign in with a different account"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Azure DevOps Key Vault section -->
                    <Rectangle Height="1" Fill="{DynamicResource AppBorderBrush}" Margin="12,6"/>

                    <TextBlock Text="{Binding AccountVm.DevOpsRepoTitle}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="16,6,16,4"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Not signed in -->
                    <!-- Bottom margin matches the 8px gap above the button
                         (description's bottom margin) so the button is
                         visually centred between description and section
                         separator. -->
                    <StackPanel Margin="16,0,16,8"
                                Visibility="{Binding AccountVm.IsDevOpsSignedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Sign in to Azure DevOps to store and retrieve encryption keys for app cloning."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <Button Content="Sign in"
                                Command="{Binding AccountVm.SignInDevOpsCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTip="{StaticResource Help.Main.Account.DevOpsSignIn}"
                                Padding="16,6"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Signed in: account card (same layout as Intune cached accounts) -->
                    <StackPanel Visibility="{Binding AccountVm.IsDevOpsSignedIn, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="16,2,16,2">
                            <Border DockPanel.Dock="Left"
                                    Width="28" Height="28" CornerRadius="14"
                                    Background="{DynamicResource AppBorderBrush}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding AccountVm.DevOpsInitials}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AccountVm.DevOpsUsername}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AccountVm.DevOpsDetail}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Opacity="0.7"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,6,16,0">
                            <Button Content="Access Token"
                                    Command="{Binding AccountVm.ShowDevOpsTokenDetailsCommand}"
                                    Style="{StaticResource ToolbarBtn}"
                                    FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="{StaticResource Help.Main.Account.AccessTokenClaims}"/>
                            <Button Content="Refresh"
                                    Command="{Binding AccountVm.RefreshDevOpsTokenCommand}"
                                    Style="{StaticResource ToolbarBtn}"
                                    FontSize="11" Padding="6,3"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="{StaticResource Help.Main.Account.ForceRefresh}"/>
                        </StackPanel>
                        <Button Content="Sign out"
                                Command="{Binding AccountVm.SignOutDevOpsCommand}"
                                Style="{StaticResource ToolbarBtn}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                ToolTip="{StaticResource Help.Main.Account.DevOpsSignOut}"
                                Padding="16,6" Margin="0,2,0,0">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE8F8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Sign out of Azure DevOps"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding AccountVm.StatusText}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="16,4,16,10"
                               MaxWidth="300">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountVm.StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </Border>
        </Popup>

        <!-- Sidebar + Content -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="8"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <!-- Row-style sidebar: 24px icon left, label center, badges
                     overlaid at the right (stacked when collapsed). Rows are a
                     fixed height so badge counts never resize a button. 168
                     expanded, 62 collapsed - see NavCollapse_Click. -->
                <ColumnDefinition x:Name="SidebarColumn" Width="168"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Hamburger: collapses the sidebar to icons only -->
                    <Button DockPanel.Dock="Top" x:Name="NavCollapseButton"
                            Click="NavCollapse_Click"
                            ToolTip="{StaticResource Help.Main.Nav.Collapse}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="10,0" Margin="4,6,4,2" Height="38"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            FocusVisualStyle="{x:Null}">
                        <!-- Shares a nav row's box (stretched, same 4px side
                             margins and padding) so the glyph lands on the same
                             left rule when expanded and the same centre line
                             when collapsed. Shrink-wrapping the button instead
                             centred it against the rail rather than against the
                             icons, which reads as off-centre. -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- OpenPane (arrow right) while expanded: it points the
                             way the rail will move. ClosePane while collapsed. -->
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="20" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE8A0;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                            <Setter Property="Text" Value="&#xE89F;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Settings: pinned at bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Separator Background="{DynamicResource AppBorderBrush}" Margin="8,4,8,8" Height="1"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Settings" ToolTip="{StaticResource Help.Main.Nav.Settings}" Click="NavButton_Click">
                            <!-- Badges pin to the FAR RIGHT of the row (star column
                                 absorbs the width) - the same inline alignment as the
                                 Assignments-button and package-row badges, and the icon
                                 stays fully visible in the collapsed rail. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Settings24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource NavLabel}"/>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource NavBadgeStack}">
                                    <Border Style="{StaticResource ErrorCountBadge}" Margin="4,1,0,1" ToolTip="{StaticResource Help.Common.ErrorBadge}" Visibility="{Binding SettingsErrorCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding SettingsErrorCount}" Style="{StaticResource CountBadgeText}" Foreground="{DynamicResource BadgeFgBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <!-- All other nav items in a single scrollable area -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  helpers:SmoothScroll.Enabled="True">
                    <StackPanel>
                        <!-- Package authoring -->
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" Tag="General" ToolTip="{StaticResource Help.Main.Nav.General}" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="General" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavIntune" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Intune" Visibility="{Binding Nav[Intune]}" ToolTip="{StaticResource Help.Main.Nav.Intune}" Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Cloud24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="Intune" Style="{StaticResource NavLabel}"/>
                                <!-- Warn (amber, non-blocking) left of error - same order as
                                     the Assignments button badges. -->
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource NavBadgeStack}">
                                    <Border Style="{StaticResource WarnCountBadge}" Margin="4,1,0,1" ToolTip="{StaticResource Help.Common.WarningBadge}" Visibility="{Binding IntuneWarningCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding IntuneWarningCount}" Style="{StaticResource CountBadgeText}" Foreground="{DynamicResource WarnBadgeFgBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource ErrorCountBadge}" Margin="4,1,0,1" ToolTip="{StaticResource Help.Common.ErrorBadge}" Visibility="{Binding IntuneErrorCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding IntuneErrorCount}" Style="{StaticResource CountBadgeText}" Foreground="{DynamicResource BadgeFgBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavSCCM" Style="{StaticResource NavItem}" GroupName="Nav" Tag="SCCM" Visibility="{Binding Nav[SCCM]}" ToolTip="{StaticResource Help.Main.Nav.SCCM}" Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Server24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="SCCM" Style="{StaticResource NavLabel}"/>
                                <!-- Amber = non-blocking (see the Intune nav item). -->
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource NavBadgeStack}">
                                    <Border Style="{StaticResource WarnCountBadge}" Margin="4,1,0,1" ToolTip="{StaticResource Help.Common.WarningBadge}" Visibility="{Binding SccmWarningCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding SccmWarningCount}" Style="{StaticResource CountBadgeText}" Foreground="{DynamicResource WarnBadgeFgBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource ErrorCountBadge}" Margin="4,1,0,1" ToolTip="{StaticResource Help.Common.ErrorBadge}" Visibility="{Binding SccmErrorCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding SccmErrorCount}" Style="{StaticResource CountBadgeText}" Foreground="{DynamicResource BadgeFgBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavDetection" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Detection" Visibility="{Binding Nav[Detection]}" ToolTip="{StaticResource Help.Main.Nav.Detection}" Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="EyeTracking20" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="Detection" Style="{StaticResource NavLabel}"/>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource NavBadgeStack}">
                                    <Border Style="{StaticResource ErrorCountBadge}" Margin="4,1,0,1" ToolTip="{StaticResource Help.Common.ErrorBadge}" Visibility="{Binding DetectionErrorCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding DetectionErrorCount}" Style="{StaticResource CountBadgeText}" Foreground="{DynamicResource BadgeFgBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavScripts" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Scripts" Visibility="{Binding Nav[Scripts]}" ToolTip="{StaticResource Help.Main.Nav.Scripts}" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CodeText20" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="Scripts" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavConfigJson" Style="{StaticResource NavItem}" GroupName="Nav" Tag="ConfigJson" Visibility="{Binding Nav[ConfigJson]}" ToolTip="{StaticResource Help.Main.Nav.ConfigJson}" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CodeTextEdit20" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="JSON" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Operations -->
                        <RadioButton x:Name="NavRun" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Run" Visibility="{Binding Nav[Run]}" ToolTip="{StaticResource Help.Main.Nav.Run}" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BoxArrowUp24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="Run" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavInventory" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Inventory" Visibility="{Binding Nav[Inventory]}" ToolTip="{StaticResource Help.Main.Nav.Inventory}" Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="AppsList24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="Inventory" Style="{StaticResource NavLabel}"/>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource NavBadgeStack}">
                                    <Border Style="{StaticResource CountBadge}" Background="#1565C0" Margin="4,1,0,1" ToolTip="{StaticResource Help.Inventory.MatchBadge}" Visibility="{Binding InventoryMatchCount, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding InventoryMatchCount}" Style="{StaticResource CountBadgeText}" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Tools" Visibility="{Binding Nav[Tools]}" ToolTip="{StaticResource Help.Main.Nav.Tools}" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="Tools" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" GroupName="Nav" Tag="Logs" Visibility="{Binding Nav[Logs]}" ToolTip="{StaticResource Help.Main.Nav.Logs}" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextBulletListSquareClock20" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="Logs" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavGitHistory" Style="{StaticResource NavItem}" GroupName="Nav" Tag="GitHistory" Visibility="{Binding Nav[GitHistory]}" ToolTip="{StaticResource Help.Main.Nav.GitHistory}" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="History" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content column: section view + save strip -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" x:Name="ContentArea"/>

                <!-- Save strip: separator + contextual Save button bottom-right -->
                <Border Grid.Row="1"
                        Background="{DynamicResource AppBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Transfer progress (visible during file transfer) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Value="{Binding TransferProgress, Mode=OneWay}"
                                         Minimum="0" Maximum="100"
                                         Width="300" Height="10"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding TransferStatusText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right: Save Bundle (shown on all sections except Settings) -->
                        <Button Grid.Column="1"
                                HorizontalAlignment="Right"
                                Command="{Binding SaveBundleWithFeedbackCommand}"
                                IsEnabled="{Binding CanSaveBundle}"
                                Visibility="{Binding IsSettingsSection, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                ToolTip="{StaticResource Help.Main.Toolbar.SaveBundle}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <!-- State 1: Save Changes (has unsaved changes) -->
                                <ui:SymbolIcon Symbol="Save24" FontSize="22" Margin="0,0,8,0"
                                               Visibility="{Binding ShowSaveChanges, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Save Changes" VerticalAlignment="Center" FontSize="14"
                                           Visibility="{Binding ShowSaveChanges, Converter={StaticResource BoolToVis}}"/>
                                <!-- State 2: Saving... (in progress) -->
                                <ui:SymbolIcon Symbol="Save24" FontSize="22" Margin="0,0,8,0"
                                               Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Saving..." VerticalAlignment="Center" FontSize="14"
                                           Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                                <!-- State 3: Up to date (clean, no unsaved changes) -->
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="22" Margin="0,0,8,0"
                                               Visibility="{Binding ShowBundleSaved, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Up to date" VerticalAlignment="Center" FontSize="14"
                                           Visibility="{Binding ShowBundleSaved, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Button>
                        <!-- Right: Save Settings (shown only on Settings section) -->
                        <Button Grid.Column="1"
                                HorizontalAlignment="Right"
                                Command="{Binding SaveSettingsWithFeedbackCommand}"
                                IsEnabled="{Binding SettingsVm.IsDirty}"
                                Visibility="{Binding IsSettingsSection, Converter={StaticResource BoolToVis}}"
                                ToolTip="{StaticResource Help.Settings.SaveSettings}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="22" Margin="0,0,8,0"
                                               Visibility="{Binding ShowSettingsSaved, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="22" Margin="0,0,8,0"
                                               Visibility="{Binding ShowSettingsSaved, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Save Settings" VerticalAlignment="Center" FontSize="14"
                                           Visibility="{Binding ShowSettingsSaved, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <TextBlock Text="Saved" VerticalAlignment="Center" FontSize="14"
                                           Visibility="{Binding ShowSettingsSaved, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                Background="{DynamicResource AppBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MaxWidth="350"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Padding="4,2" Margin="0,0,8,0"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" Cursor="Hand"
                        Click="JobsButton_Click"
                        ToolTip="{StaticResource Help.Main.StatusBar.JobsButton}">
                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>

                <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Text="{Binding JobTracker.SummaryStatus}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding JobTracker.IsShuttingDown}" Value="True">
                                    <Setter Property="Foreground" Value="#E05C5C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Job progress bar (fills remaining space, determinate when possible) -->
                <ProgressBar Grid.Column="2" Height="4" Margin="0,0,12,0"
                             Value="{Binding JobTracker.AggregateProgress, Mode=OneWay}"
                             Maximum="100"
                             Visibility="{Binding JobTracker.HasActiveJobs, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="IsIndeterminate" Value="{Binding JobTracker.HasActiveJobs}"/>
                            <Style.Triggers>
                                <!-- Switch to determinate when any job reports progress -->
                                <DataTrigger Binding="{Binding JobTracker.HasDeterminateProgress}" Value="True">
                                    <Setter Property="IsIndeterminate" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding JobTracker.IsShuttingDown}" Value="True">
                                    <Setter Property="Foreground" Value="#E05C5C"/>
                                    <Setter Property="FlowDirection" Value="RightToLeft"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Border Grid.Column="3" CornerRadius="8" Padding="6,1" Margin="0,0,8,0"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center"
                        ToolTip="{StaticResource Help.Main.StatusBar.JobsCount}"
                        Visibility="{Binding JobTracker.ActiveCount, Converter={StaticResource IntToVis}}">
                    <TextBlock Text="{Binding JobTracker.ActiveCount}" FontSize="10"
                               Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Gate framework: "action needed" indicator (advisory gates).
                     Visible only when a required action is pending (e.g. re-approve
                     the Key Vault URL). Click resolves them in turn. -->
                <Button Grid.Column="4" Padding="8,2" Margin="0,0,12,0"
                        VerticalAlignment="Center" Cursor="Hand" BorderThickness="0"
                        Background="#4A3410"
                        Command="{Binding ResolvePendingActionsCommand}"
                        Visibility="{Binding HasPendingActions, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding PendingActionsTooltip, TargetNullValue={StaticResource Help.Main.ActionNeeded}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#F0A030" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding PendingActionsLabel}" FontSize="11"
                                   Foreground="#F0C878" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="5" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static local:AppInfo.NameAndVersion}"/>

                <Button Grid.Column="6" Padding="4,2" Margin="6,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" Cursor="Hand"
                        Click="AboutButton_Click"
                        ToolTip="{StaticResource Help.Main.StatusBar.AboutButton}">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Fluent ContentDialog host: overlays the entire window -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.RowSpan="3"/>

        <!-- Loading overlay: covers entire window while workspace is being created -->
        <Grid Grid.RowSpan="3"
              Background="{DynamicResource OverlayBgBrush}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding LoadingMessage}"
                       FontFamily="Consolas"
                       FontSize="15"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

    </Grid>
</ui:FluentWindow>
