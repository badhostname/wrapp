<UserControl x:Class="Wrapp.Views.GeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             xmlns:helpers="clr-namespace:Wrapp.Helpers"
             AllowDrop="True"
             DragEnter="UserControl_DragEnter"
             DragOver="UserControl_DragOver"
             DragLeave="UserControl_DragLeave"
             Drop="UserControl_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctrl:ViewHeader Grid.Row="0"
                         Title="General"
                         HelpKey="Help.General.Overview"/>

        <!-- Main scrollable content -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16,20,16"
                      helpers:SmoothScroll.Enabled="True">
            <StackPanel MaxWidth="1100">

                <!-- Top row: the drag-and-drop tip banner and the view-level
                     replace-placeholders action as two SEPARATE elements, so
                     the action is not read as part of the tip. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,8">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">Tip:</Run>
                            <Run> Drag and drop an EXE, MSI, MSP, INTUNEWIN, image, or package folder onto this view.</Run>
                        </TextBlock>
                    </Border>

                    <!-- Workstream P (P3): replace-in-place across the bundle's
                         App Info fields and its tables. Stretches to the tip
                         banner's height so the two read as a matched pair. -->
                    <Button Grid.Column="2"
                            Command="{Binding ReplacePlaceholdersCommand}"
                            Padding="14,4" VerticalAlignment="Stretch" Cursor="Hand"
                            ToolTip="{StaticResource Help.Common.ReplacePlaceholders}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Replace placeholders" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- APPLICATION INFO CARD -->
                <Border Style="{StaticResource FormCard}">
                    <StackPanel>
                        <ctrl:SectionHeader Title="Application Info" HelpKey="Help.General.AppInfo"/>

                        <!-- App identity row: large icon + Browse + Company/Name -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon + Browse button -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- Clicking the icon box opens the same Select Icon flow as
                                     the button below it (the clear overlay swallows its own click). -->
                                <Border Width="128" Height="128"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Background="{DynamicResource IconBoxBgBrush}"
                                        HorizontalAlignment="Center" Cursor="Hand"
                                        MouseLeftButtonUp="IconBox_Click"
                                        ToolTip="{StaticResource Help.General.AppInfo.IconFile}">
                                    <Grid>
                                        <!-- Placeholder glyph when no installer is loaded -->
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="56" Foreground="{DynamicResource EmptyStateFgBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InstallerIconSource}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Actual extracted icon -->
                                        <Image Source="{Binding InstallerIconSource}"
                                               Width="104" Height="104" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InstallerIconSource}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- Clear-icon overlay: only while an icon is set -->
                                        <Button Command="{Binding ClearIconCommand}"
                                                Width="20" Height="20" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,4,4,0" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTip="{StaticResource Help.General.AppInfo.ClearIcon}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InstallerIconSource}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Button Command="{Binding SelectAppIconCommand}"
                                        Width="128" Padding="8,3" Margin="0,5,0,0"
                                        FontSize="11"
                                        HorizontalAlignment="Center"
                                        ToolTip="{StaticResource Help.General.AppInfo.SelectIcon}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Select Icon" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock FontSize="10" FontStyle="Italic"
                                           TextWrapping="Wrap" Width="128"
                                           HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">Tip:</Run>
                                    <Run Foreground="{DynamicResource TextSecondaryBrush}"> Drag a PNG, JPG, or ICO file here to set the icon.</Run>
                                </TextBlock>
                            </StackPanel>

                            <!-- Company + App Name -->
                            <Grid Grid.Column="2" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Company" Style="{StaticResource FieldLabel}"
                                               ToolTip="{StaticResource Help.General.AppInfo.Company}"/>
                                    <TextBox Text="{Binding App.Company, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="App Name" Style="{StaticResource FieldLabel}"
                                               ToolTip="{StaticResource Help.General.AppInfo.Name}"/>
                                    <TextBox Text="{Binding App.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dot Version  (e.g. 1.2.3)" Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource Help.General.AppInfo.DotVersion}"/>
                                <TextBox Text="{Binding App.DotVersion, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Underscore Version  (e.g. 1_2_3)" Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource Help.General.AppInfo.Version}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding App.Version, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Margin="4,0,0,0" Padding="6,4"
                                            ToolTip="{StaticResource Help.General.AppInfo.AutoVersionFromDot}"
                                            Command="{Binding SyncUnderscoreVersionCommand}">
                                        <!-- Switch (two horizontal arrows): converts the dot
                                             version into underscore form — E72C (refresh wheel)
                                             read as a reload, not a derive-from-neighbor. -->
                                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Language" Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource Help.General.AppInfo.Language}"/>
                                <ui:TextBox Text="{Binding App.Language, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="e.g. EN"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Download URL" Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource Help.General.AppInfo.URL}"/>
                                <ui:TextBox Text="{Binding App.URL, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="https://..."
                                            ToolTip="{StaticResource Help.General.AppInfo.URL}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Script Framework" Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource Help.General.AppInfo.ScriptFrameworkLocked}"/>
                                <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4"
                                        Padding="10,7" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding App.ScriptFramework}"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EXE Filename" Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource Help.General.AppInfo.EXEFile}"/>
                                <ui:TextBox Text="{Binding App.EXEFile, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="setup.exe"
                                            ToolTip="{StaticResource Help.General.AppInfo.EXEFile}"/>
                                <Button Command="{Binding BrowseInstallerCommand}"
                                        Width="128" Padding="8,3" Margin="0,5,0,0"
                                        ToolTip="{StaticResource Help.General.AppInfo.BrowseInstaller}"
                                        FontSize="11" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Browse..." VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MSI / MSP Filename" Style="{StaticResource FieldLabel}"
                                           ToolTip="{StaticResource Help.General.AppInfo.MSIFile}"/>
                                <ui:TextBox Text="{Binding App.MSIFile, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="package.msi"
                                            ToolTip="{StaticResource Help.General.AppInfo.MSIFile}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="GUID" Style="{StaticResource FieldLabel}"
                                       ToolTip="{StaticResource Help.General.AppInfo.GUID}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding App.GUID, UpdateSourceTrigger=PropertyChanged}"
                                            FontFamily="Consolas"
                                            PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                                <Button Grid.Column="2" Content="Generate"
                                        ToolTip="{StaticResource Help.General.AppInfo.GenerateGuid}"
                                        Command="{Binding GenerateGuidCommand}" Padding="12,5"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- DETECT RUNNING CARD (expandable) -->
                <Expander Style="{StaticResource FormCardExpander}"
                          Header="Detect Running Processes"
                          IsExpanded="True">
                    <StackPanel>
                        <ctrl:SectionHeader Title="Detect Running Processes" HelpKey="Help.General.DetectRunning"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Command="{Binding AddDetectRunningCommand}" Padding="12,4" Margin="0,0,8,0"
                                    ToolTip="{StaticResource Help.General.DetectRunning.Add}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Add" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveSelectedDetectRunningCommand}"
                                    IsEnabled="{Binding DetectRunningSelection.HasSelected}"
                                    ToolTip="{StaticResource Help.General.DetectRunning.Remove}"
                                    Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding App.DetectRunning}" CellStyle="{StaticResource DirectEditCellStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Extended"
                                  MinHeight="72" MaxHeight="200"
                                  HorizontalAlignment="Stretch">
                            <DataGrid.Resources>
                                <Style TargetType="TextBox" BasedOn="{StaticResource GridCellEditor}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="2*">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Display Name" ToolTip="{StaticResource Help.General.DetectRunning.DisplayName}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{StaticResource Help.General.DetectRunning.DisplayName}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="2*">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="EXE Filename" ToolTip="{StaticResource Help.General.DetectRunning.ExeFileName}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ExeFileName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{StaticResource Help.General.DetectRunning.ExeFileName}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="2*">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Process Name" ToolTip="{StaticResource Help.General.DetectRunning.ProcessName}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Process, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{StaticResource Help.General.DetectRunning.ProcessName}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom: progress bar + status text (visible during .intunewin import) -->
        <Border Grid.Row="2" Padding="12,4,12,8">
            <StackPanel>
                <ProgressBar Height="4" Margin="0,0,0,4"
                             IsIndeterminate="{Binding IsImportingIntuneWin}"
                             Visibility="{Binding IsImportingIntuneWin, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- DRAG OVERLAY - covers full view, controlled by code-behind -->
        <Grid x:Name="DragOverlay"
              Visibility="Collapsed"
              Grid.RowSpan="2"
              Panel.ZIndex="10">
            <Grid.Background>
                <SolidColorBrush Color="#000000" Opacity="0.65"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock x:Name="DragValidIcon"
                           Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                           FontSize="72" Foreground="#6FD46F"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DragInvalidIcon"
                           Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                           FontSize="72" Foreground="#E05C5C"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="DragWarningIcon"
                           Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                           FontSize="72" Foreground="#F5B93B"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="DragBusyIcon"
                           Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                           FontSize="72" Foreground="#9AC9CF"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="DragOverlayHint"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DragOverlaySubHint"
                           FontSize="12"
                           Foreground="#AAAAAA"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
