<UserControl x:Class="Wrapp.Controls.ViewHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Wrapp.Controls"
             x:Name="Root">

    <Border Padding="16,12,16,10"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
        <!-- Fixed content height: RightContent buttons are taller than the
             title, so without it a header with buttons (Git History, Logs)
             grows past one without (General) and the titles sit at
             different baselines across views.
             HeaderPanel (back-ported from Unwrapped) measures the right
             content first and gives the title what is left, so a long
             title trims instead of pushing the toolbar off the edge. -->
        <ctrl:HeaderPanel MinHeight="32">
            <TextBlock x:Name="TitleText"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,6,0"/>
            <Button x:Name="InfoButton"
                    Click="InfoButton_Click"
                    Background="Transparent" BorderThickness="0"
                    Padding="4,0"
                    Cursor="Hand" VerticalAlignment="Center"
                    ToolTip="Click for help on this view">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
            </Button>
            <ContentPresenter Content="{Binding RightContent, ElementName=Root}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>
        </ctrl:HeaderPanel>
    </Border>
</UserControl>
