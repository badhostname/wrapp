<UserControl x:Class="Wrapp.Controls.ViewHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Padding="16,12,16,10"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
        <!-- Fixed content height: RightContent buttons are taller than the
             title, so without it a header with buttons (Git History, Logs)
             grows past one without (General) and the titles sit at
             different baselines across views. -->
        <Grid MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <Button x:Name="InfoButton" Grid.Column="1"
                    Click="InfoButton_Click"
                    Background="Transparent" BorderThickness="0"
                    Padding="4,0"
                    Cursor="Hand" VerticalAlignment="Center"
                    ToolTip="Click for help on this view">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
            </Button>
            <ContentPresenter Grid.Column="2"
                              Content="{Binding RightContent, ElementName=Root}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
