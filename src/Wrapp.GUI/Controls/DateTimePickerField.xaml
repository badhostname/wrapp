<UserControl x:Class="Wrapp.Controls.DateTimePickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledHatchBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <TextBox x:Name="ValueBox"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <!-- ASAP overlay: covers TextBox content when value is ASAP sentinel or empty -->
            <TextBlock x:Name="AsapOverlay" Text="ASAP"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Padding="10,0,0,0"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Calendar button (toggles popup) -->
        <Button Grid.Column="1" Click="CalendarButton_Click"
                ToolTip="{StaticResource Help.Common.DateTimePicker.Calendar}"
                Width="32" Height="32" Padding="0"
                Margin="4,0,0,0" VerticalAlignment="Bottom"
                Background="Transparent" BorderThickness="0">
            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Button>

        <!-- ASAP button -->
        <Button Grid.Column="2" Click="AsapButton_Click"
                ToolTip="{StaticResource Help.Common.DateTimePicker.Asap}"
                Height="32" Padding="6,0"
                Margin="2,0,0,0" VerticalAlignment="Bottom"
                Background="Transparent" BorderThickness="0">
            <TextBlock Text="ASAP" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Button>

        <!-- Date + time popup -->
        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=ValueBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               Opened="CalendarPopup_Opened"
               Closed="CalendarPopup_Closed">
            <Border x:Name="PopupBorder"
                    BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,4,0,0">
                <Border.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <materialDesign:CustomColorTheme BaseTheme="Dark"
                                PrimaryColor="#9ac9cf" SecondaryColor="#9ac9cf" />
                            <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </Border.Resources>
                <Border.Background>
                    <DynamicResourceExtension ResourceKey="MaterialDesignPaper"/>
                </Border.Background>
                <Border.BorderBrush>
                    <DynamicResourceExtension ResourceKey="MaterialDesignDivider"/>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Opacity="0.25" ShadowDepth="4"/>
                </Border.Effect>

                <StackPanel PreviewMouseWheel="PopupContent_PreviewMouseWheel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Calendar + date input -->
                        <StackPanel Grid.Column="0">
                            <Calendar x:Name="DateCalendar"
                                      DisplayDateStart="2020-01-01"
                                      materialDesign:CalendarAssist.IsHeaderVisible="False"
                                      SelectedDatesChanged="DateCalendar_SelectedDatesChanged"
                                      VerticalAlignment="Top"/>

                            <!-- YYYY / MM / DD manual entry -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                <TextBox x:Name="YearBox" Width="52" MaxLength="4"
                                         TextAlignment="Center" FontSize="13"
                                         LostFocus="DateBox_LostFocus"/>
                                <TextBlock Text="/" VerticalAlignment="Center"
                                           Margin="2,0" FontSize="13"
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBox x:Name="MonthBox" Width="36" MaxLength="2"
                                         TextAlignment="Center" FontSize="13"
                                         LostFocus="DateBox_LostFocus"/>
                                <TextBlock Text="/" VerticalAlignment="Center"
                                           Margin="2,0" FontSize="13"
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBox x:Name="DayBox" Width="36" MaxLength="2"
                                         TextAlignment="Center" FontSize="13"
                                         LostFocus="DateBox_LostFocus"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Clock + time input -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                    VerticalAlignment="Top">
                            <materialDesign:Clock x:Name="TimeClock"
                                                  Is24Hours="False"
                                                  IsHeaderVisible="False"
                                                  DisplayAutomation="Cycle"
                                                  HorizontalAlignment="Center"/>

                            <!-- HH : MM manual entry -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                <TextBox x:Name="HourBox" Width="36" MaxLength="2"
                                         TextAlignment="Center" FontSize="13"
                                         LostFocus="TimeBox_LostFocus"/>
                                <TextBlock Text=":" VerticalAlignment="Center"
                                           Margin="2,0" FontSize="13"
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBox x:Name="MinuteBox" Width="36" MaxLength="2"
                                         TextAlignment="Center" FontSize="13"
                                         LostFocus="TimeBox_LostFocus"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Footer: Set button -->
                    <Grid Margin="0,8,0,0">
                        <Button Content="Set" Click="SetDateTime_Click"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                Padding="16,4"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>

    <!-- Past-time warning (shown when selected date is in the past) -->
    <TextBlock x:Name="PastTimeWarning"
               Text="Selected time is in the past - deployment will be treated as ASAP."
               FontSize="10" Foreground="{DynamicResource WarningBrush}"
               Visibility="Collapsed" Margin="0,2,0,0"/>
    </StackPanel>
</UserControl>
