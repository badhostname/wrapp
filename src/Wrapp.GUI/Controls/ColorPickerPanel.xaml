<UserControl x:Class="Wrapp.Controls.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Spectrum: hue left→right, saturation top (white) → bottom (full). -->
        <Border x:Name="SpectrumSquare" Height="90" CornerRadius="4"
                Background="Transparent"
                Cursor="Cross" ClipToBounds="True"
                MouseLeftButtonDown="Spectrum_MouseDown"
                MouseMove="Spectrum_MouseMove"
                MouseLeftButtonUp="Spectrum_MouseUp"
                ToolTip="{StaticResource Help.IconLibrary.CustomColor}">
            <Grid IsHitTestVisible="False">
                <Border CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0"/>
                            <GradientStop Color="#FFFF00" Offset="0.167"/>
                            <GradientStop Color="#00FF00" Offset="0.333"/>
                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#0000FF" Offset="0.667"/>
                            <GradientStop Color="#FF00FF" Offset="0.833"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas>
                    <Ellipse x:Name="SpectrumMarker" Width="10" Height="10"
                             Stroke="White" StrokeThickness="2" Fill="Transparent">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="#000000"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- Darkness slider: current hue/saturation at the left, black right. -->
        <Border x:Name="DarknessStrip" Height="14" Margin="0,10,0,0" CornerRadius="4"
                Background="Transparent"
                Cursor="Hand" ClipToBounds="True"
                MouseLeftButtonDown="Darkness_MouseDown"
                MouseMove="Darkness_MouseMove"
                MouseLeftButtonUp="Darkness_MouseUp"
                ToolTip="{StaticResource Help.IconLibrary.CustomColor}">
            <Grid IsHitTestVisible="False">
                <Border CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="DarknessStart" Color="#9AC9CF" Offset="0"/>
                            <GradientStop Color="#000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas>
                    <Rectangle x:Name="DarknessMarker" Width="4" Height="14"
                               Fill="White" RadiusX="1" RadiusY="1">
                        <Rectangle.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="2" Color="#000000"/>
                        </Rectangle.Effect>
                    </Rectangle>
                </Canvas>
            </Grid>
        </Border>

        <!-- Preset swatches -->
        <ItemsControl ItemsSource="{Binding Palette}" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="28" Height="28" Margin="0,0,6,6"
                            Tag="{Binding}" Click="Swatch_Click"
                            ToolTip="{StaticResource Help.IconLibrary.Color}"
                            BorderThickness="2" BorderBrush="Transparent"
                            Cursor="Hand">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding}"/>
                        </Button.Background>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Custom color: hex + RGB decimal, synced both ways -->
        <TextBox Text="{Binding CustomHex, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Consolas" FontSize="12" Padding="6,3" Margin="0,2,0,0"
                 ToolTip="{StaticResource Help.IconLibrary.CustomColor}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCustomHexInvalid}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Red, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="11" Padding="4,3" TextAlignment="Center"
                     ToolTip="{StaticResource Help.IconLibrary.CustomColor}"/>
            <TextBox Grid.Column="2" Text="{Binding Green, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="11" Padding="4,3" TextAlignment="Center"
                     ToolTip="{StaticResource Help.IconLibrary.CustomColor}"/>
            <TextBox Grid.Column="4" Text="{Binding Blue, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="11" Padding="4,3" TextAlignment="Center"
                     ToolTip="{StaticResource Help.IconLibrary.CustomColor}"/>
        </Grid>
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="R" FontSize="9" TextAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Grid.Column="2" Text="G" FontSize="9" TextAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Grid.Column="4" Text="B" FontSize="9" TextAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>
    </StackPanel>
</UserControl>
