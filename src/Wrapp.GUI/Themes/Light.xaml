<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main surfaces -->
    <SolidColorBrush x:Key="AppBgBrush"         Color="#e8f8f9"/>
    <SolidColorBrush x:Key="SidebarBgBrush"      Color="#e8f8f9"/>
    <SolidColorBrush x:Key="CardBgBrush"         Color="#f7fafb"/>
    <SolidColorBrush x:Key="InputBgBrush"        Color="#f7fafb"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#366372"/>

    <!-- Popup shadow -->
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="16" ShadowDepth="4"
                       Direction="270" Opacity="0.2" Color="#000000"/>

    <!-- Borders and dividers -->
    <SolidColorBrush x:Key="AppBorderBrush"      Color="#c0dce0"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#101010"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#3a3a3a"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="#101010"/>

    <!-- Nav item states -->
    <SolidColorBrush x:Key="NavHoverBrush"       Color="#d5eef0"/>
    <SolidColorBrush x:Key="NavSelectedBrush"    Color="#c8e6e9"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="RowAltBrush"         Color="#e6f0f3"/>
    <SolidColorBrush x:Key="TableHeaderBgBrush"  Color="#f7fafb"/>
    <SolidColorBrush x:Key="CellHoverBrush"      Color="#d0e8ec"/>

    <!-- WPF SystemColors overrides (DataGrid selection, editing cells, native controls) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="#c8e6e9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="#101010"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#c8e6e9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#101010"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"            Color="#f7fafb"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"        Color="#101010"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"           Color="#f7fafb"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"       Color="#101010"/>

    <!-- Loading overlay (semi-transparent) -->
    <SolidColorBrush x:Key="OverlayBgBrush"      Color="#CCe8f8f9"/>

    <!-- Icon/thumbnail box background -->
    <SolidColorBrush x:Key="IconBoxBgBrush"       Color="#f7fafb"/>

    <!-- Log/run output list background -->
    <SolidColorBrush x:Key="LogBgBrush"           Color="#f7fafb"/>

    <!-- Run result summary rows -->
    <SolidColorBrush x:Key="RunSuccessBgBrush"    Color="#d4f5d4"/>
    <SolidColorBrush x:Key="RunErrorBgBrush"      Color="#ffd5d5"/>

    <!-- Connection status panel -->
    <SolidColorBrush x:Key="ConnectedBrush"       Color="#2E7D32"/>
    <SolidColorBrush x:Key="DisconnectedBrush"    Color="#C62828"/>
    <SolidColorBrush x:Key="CheckingBrush"        Color="#E65100"/>
    <SolidColorBrush x:Key="RunningBrush"         Color="#1565C0"/>
    <SolidColorBrush x:Key="UnknownLineBrush"     Color="#9E9E9E"/>
    <SolidColorBrush x:Key="SkippedBrush"         Color="#BDBDBD"/>

    <!-- Error / warning-red foreground (duplicate names, validation failures) -->
    <SolidColorBrush x:Key="ErrorBrush"             Color="#C04040"/>

    <!-- Warning / amber foreground (missing tenant/site selection) -->
    <SolidColorBrush x:Key="WarningBrush"           Color="#B08820"/>

    <!-- Command field highlight (install/uninstall/repair commands) -->
    <SolidColorBrush x:Key="CommandFieldBgBrush"       Color="#263A7BC8"/>
    <SolidColorBrush x:Key="CommandFieldAccentBrush"    Color="#3A7BC8"/>

    <!-- Validation badge (red circle with white count) -->
    <SolidColorBrush x:Key="BadgeBgBrush"          Color="#C04040"/>
    <SolidColorBrush x:Key="BadgeFgBrush"          Color="#FFFFFF"/>
    <!-- Non-blocking issues (amber) — see Dark.xaml. -->
    <SolidColorBrush x:Key="WarnBadgeBgBrush"      Color="#B8730A"/>
    <SolidColorBrush x:Key="WarnBadgeFgBrush"      Color="#FFFFFF"/>

    <!-- Selected item foreground (nav, datagrid) -->
    <SolidColorBrush x:Key="NavSelectedFgBrush"   Color="#101010"/>

    <!-- Empty state placeholder graphics and text -->
    <SolidColorBrush x:Key="EmptyStateFgBrush"    Color="#aaaaaa"/>
    <SolidColorBrush x:Key="EmptyStateTextBrush"  Color="#888888"/>

    <!-- Log timestamp column -->
    <SolidColorBrush x:Key="TimestampBrush"       Color="#aaaaaa"/>

    <!-- Disabled button state -->
    <SolidColorBrush x:Key="DisabledBgBrush"      Color="#c0dce0"/>
    <SolidColorBrush x:Key="DisabledFgBrush"      Color="#888888"/>

    <!-- Accent button (themed accent color) -->
    <SolidColorBrush x:Key="AccentBgBrush"         Color="#366372"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#2d5562"/>
    <SolidColorBrush x:Key="AccentPressedBrush"    Color="#254752"/>
    <SolidColorBrush x:Key="AccentFgBrush"         Color="#ffffff"/>

    <!-- Tab selected indicator -->
    <SolidColorBrush x:Key="TabIndicatorBrush"     Color="#366372"/>

    <!-- Git history graph -->
    <SolidColorBrush x:Key="GitGraphLineBrush"     Color="#a0c4e8"/>
    <SolidColorBrush x:Key="GitGraphDotBrush"      Color="#366372"/>

    <!-- CheckBox / ToggleSwitch accent overrides -->
    <SolidColorBrush x:Key="CheckAccentBrush"      Color="#366372"/>
    <SolidColorBrush x:Key="CheckAccentHoverBrush"  Color="#2d5562"/>
    <SolidColorBrush x:Key="CheckGlyphBrush"       Color="#e8f8f9"/>
    <SolidColorBrush x:Key="ToggleOnBrush"         Color="#366372"/>
    <SolidColorBrush x:Key="ToggleOnHoverBrush"    Color="#2d5562"/>
    <SolidColorBrush x:Key="ToggleKnobBrush"       Color="#e8f8f9"/>

    <!-- ToggleSwitch Wpf.Ui internal overrides -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn"                  Color="#366372"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"       Color="#2d5562"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"           Color="#254752"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled"          Color="#c0dce0"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOff"                 Color="#f7fafb"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver"      Color="#e6f0f3"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed"          Color="#d5eef0"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled"         Color="#e6f0f3"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff"               Color="#3a3a3a"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver"    Color="#101010"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed"        Color="#3a3a3a"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled"       Color="#888888"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn"                Color="#366372"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver"     Color="#2d5562"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"         Color="#254752"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled"        Color="#c0dce0"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"              Color="#e8f8f9"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver"   Color="#e8f8f9"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"       Color="#e8f8f9"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled"      Color="#888888"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"             Color="#3a3a3a"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver"  Color="#101010"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed"      Color="#101010"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled"     Color="#888888"/>

    <!-- TextBox / TextControl Wpf.Ui internal overrides -->
    <SolidColorBrush x:Key="TextControlBackground"                  Color="#f7fafb"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"       Color="#f7fafb"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused"           Color="#f7fafb"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled"          Color="#e6f0f3"/>
    <SolidColorBrush x:Key="TextControlForeground"                  Color="#101010"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver"       Color="#101010"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused"           Color="#101010"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled"          Color="#888888"/>
    <SolidColorBrush x:Key="TextControlBorderBrush"                 Color="#c0dce0"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"      Color="#366372"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused"          Color="#366372"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled"         Color="#c0dce0"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground"       Color="#3a3a3a"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush"       Color="#f7fafb"/>

    <!-- Normal buttons (Add, Remove, Duplicate, Refresh, etc.) -->
    <SolidColorBrush x:Key="NormalBtnBgBrush"      Color="#f7fafb"/>
    <SolidColorBrush x:Key="NormalBtnHoverBrush"   Color="#e6f0f3"/>
    <SolidColorBrush x:Key="NormalBtnPressedBrush"  Color="#d5eef0"/>
    <SolidColorBrush x:Key="NormalBtnFgBrush"      Color="#101010"/>
    <SolidColorBrush x:Key="NormalBtnBorderBrush"  Color="#c0dce0"/>

    <!-- Table interior (below headers) -->
    <SolidColorBrush x:Key="TableInteriorBgBrush"  Color="#e6f0f3"/>

    <!-- Detection view dropdown background -->
    <SolidColorBrush x:Key="DetectionDropdownBgBrush" Color="#e6f0f3"/>


    <!-- ================================================================
         Wpf.Ui internal accent resource overrides.
         These force ToggleSwitch, ContentDialog primary buttons, and any
         other Wpf.Ui control that uses the accent fill to use our color
         instead of the Windows system accent.
         ================================================================ -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"    Color="#366372"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"  Color="#2d5562"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"   Color="#254752"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush"   Color="#c0dce0"/>
    <SolidColorBrush x:Key="SystemAccentBrush"              Color="#366372"/>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush"  Color="#366372"/>

    <!-- Text on accent surfaces (light text on dark accent) -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"   Color="#ffffff"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#e8f8f9"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush"  Color="#888888"/>
    <Color x:Key="TextOnAccentFillColorPrimary">#ffffff</Color>
    <Color x:Key="TextOnAccentFillColorSecondary">#e8f8f9</Color>

    <!-- ComboBox (Wpf.Ui internal key names, no "Brush" suffix) -->
    <SolidColorBrush x:Key="ComboBoxBackground"                          Color="#f7fafb"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"               Color="#e6f0f3"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused"                   Color="#e6f0f3"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled"                  Color="#e6f0f3"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground"                  Color="#f7fafb"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush"                 Color="#c0dce0"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"              Color="#d5eef0"/>
    <SolidColorBrush x:Key="ComboBoxItemForeground"                      Color="#101010"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected"              Color="#101010"/>
    <SolidColorBrush x:Key="ComboBoxForeground"                          Color="#101010"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled"                  Color="#888888"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground"             Color="#3a3a3a"/>

    <!-- Flyout / context-menu popup backgrounds -->
    <SolidColorBrush x:Key="FlyoutBackground"                            Color="#f7fafb"/>
    <SolidColorBrush x:Key="FlyoutBorderBrush"                           Color="#c0dce0"/>
    <SolidColorBrush x:Key="ContextMenuBackground"                       Color="#f7fafb"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush"                      Color="#c0dce0"/>

    <!-- Solid/layer surface fills used by Wpf.Ui popup templates -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"           Color="#f7fafb"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"                  Color="#f7fafb"/>

    <!-- General control fills -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"                Color="#f7fafb"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"              Color="#e6f0f3"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"               Color="#f7fafb"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush"               Color="#e6f0f3"/>

    <!-- Accent button states (ContentDialog primary buttons, etc.) -->
    <SolidColorBrush x:Key="AccentButtonBackground"                      Color="#366372"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver"           Color="#2d5562"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed"               Color="#254752"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed"              Color="#254752"/>

    <!-- ContentDialog surface -->
    <SolidColorBrush x:Key="ContentDialogBackground"                     Color="#f7fafb"/>
    <SolidColorBrush x:Key="ContentDialogBorderBrush"                    Color="#c0dce0"/>

    <!-- Accent colors (used by some Wpf.Ui templates) -->
    <Color x:Key="SystemAccentColor">#366372</Color>
    <Color x:Key="SystemAccentColorPrimary">#366372</Color>
    <Color x:Key="SystemAccentColorSecondary">#2d5562</Color>
    <Color x:Key="SystemAccentColorTertiary">#254752</Color>

</ResourceDictionary>
