<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main surfaces -->
    <SolidColorBrush x:Key="AppBgBrush"         Color="#131c21"/>
    <SolidColorBrush x:Key="SidebarBgBrush"      Color="#131c21"/>
    <SolidColorBrush x:Key="CardBgBrush"         Color="#21292c"/>
    <SolidColorBrush x:Key="InputBgBrush"        Color="#333b3d"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#9ac9cf"/>

    <!-- Popup shadow -->
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="16" ShadowDepth="4"
                       Direction="270" Opacity="0.45" Color="#000000"/>

    <!-- Borders and dividers -->
    <SolidColorBrush x:Key="AppBorderBrush"      Color="#2a3538"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#ffffff"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#a0a0a0"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="#ffffff"/>

    <!-- Nav item states -->
    <SolidColorBrush x:Key="NavHoverBrush"       Color="#1a2a2f"/>
    <SolidColorBrush x:Key="NavSelectedBrush"    Color="#1f3035"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="RowAltBrush"         Color="#1b2427"/>
    <SolidColorBrush x:Key="TableHeaderBgBrush"  Color="#21292c"/>
    <SolidColorBrush x:Key="CellHoverBrush"      Color="#243035"/>

    <!-- WPF SystemColors overrides (DataGrid selection, editing cells, native controls) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="#1f3035"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="#ffffff"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#1f3035"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ffffff"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"            Color="#333b3d"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"        Color="#ffffff"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"           Color="#333b3d"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"       Color="#ffffff"/>

    <!-- Loading overlay (semi-transparent) -->
    <SolidColorBrush x:Key="OverlayBgBrush"      Color="#CC131c21"/>

    <!-- Icon/thumbnail box background -->
    <SolidColorBrush x:Key="IconBoxBgBrush"       Color="#21292c"/>

    <!-- Log/run output list background -->
    <SolidColorBrush x:Key="LogBgBrush"           Color="#131c21"/>

    <!-- Run result summary rows -->
    <SolidColorBrush x:Key="RunSuccessBgBrush"    Color="#1a3a1a"/>
    <SolidColorBrush x:Key="RunErrorBgBrush"      Color="#3a1a1a"/>

    <!-- Connection status panel -->
    <SolidColorBrush x:Key="ConnectedBrush"       Color="#4CAF50"/>
    <SolidColorBrush x:Key="DisconnectedBrush"    Color="#F44336"/>
    <SolidColorBrush x:Key="CheckingBrush"        Color="#FF9800"/>
    <SolidColorBrush x:Key="RunningBrush"         Color="#42A5F5"/>
    <SolidColorBrush x:Key="UnknownLineBrush"     Color="#555555"/>
    <SolidColorBrush x:Key="SkippedBrush"         Color="#757575"/>

    <!-- Error / warning-red foreground (duplicate names, validation failures) -->
    <SolidColorBrush x:Key="ErrorBrush"             Color="#E05C5C"/>

    <!-- Warning / amber foreground (missing tenant/site selection) -->
    <SolidColorBrush x:Key="WarningBrush"           Color="#D4A840"/>

    <!-- Command field highlight (install/uninstall/repair commands) -->
    <SolidColorBrush x:Key="CommandFieldBgBrush"       Color="#266BB5E0"/>
    <SolidColorBrush x:Key="CommandFieldAccentBrush"    Color="#6BB5E0"/>

    <!-- Validation badge (red circle with white count) -->
    <SolidColorBrush x:Key="BadgeBgBrush"          Color="#D04040"/>
    <SolidColorBrush x:Key="BadgeFgBrush"          Color="#FFFFFF"/>
    <!-- Non-blocking issues (amber). Deliberately distinct from the red error
         badge so "things to know" never reads as "things that are broken". -->
    <SolidColorBrush x:Key="WarnBadgeBgBrush"      Color="#D98A0B"/>
    <SolidColorBrush x:Key="WarnBadgeFgBrush"      Color="#1E1E1E"/>

    <!-- Selected item foreground (nav, datagrid) -->
    <SolidColorBrush x:Key="NavSelectedFgBrush"   Color="#ffffff"/>

    <!-- Empty state placeholder graphics and text -->
    <SolidColorBrush x:Key="EmptyStateFgBrush"    Color="#444444"/>
    <SolidColorBrush x:Key="EmptyStateTextBrush"  Color="#666666"/>

    <!-- Log timestamp column -->
    <SolidColorBrush x:Key="TimestampBrush"       Color="#555555"/>

    <!-- Disabled button state -->
    <SolidColorBrush x:Key="DisabledBgBrush"      Color="#2a3538"/>
    <SolidColorBrush x:Key="DisabledFgBrush"      Color="#555555"/>

    <!-- Accent button (themed accent color) -->
    <SolidColorBrush x:Key="AccentBgBrush"         Color="#9ac9cf"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#85b8bf"/>
    <SolidColorBrush x:Key="AccentPressedBrush"    Color="#70a7af"/>
    <SolidColorBrush x:Key="AccentFgBrush"         Color="#131c21"/>

    <!-- Tab selected indicator -->
    <SolidColorBrush x:Key="TabIndicatorBrush"     Color="#9ac9cf"/>

    <!-- Git history graph -->
    <SolidColorBrush x:Key="GitGraphLineBrush"     Color="#2a4a58"/>
    <SolidColorBrush x:Key="GitGraphDotBrush"      Color="#9ac9cf"/>

    <!-- CheckBox / ToggleSwitch accent overrides -->
    <SolidColorBrush x:Key="CheckAccentBrush"      Color="#9ac9cf"/>
    <SolidColorBrush x:Key="CheckAccentHoverBrush"  Color="#85b8bf"/>
    <SolidColorBrush x:Key="CheckGlyphBrush"       Color="#171717"/>
    <SolidColorBrush x:Key="ToggleOnBrush"         Color="#9ac9cf"/>
    <SolidColorBrush x:Key="ToggleOnHoverBrush"    Color="#85b8bf"/>
    <SolidColorBrush x:Key="ToggleKnobBrush"       Color="#171717"/>

    <!-- ToggleSwitch Wpf.Ui internal overrides -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn"                  Color="#9ac9cf"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"       Color="#85b8bf"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"           Color="#70a7af"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled"          Color="#2a3538"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOff"                 Color="#333b3d"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver"      Color="#2a3538"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed"          Color="#21292c"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled"         Color="#2a3538"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff"               Color="#a0a0a0"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver"    Color="#ffffff"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed"        Color="#a0a0a0"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled"       Color="#555555"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn"                Color="#9ac9cf"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver"     Color="#85b8bf"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"         Color="#70a7af"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled"        Color="#2a3538"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"              Color="#131c21"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver"   Color="#131c21"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"       Color="#131c21"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled"      Color="#555555"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"             Color="#a0a0a0"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver"  Color="#ffffff"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed"      Color="#ffffff"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled"     Color="#555555"/>

    <!-- TextBox / TextControl Wpf.Ui internal overrides -->
    <SolidColorBrush x:Key="TextControlBackground"                  Color="#333b3d"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"       Color="#333b3d"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused"           Color="#333b3d"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled"          Color="#21292c"/>
    <SolidColorBrush x:Key="TextControlForeground"                  Color="#ffffff"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver"       Color="#ffffff"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused"           Color="#ffffff"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled"          Color="#555555"/>
    <SolidColorBrush x:Key="TextControlBorderBrush"                 Color="#2a3538"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"      Color="#9ac9cf"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused"          Color="#9ac9cf"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled"         Color="#2a3538"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground"       Color="#a0a0a0"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush"       Color="#333b3d"/>

    <!-- Normal buttons (Add, Remove, Duplicate, Refresh, etc.) -->
    <SolidColorBrush x:Key="NormalBtnBgBrush"      Color="#21292c"/>
    <SolidColorBrush x:Key="NormalBtnHoverBrush"   Color="#2a3538"/>
    <SolidColorBrush x:Key="NormalBtnPressedBrush"  Color="#1a2a2f"/>
    <SolidColorBrush x:Key="NormalBtnFgBrush"      Color="#ffffff"/>
    <SolidColorBrush x:Key="NormalBtnBorderBrush"  Color="#2a3538"/>

    <!-- Table interior (below headers) -->
    <SolidColorBrush x:Key="TableInteriorBgBrush"  Color="#1b2427"/>

    <!-- Detection view dropdown background -->
    <SolidColorBrush x:Key="DetectionDropdownBgBrush" Color="#1f3035"/>


    <!-- ================================================================
         Wpf.Ui internal accent resource overrides.
         These force ToggleSwitch, ContentDialog primary buttons, and any
         other Wpf.Ui control that uses the accent fill to use our color
         instead of the Windows system accent.
         ================================================================ -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"    Color="#9ac9cf"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"  Color="#85b8bf"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"   Color="#70a7af"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush"   Color="#2a3538"/>
    <SolidColorBrush x:Key="SystemAccentBrush"              Color="#9ac9cf"/>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush"  Color="#9ac9cf"/>

    <!-- Text on accent surfaces (dark text on light accent) -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"   Color="#131c21"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1a2a2f"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush"  Color="#555555"/>
    <Color x:Key="TextOnAccentFillColorPrimary">#131c21</Color>
    <Color x:Key="TextOnAccentFillColorSecondary">#1a2a2f</Color>

    <!-- ComboBox (Wpf.Ui internal key names, no "Brush" suffix) -->
    <SolidColorBrush x:Key="ComboBoxBackground"                          Color="#333b3d"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"               Color="#2a3538"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused"                   Color="#2a3538"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled"                  Color="#21292c"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground"                  Color="#21292c"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush"                 Color="#2a3538"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected"              Color="#1f3035"/>
    <SolidColorBrush x:Key="ComboBoxItemForeground"                      Color="#ffffff"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected"              Color="#ffffff"/>
    <SolidColorBrush x:Key="ComboBoxForeground"                          Color="#ffffff"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled"                  Color="#555555"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground"             Color="#a0a0a0"/>

    <!-- Flyout / context-menu popup backgrounds -->
    <SolidColorBrush x:Key="FlyoutBackground"                            Color="#21292c"/>
    <SolidColorBrush x:Key="FlyoutBorderBrush"                           Color="#2a3538"/>
    <SolidColorBrush x:Key="ContextMenuBackground"                       Color="#21292c"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush"                      Color="#2a3538"/>

    <!-- Solid/layer surface fills used by Wpf.Ui popup templates -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"           Color="#21292c"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"                  Color="#21292c"/>

    <!-- General control fills -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"                Color="#333b3d"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"              Color="#2a3538"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"               Color="#21292c"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush"               Color="#2a3538"/>

    <!-- Accent button states (ContentDialog primary buttons, etc.) -->
    <SolidColorBrush x:Key="AccentButtonBackground"                      Color="#9ac9cf"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver"           Color="#85b8bf"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed"               Color="#70a7af"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed"              Color="#70a7af"/>

    <!-- ContentDialog surface -->
    <SolidColorBrush x:Key="ContentDialogBackground"                     Color="#21292c"/>
    <SolidColorBrush x:Key="ContentDialogBorderBrush"                    Color="#2a3538"/>

    <!-- Accent colors (used by some Wpf.Ui templates) -->
    <Color x:Key="SystemAccentColor">#9ac9cf</Color>
    <Color x:Key="SystemAccentColorPrimary">#9ac9cf</Color>
    <Color x:Key="SystemAccentColorSecondary">#85b8bf</Color>
    <Color x:Key="SystemAccentColorTertiary">#70a7af</Color>

</ResourceDictionary>
