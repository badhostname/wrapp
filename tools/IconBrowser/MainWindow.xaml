<Window x:Class="IconBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Wrapp Icon Browser"
        Height="800" Width="1100" WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Wrapp Icon Browser" FontSize="15" FontWeight="SemiBold"
                           Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <RadioButton x:Name="TabMdl2" Content="Segoe MDL2" GroupName="Tab"
                             IsChecked="True" Foreground="#e0e0e0" Margin="0,0,12,0"
                             VerticalAlignment="Center" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabWpfUi" Content="Wpf.Ui Fluent" GroupName="Tab"
                             Foreground="#e0e0e0" Margin="0,0,20,0"
                             VerticalAlignment="Center" Checked="Tab_Checked"/>

                <TextBox x:Name="SearchBox" Width="280" Padding="6,4"
                         Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555"
                         VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>

                <TextBlock x:Name="CountLabel" Foreground="#888" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Icon list: single virtualizing ListBox with uniform grid -->
        <ListBox x:Name="IconList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionChanged="IconList_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#2d2d2d" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="Click any icon to copy its code to clipboard"
                       Foreground="#888" FontSize="11"/>
        </Border>
    </Grid>
</Window>
